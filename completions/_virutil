#compdef virutil
# zsh completion for virutil -- mirrors the dispatch in modules/parser.

_virutil() {
  # One tag per group in `virutil help`, so the module list reads the same way in
  # both places. Whether they render as separate blocks is the user's call, via
  # zstyle group-name -- distinct tags are what make that possible.
  local -a domains transfer guest hardware other
  domains=(
    'domain:the domain lifecycle: create, delete, list, start, shutdown, addr'
    'snapshot:external snapshots (disk and memory) for libvirt domains'
  )
  transfer=(
    'sync:fetch build output from the Windows host and push into a guest'
    'pull:copy files out of a running guest'
    'push:copy a file or directory from the host into a guest on demand'
  )
  guest=(
    'exec:run commands inside a Windows guest via the QEMU guest agent'
  )
  hardware=(
    'usb:USB passthrough from the Windows host under WSL'
  )
  other=(
    'help:this message'
  )

  if (( CURRENT == 2 )); then
    _describe -t domains  'domain module'   domains
    _describe -t transfer 'transfer module' transfer
    _describe -t guest    'guest module'    guest
    _describe -t hardware 'hardware module' hardware
    _describe -t other    'other'           other
    return
  fi

  case $words[2] in
    domain)   _virutil_domain ;;
    snapshot) _virutil_snapshot ;;
    sync)     _virutil_sync ;;
    pull)     _virutil_pull ;;
    push)     _virutil_push ;;
    exec)     _virutil_exec ;;
    usb)      _virutil_usb ;;
  esac
}

_virutil_domains() {
  local -a doms
  if command -v virsh >/dev/null 2>&1; then
    doms=(${(f)"$(virsh -c qemu:///system list --all 2>/dev/null | awk 'NR>2 && $1 !~ /^-/ {print $2}')"})
  fi
  _describe -t domain 'domain' doms
}

_virutil_osinfo() {
  local -a ids
  if command -v osinfo-query >/dev/null 2>&1; then
    ids=(${(f)"$(osinfo-query --fields=short-id os 2>/dev/null | awk 'NR>2 {print $1}')"})
  fi
  _describe -t osinfo 'osinfo id' ids
}

_virutil_exec() {
  local -a cmds=(
    'setup:add the org.qemu.guest_agent.0 channel'
    'ping:check the guest agent is responding'
    'info:guest OS, hostname and agent version'
    'cmd:run a command via cmd.exe /c'
    'ps:run a script via powershell'
  )
  case $CURRENT in
    3) _describe -t command 'command' cmds ;;
    4) _virutil_domains ;;
    *)
      case $words[3] in
        cmd|ps)
          (( CURRENT == 5 )) && _values 'option' \
            '-d[fire and forget, print guest pid]' \
            '--detach[fire and forget, print guest pid]' \
            '--[end of flags]' \
            '-[read command from stdin]'
          ;;
      esac
      ;;
  esac
}

_virutil_sync() {
  local state line
  _arguments \
    '(-c --config)'{-c,--config}'[config NAME or PATH]:config:->config' \
    '--transport[how to move the files]:transport:->transport' \
    '(-h --help)'{-h,--help}'[print usage and exit]' \
    '2:domain:->domain'   # 1 is the module word itself; _arguments skips words[1]
  case $state in
    domain) _virutil_domains ;;
    transport) _virutil_transports ;;
    config)
      if [[ $PREFIX == */* ]]; then
        _files
      else
        local -a confs
        confs=(${~HOME}/.config/virutils/*.conf(N:t:r))
        _describe -t config 'config' confs
      fi
      ;;
  esac
}

_virutil_pull() {
  local state line
  _arguments \
    '(-c --config)'{-c,--config}'[config NAME or PATH]:config:->config' \
    '--transport[how to move the files]:transport:->transport' \
    '(-h --help)'{-h,--help}'[print usage and exit]'
  case $state in
    transport) _virutil_transports ;;
    config)
      if [[ $PREFIX == */* ]]; then
        _files
      else
        local -a confs
        confs=(${~HOME}/.config/virutils/*.conf(N:t:r))
        _describe -t config 'config' confs
      fi
      ;;
  esac
}

_virutil_transports() {
  _values 'transport' \
    'auto[pick one: virtiofs, else volume, else disk]' \
    'disk[the guest'\''s own disk over qemu-nbd; a write shuts it down]' \
    'volume[a staging qcow2 hotplugged into the running guest]' \
    'virtiofs[a live virtio-fs share]'
}

_virutil_push() {
  case $words[CURRENT-1] in
    --transport) _virutil_transports; return ;;
  esac
  case $CURRENT in
    3) _virutil_domains ;;
    4) _files ;;
    5) ;;                             # the guest-side destination: nothing to complete
    *) _values 'option' '--transport[how to move the files]' ;;
  esac
}

_virutil_usb() {
  local -a cmds=(
    'list:list host USB devices and sharing state'
    'show:show devices passed to a VM, live and persistent'
    'attach:share on Windows, import into WSL, attach to the VM'
    'detach:return a device to the Windows host'
    'unbind:stop sharing a device on Windows'
  )
  case $CURRENT in
    3) _describe -t command 'command' cmds ;;
    *)
      case $words[3] in
        show|attach|detach)
          (( CURRENT == 4 )) && { _virutil_domains; return; }
          (( CURRENT == 5 )) && _virutil_usb_busids
          ;;
        unbind)
          _virutil_usb_busids
          ;;
      esac
      ;;
  esac
}

_virutil_usb_busids() {
  local usbipd="/mnt/c/Program Files/usbipd-win/usbipd.exe" busids
  # only the device rows start with a busid, which skips the header and the section
  # titles; the rest of the row (hardware id, name, state) becomes the description
  if [[ -x $usbipd ]]; then
    busids=(${(f)"$($usbipd list 2>/dev/null | tr -d '\r' |
      awk '$1 ~ /^[0-9]+-[0-9.]+$/ { id = $1; $1 = ""
                                     sub(/^ +/, ""); sub(/ +$/, "")
                                     print id ":" $0 }')"})
  fi
  _describe -t device 'busid' busids
}

_virutil_snapshot() {
  local -a cmds=(
    'create:create an external snapshot (default name snap-<timestamp>)'
    'list:list snapshots as a tree'
    'revert:revert to a snapshot and leave the VM running'
    'delete:delete a snapshot and its children'
  )
  case $CURRENT in
    3) _describe -t command 'command' cmds ;;
    4) _virutil_domains ;;
    *)
      case $words[3] in
        revert|delete)
          local -a snaps
          snaps=(${(f)"$(virsh -c qemu:///system snapshot-list --domain ${words[4]} 2>/dev/null | awk 'NR>2 && $1 !~ /^-/ {print $1}')"})
          _describe -t snapshot 'snapshot' snaps
          ;;
      esac
      ;;
  esac
}

_virutil_domain() {
  local -a cmds=(
    'create:define a domain and boot the installer'
    'delete:undefine a domain and delete its disks'
    'list:list all domains and their state'
    'start:power on a domain'
    'shutdown:request a graceful shutdown (ACPI)'
    'addr:show guest interface addresses'
  )
  case $words[3] in
    start|shutdown|addr)
      (( CURRENT == 4 )) && _virutil_domains
      ;;
    list) ;;                        # takes no arguments
    create)
      case $CURRENT in
        3) _describe -t command 'command' cmds ;;
        4) ;;                       # the new domain's name: nothing to complete
        5) _files -g '*.iso' ;;
        *)
           # the value-taking flags read the next word, so complete for the flag
           # behind us before offering another flag
           case $words[CURRENT-1] in
             --disk)   _files; return ;;
             --virtio) _files -g '*.iso'; return ;;
             --osinfo) _virutil_osinfo; return ;;
             --size|--memory|--vcpus|--network) return ;;
           esac
           _values 'option' \
             '--size[disk size in GiB]' \
             '--memory[guest RAM in MiB]' \
             '--vcpus[virtual CPUs]' \
             '--disk[disk image path]' \
             '--osinfo[libosinfo id]' \
             '--virtio[virtio-win ISO to attach]' \
             '--no-virtio[do not attach a virtio-win ISO]' \
             '--network[virt-install --network value]' \
             '--bios[seabios instead of UEFI]' \
             '--dry-run[print the domain XML and define nothing]'
           ;;
      esac
      ;;
    delete)
      case $CURRENT in
        4) _virutil_domains ;;
        *) _values 'option' \
             '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
             '--keep-disk[undefine but leave the disks in place]'
           ;;
      esac
      ;;
    *) (( CURRENT == 3 )) && _describe -t command 'command' cmds ;;
  esac
}

_virutil "$@"
