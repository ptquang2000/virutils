# parser -- top-level dispatch plus the helpers every module shares

MODULES=(domain snapshot sync pull push exec usb)

die()  { printf '%s\n' "$@" >&2; exit 1; }
warn() { printf '%s\n' "$@" >&2; }
say()  { printf '%s\n' "$@" >&2; }

top_usage() {
    cat >&2 <<'EOF'
usage: virutil MODULE [ARGS]

domains
  domain     the domain lifecycle: create, delete, list, start, shutdown, addr, port
  snapshot   external snapshots (disk and memory) for libvirt domains

transfer
  sync       fetch build output from the Windows host and push it into a guest
  pull       copy a file or directory out of a running guest
  push       copy a file or directory from the host into a guest

  All three go through the guest's own disk image: sync and push shut a running
  guest down (and start it again after), pull leaves it running. 'push --live'
  is the exception -- it copies into a running guest over its own network,
  touching neither the disk image nor the guest's uptime.

guest
  exec       run commands inside a Windows guest via the QEMU guest agent

hardware
  usb        USB passthrough end to end from the Windows host under WSL

Run 'virutil <module>' for a module's own usage.
EOF
    exit "${1:-1}"
}

# parse_dispatch "$@" -- sets MODULE and REST
parse_dispatch() {
    local m
    MODULE="${1:-}"
    if [[ -z "$MODULE" ]]; then top_usage 1; fi
    case "$MODULE" in
        help|-h|--help) top_usage 0 ;;
    esac
    shift
    for m in "${MODULES[@]}"; do
        [[ "$MODULE" == "$m" ]] || continue
        REST=("$@")
        return 0
    done
    die "virutil: unknown module: $MODULE (see: virutil help)"
}
