# Parser for virutil: top-level dispatch plus the helpers every module shares.
# Sourced by virutil; not executable on its own.

MODULES=(domain snapshot sync pull push exec usb)

die()  { printf '%s\n' "$@" >&2; exit 1; }
warn() { printf '%s\n' "$@" >&2; }
say()  { printf '%s\n' "$@" >&2; }

top_usage() {
    cat >&2 <<'EOF'
usage: virutil MODULE [ARGS]

domains
  domain     the domain lifecycle: create, delete, list, start, shutdown, addr
  snapshot   external snapshots (disk and memory) for libvirt domains

transfer
  sync       fetch build output from the Windows host and push it into a guest
  pull       copy files out of a running guest via a live disk snapshot
  push       copy a file or directory from the host into a guest on demand

guest
  exec       run commands inside a Windows guest via the QEMU guest agent

hardware
  usb        USB passthrough end to end from the Windows host under WSL

Run 'virutil <module>' for a module's own usage.
EOF
    exit "${1:-1}"
}

# parse_dispatch "$@" -- split the module name from the rest of the command line
# and validate it. Sets the globals MODULE and REST.
parse_dispatch() {
    local m
    MODULE="${1:-}"
    if [[ -z "$MODULE" ]]; then top_usage 1; fi
    case "$MODULE" in
        help|-h|--help) top_usage 0 ;;
    esac
    shift
    for m in "${MODULES[@]}"; do
        [[ "$MODULE" == "$m" ]] || continue
        REST=("$@")
        return 0
    done
    die "virutil: unknown module: $MODULE (see: virutil help)"
}
