# parser -- top-level dispatch plus the helpers every module shares

MODULES=(domain snapshot sync pull push exec usb)

die()  { printf '%s\n' "$@" >&2; exit 1; }
warn() { printf '%s\n' "$@" >&2; }
say()  { printf '%s\n' "$@" >&2; }

top_usage() {
    cat >&2 <<'EOF'
usage: virutil MODULE [ARGS]

domains
  domain     the domain lifecycle: create, delete, list, start, shutdown, addr, port
  snapshot   external snapshots (disk and memory) for libvirt domains

transfer
  sync       fetch build output from the Windows host and push it into a guest
  pull       copy a file or directory out of a running guest
  push       copy a file or directory from the host into a guest

  sync and push deliver into a running guest over its own network, touching
  neither the disk image nor the guest's uptime, and move only what changed -- so
  a re-run after rebuilding one file moves one file. pull reads back the same
  way. All three work on a Windows or a Linux guest and detect which (sync is
  told, by @guest in its config). All three take --disk to use the guest's disk
  image instead, which shuts a running guest down (and starts it again after) but
  needs nothing of the guest -- and which is Windows-only, since it mounts NTFS.

guest
  exec       run commands inside a guest via the QEMU guest agent

hardware
  usb        USB passthrough end to end from the Windows host under WSL

Run 'virutil <module>' for a module's own usage.
EOF
    exit "${1:-1}"
}

# parse_dispatch "$@" -- sets MODULE and REST
parse_dispatch() {
    local m
    MODULE="${1:-}"
    if [[ -z "$MODULE" ]]; then top_usage 1; fi
    case "$MODULE" in
        help|-h|--help) top_usage 0 ;;
    esac
    shift
    for m in "${MODULES[@]}"; do
        [[ "$MODULE" == "$m" ]] || continue
        REST=("$@")
        return 0
    done
    die "virutil: unknown module: $MODULE (see: virutil help)"
}
