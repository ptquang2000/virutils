# volume -- the staging-volume transport: a scratch qcow2 the host and a running
# guest take turns owning. Sourced by virutil; driven through modules/xfer.
#
#   host --(rsync over qemu-nbd)--> scratch qcow2 --(hotplug)--> guest
#                                                --(robocopy)--> C:\
#
# The point of it is what it does *not* need: the guest keeps running, and
# nothing has to be installed in it. virtio-blk is already there holding C:, and
# robocopy ships with Windows -- so the only guest-side requirement is the agent,
# which virutil needs for a clean shutdown anyway.
#
# The price is that every byte is written twice, and that the two sides must
# take strict turns. Two writers on one qcow2 is the one unrecoverable mistake
# available here, so the sequence is enforced rather than assumed:
#
#   1. the image is provably not attached to the domain   (volume_open)
#   2. host: qemu-nbd -c, mount, the caller's copy phase
#   3. host: umount, qemu-nbd -d, verified from /proc/mounts and sysfs
#   4. guest: attach-device --live, read-only for a write run
#   5. guest: robocopy, then detach-device --live
#
# Step 4 attaches read-only in the write direction, which is not a formality:
# Windows then cannot dirty the filesystem, so the next host-side mount does not
# have to deal with a volume the guest left half-closed. The read direction has
# no such luxury -- the guest has to write -- so it flushes and offlines the
# volume in the guest before the detach.
#
# The staging image is created once per domain and kept: formatting it is the
# slow part, and an empty qcow2 costs nothing to leave lying around.

VOLUME_DIR=/var/lib/libvirt/images
VOLUME_SIZE=16                 # GiB, sparse -- an upper bound, not an allocation
VOLUME_IMG=""
VOLUME_TARGET=""               # the vdX the disk is attached as
VOLUME_ATTACHED=0
VOLUME_MODE=""
VOLUME_FS=""                   # exfat or ntfs, decided by what the host can make

# volume_image -- the per-domain staging image path. Per domain rather than
# shared, because two runs against two guests must not queue behind each other,
# and because the disk is attached by path.
volume_image() {
    printf '%s/%s-xfer.qcow2' "$VOLUME_DIR" "$DOMAIN"
}

# The first free virtio target. vda is the guest's own disk; anything already in
# the domain is skipped so a leftover from an interrupted run cannot be
# shadowed by a second attach at the same name.
volume_free_target() {
    local used letter
    used="$("${VIRSH[@]}" domblklist "$DOMAIN" 2>/dev/null | awk 'NR>2 {print $1}')"
    for letter in b c d e f g h i j k l m n o p q r s t u v w x y z; do
        grep -qx "vd$letter" <<<"$used" || { printf 'vd%s' "$letter"; return 0; }
    done
    die "no free virtio disk target on $DOMAIN"
}

# True if the staging image is attached to the domain right now. This is the
# gate on every host-side mount: the image must be the host's alone.
volume_is_attached() {
    "${VIRSH[@]}" domblklist "$DOMAIN" 2>/dev/null \
        | awk -v img="$VOLUME_IMG" '$2 == img { found = 1 } END { exit !found }'
}

volume_disk_xml() {
    local readonly="$1"
    cat <<EOF
<disk type='file' device='disk'>
  <driver name='qemu' type='qcow2' cache='none' io='io_uring' discard='unmap'/>
  <source file='$VOLUME_IMG'/>
  <target dev='$VOLUME_TARGET' bus='virtio'/>
  <serial>$XFER_LABEL</serial>${readonly:+
  <readonly/>}
</disk>
EOF
}

# --- image lifecycle --------------------------------------------------------

# Which filesystem the staging volume gets. exFAT first: it is an in-kernel
# driver on the host, where NTFS is FUSE (ntfs-3g), and Windows reads both
# natively -- so exFAT is the faster half of the double write, by a wide margin
# on many small files. Neither is a hard requirement: with no mkfs at all the
# guest formats it, which is the case on a host that only ever mounts NTFS.
volume_pick_fs() {
    if command -v mkfs.exfat >/dev/null; then VOLUME_FS=exfat
    elif command -v mkfs.ntfs >/dev/null || command -v mkntfs >/dev/null; then VOLUME_FS=ntfs
    else VOLUME_FS=guest
    fi
}

# One GPT partition spanning the disk. Windows will not touch a fixed disk with
# no partition table -- it shows up as 'not initialized' -- so the superfloppy
# layout that would be simpler here is not an option.
volume_partition() {
    "${SUDO[@]}" sfdisk --quiet "$NBD" <<'EOF'
label: gpt
type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7
EOF
    "${SUDO[@]}" partx -u "$NBD" 2>/dev/null || true
    udevadm settle
}

# volume_create -- make the staging image if it is not there yet, and format it
# by whichever half of the machine can. Idempotent: an existing image with a
# readable filesystem is left exactly as it is.
volume_create() {
    local created=0
    if [[ ! -e "$VOLUME_IMG" ]]; then
        say "staging volume: creating $VOLUME_IMG (${VOLUME_SIZE} GiB, sparse)"
        local -a imgsudo=()
        [[ -w "$(dirname -- "$VOLUME_IMG")" ]] || imgsudo=("${SUDO[@]}")
        "${imgsudo[@]}" qemu-img create -f qcow2 -o cluster_size=1M \
            -- "$VOLUME_IMG" "${VOLUME_SIZE}G" >/dev/null \
            || die "could not create $VOLUME_IMG"
        created=1
    fi

    volume_pick_fs
    nbd_connect "$VOLUME_IMG"

    local part; part="$(nbd_find_part exfat ntfs)"
    if [[ -n "$part" ]]; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
        return 0
    fi

    (( created )) || warn "staging volume $VOLUME_IMG has no readable filesystem;" \
                          "reformatting it (nothing on it is worth keeping)"
    volume_partition

    case "$VOLUME_FS" in
        exfat)
            say "staging volume: formatting exFAT"
            "${SUDO[@]}" mkfs.exfat -n "$XFER_LABEL" "${NBD}p1" >/dev/null \
                || die "mkfs.exfat failed on ${NBD}p1"
            ;;
        ntfs)
            say "staging volume: formatting NTFS"
            local mk; mk="$(command -v mkfs.ntfs || command -v mkntfs)"
            "${SUDO[@]}" "$mk" --quick --label "$XFER_LABEL" "${NBD}p1" >/dev/null \
                || die "$mk failed on ${NBD}p1"
            ;;
        guest)
            # Nothing on the host can make a filesystem Windows reads, so
            # Windows makes it: the blank disk is handed over read-write once,
            # formatted from inside, and handed back. It only happens on the
            # first run against a domain.
            "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
            volume_format_in_guest
            return 0
            ;;
    esac

    "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
}

# The fallback for a host with no mkfs the guest could read: attach the raw
# image read-write and let Windows initialise, partition and format it. Slower
# than doing it here and it costs one read-write attach, but it needs nothing
# installed on the host and produces a filesystem Windows is certain to like.
volume_format_in_guest() {
    say "staging volume: no host mkfs for exFAT or NTFS -- formatting it in $DOMAIN"
    VOLUME_TARGET="$(volume_free_target)"
    volume_disk_xml "" | "${VIRSH[@]}" attach-device "$DOMAIN" --live /dev/stdin \
        || die "could not attach the staging volume to $DOMAIN for formatting"
    VOLUME_ATTACHED=1

    xfer_ps '
$disk = $null
$deadline = (Get-Date).AddSeconds(30)
do {
  '"$(xfer_ps_find_disk)"'
  if ($disk) { break }
  Start-Sleep -Milliseconds 500
} while ((Get-Date) -lt $deadline)
if (-not $disk) { throw "the staging disk never appeared in the guest" }
if ($disk.IsOffline)  { Set-Disk -Number $disk.Number -IsOffline $false }
if ($disk.IsReadOnly) { Set-Disk -Number $disk.Number -IsReadOnly $false }
if ($disk.PartitionStyle -eq "RAW") { Initialize-Disk -Number $disk.Number -PartitionStyle GPT }
$part = Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |
        Where-Object { $_.Type -ne "Reserved" } | Select-Object -First 1
if (-not $part) { $part = New-Partition -DiskNumber $disk.Number -UseMaximumSize -AssignDriveLetter }
Format-Volume -Partition $part -FileSystem NTFS -NewFileSystemLabel "'"$XFER_LABEL"'" -Full:$false -Confirm:$false | Out-Null
Write-Output "formatted"' \
        || die "formatting the staging volume inside $DOMAIN failed"

    volume_release_in_guest
    volume_detach
    VOLUME_FS=ntfs
}

# --- the two halves ---------------------------------------------------------

# volume_open MODE -- take host-side ownership of the staging volume and mount
# it at MNT. MODE is write (the caller fills it) or read (the caller empties it
# after volume_collect has filled it from the guest).
volume_open() {
    VOLUME_MODE="$1"
    xfer_privilege

    command -v rsync >/dev/null || die "rsync not installed"
    command -v sfdisk >/dev/null || die "sfdisk not installed (util-linux)"
    if (( ${#SUDO[@]} )); then
        command -v sudo >/dev/null || die "sudo not installed; nbd and mount need it"
        sudo -v || die "sudo authentication failed"
    fi

    VOLUME_IMG="$(volume_image)"
    MNT="${MNT:-/mnt/$DOMAIN-xfer}"

    # A stale nbd or mount from a failed run: going on would end with us
    # detaching or unmounting something that was never ours.
    nbd_attached && die "$NBD is already attached; free it or set @nbd elsewhere" \
                        "  sudo qemu-nbd -d $NBD"
    mnt_mounted && die "$MNT is already mounted; unmount it first" \
                       "  sudo umount $MNT"

    trap xfer_close EXIT
    XFER_ARMED=1

    # The image may still be in the domain from a run that died between the
    # robocopy and the detach. Take it back before touching it -- this is the
    # check that keeps the host and the guest from writing at once.
    if volume_is_attached; then
        warn "the staging volume is still attached to $DOMAIN from an earlier run;" \
             "detaching it before the host takes it"
        VOLUME_TARGET="$("${VIRSH[@]}" domblklist "$DOMAIN" \
                         | awk -v img="$VOLUME_IMG" '$2 == img {print $1; exit}')"
        VOLUME_ATTACHED=1
        volume_detach
    fi

    volume_create

    nbd_connect "$VOLUME_IMG"
    local part; part="$(nbd_find_part exfat ntfs)"
    [[ -n "$part" ]] || die "no exFAT or NTFS partition on the staging volume" \
                            "-- remove $VOLUME_IMG and run again to rebuild it"

    local fstype; fstype="$("${SUDO[@]}" blkid -o value -s TYPE "$part")"
    "${SUDO[@]}" mkdir -p "$MNT"
    # uid=/gid= hand the tree to the invoking user, so the copy phase needs no
    # privilege of its own and the sudo timestamp stays out of the long part.
    "${SUDO[@]}" mount -t "$fstype" -o "uid=$(id -u),gid=$(id -g)" "$part" "$MNT" \
        || die "could not mount the staging volume ($fstype) at $MNT"
    mnt_writable || die "the staging volume mounted read-only at $MNT"

    say "staging: $MNT ($fstype, $(nbd_part_size "$part") GiB)"

    # Every run starts from an empty volume, in both directions. The image is
    # kept between runs because formatting it is the slow part -- but its
    # *contents* are one run's payload, and delivery is a robocopy of the whole
    # tree onto C:. Leaving last run's files there would silently re-deliver
    # them, every run, for as long as the image lives.
    find "$MNT" -mindepth 1 -maxdepth 1 \
         ! -name 'System Volume Information' -exec rm -rf -- {} + 2>/dev/null || true
}

# volume_handoff READONLY -- release the volume host-side and give it to the
# guest. The release is verified from /proc/mounts and sysfs, not from exit
# codes, because a umount that silently failed and an attach that follows it is
# exactly the two-writer case.
volume_handoff() {
    local readonly="$1"

    sync
    if mnt_mounted; then
        "${SUDO[@]}" umount "$MNT" || die "could not unmount $MNT"
    fi
    if nbd_attached; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
    fi
    sync

    # An if, not '||' and '&&' chained: with both probes false the chain's exit
    # status would be the failing probe's, and set -e would take the run down at
    # the exact moment everything is fine.
    if mnt_mounted || nbd_attached; then
        die "the staging volume is still held by the host ($MNT / $NBD);" \
            "refusing to hand it to $DOMAIN -- two writers on one image" \
            "is the one mistake nothing here can undo"
    fi

    VOLUME_TARGET="$(volume_free_target)"
    volume_disk_xml "$readonly" | "${VIRSH[@]}" attach-device "$DOMAIN" --live /dev/stdin \
        || die "could not attach the staging volume to $DOMAIN"
    VOLUME_ATTACHED=1
    say "handed $VOLUME_TARGET to $DOMAIN${readonly:+ (read-only)}"
}

# The guest's own release: flush its cache and take the volume offline, so the
# filesystem is closed before the device disappears underneath it. Skipping this
# is what leaves an NTFS volume dirty, which ntfs-3g then refuses to mount
# read-write on the next run.
volume_release_in_guest() {
    xfer_ps '
try { Get-Volume -FileSystemLabel "'"$XFER_LABEL"'" -ErrorAction SilentlyContinue |
      Write-VolumeCache -ErrorAction SilentlyContinue } catch {}
# By serial or label only -- deliberately not the RAW fallback the format path
# uses. Taking a disk offline is a real action, and "the unformatted one" is a
# guess: on a guest with another blank disk it would be the wrong one.
$d = Get-Disk | Where-Object { $_.SerialNumber -like "*'"$XFER_LABEL"'*" } | Select-Object -First 1
if (-not $d) {
  $v = Get-Volume -FileSystemLabel "'"$XFER_LABEL"'" -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($v -and $v.DriveLetter) {
    $d = Get-Partition -DriveLetter $v.DriveLetter -ErrorAction SilentlyContinue |
         Get-Disk -ErrorAction SilentlyContinue | Select-Object -First 1
  }
}
if ($d) { try { Set-Disk -Number $d.Number -IsOffline $true -ErrorAction Stop } catch {} }
exit 0' >/dev/null 2>&1 || true
}

volume_detach() {
    (( VOLUME_ATTACHED )) || return 0
    volume_disk_xml "" | "${VIRSH[@]}" detach-device "$DOMAIN" --live /dev/stdin \
        >/dev/null 2>&1 \
        || warn "could not detach the staging volume from $DOMAIN;" \
                "remove it by hand before the next run:" \
                "  ${VIRSH[*]} detach-disk $DOMAIN $VOLUME_TARGET --live"

    # The detach is asynchronous -- libvirt returns once the guest has been
    # asked, not once it has let go -- and the next host-side mount must not
    # start before it has.
    local i
    for (( i = 0; i < 30; i++ )); do
        volume_is_attached || { VOLUME_ATTACHED=0; return 0; }
        sleep 0.5
    done
    warn "$DOMAIN has not released the staging volume after 15s"
    VOLUME_ATTACHED=0
}

# --- the transport contract -------------------------------------------------

# Write: hand the filled volume over read-only, robocopy its whole tree onto
# C:\, take it back. The tree under MNT is already C:-shaped -- that is the
# whole reason sync and push need no changes -- so one robocopy of the root
# reproduces every mapping the copy phase made.
volume_deliver() {
    local letter
    volume_handoff readonly

    letter="$(xfer_drive_letter 30)"
    [[ -n "$letter" ]] || die "the staging volume never got a drive letter in $DOMAIN." \
                              "Check it with: virutil exec ps $DOMAIN Get-Volume"
    say "guest: $letter: -> C:\\"

    xfer_robocopy "$letter:\\" "C:\\" || die "robocopy failed inside $DOMAIN"

    volume_release_in_guest
    volume_detach
    say "delivered -> $DOMAIN"
}

# Read: hand an empty volume over read-write, have the guest fill it from the
# named C:-relative paths, take it back and mount it for the caller. Each
# pattern keeps its position under the root, so what lands at MNT has the same
# C:-relative shape the disk transport would have shown.
volume_collect() {
    local letter pat script sep
    volume_handoff ""

    letter="$(xfer_drive_letter 30)"
    [[ -n "$letter" ]] || die "the staging volume never got a drive letter in $DOMAIN"
    say "guest: C:\\ -> $letter:"

    # One script for every pattern: each round trip through the agent costs a
    # process launch in the guest, and a config with a dozen map rules would
    # spend more time starting powershell than copying.
    script='$ErrorActionPreference = "Stop"
$copied = 0
foreach ($p in @('
    # Joined with a separator *between* items, never after the last one:
    # powershell parses @('a','b',) as an error, not as a two-element array.
    local sep=""
    for pat in "$@"; do
        script+="$sep'$(xfer_ps_quote "$pat")'"; sep=","
    done
    script+=')) {
  $src = Join-Path "C:\" $p
  foreach ($item in @(Get-Item -Path $src -ErrorAction SilentlyContinue)) {
    if (-not $item) { continue }
    $rel = $item.FullName.Substring(3)
    $dst = Join-Path "'"$letter"':\" $rel
    if ($item.PSIsContainer) {
      $null = robocopy $item.FullName $dst /E /NJH /NJS /NP /NDL /R:1 /W:1
      if ($LASTEXITCODE -ge 8) { throw "robocopy $($item.FullName) failed ($LASTEXITCODE)" }
    } else {
      $null = New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst)
      Copy-Item -LiteralPath $item.FullName -Destination $dst -Force
    }
    $copied++
  }
}
Write-Output "collected $copied item(s)"
if ($copied -eq 0) { throw "nothing matched in the guest" }'

    xfer_ps "$script" || die "collecting from $DOMAIN failed"

    volume_release_in_guest
    volume_detach

    # And back to the host, which now owns the volume again.
    nbd_connect "$VOLUME_IMG"
    local part; part="$(nbd_find_part exfat ntfs)"
    [[ -n "$part" ]] || die "the staging volume came back unreadable"
    local fstype; fstype="$("${SUDO[@]}" blkid -o value -s TYPE "$part")"
    "${SUDO[@]}" mount -t "$fstype" -o "ro,uid=$(id -u),gid=$(id -g)" "$part" "$MNT" \
        || die "could not mount the returned staging volume at $MNT"
    say "collected into $MNT"
}

# Teardown, from the EXIT trap. Whatever happened, the run must not end with the
# volume mounted here *and* attached there. Host side first, then the guest's,
# because the host's is the one that blocks the next run.
volume_close() {
    (( XFER_ARMED )) || return 0

    if mnt_mounted; then
        sync
        "${SUDO[@]}" umount "$MNT" || true
    fi
    if nbd_attached; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
    fi
    sync

    if (( VOLUME_ATTACHED )); then
        volume_release_in_guest
        volume_detach
    fi

    if mnt_mounted || nbd_attached; then
        warn "" \
             "teardown could not be verified -- the staging volume is still held" \
             "by the host. Nothing in $DOMAIN was harmed, but free it before the" \
             "next run:" \
             "  sudo umount $MNT" \
             "  sudo qemu-nbd -d $NBD"
        exit 1
    fi
}
