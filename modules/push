# push -- copy a file or directory from the host into a guest's C: drive.
#
# One transport, in modules/xfer: over the guest's own NIC, driven by the guest
# agent. The guest keeps running and sees no new device, and its copier takes
# only what differs from what it already has, so a re-push of a build that
# changed one file moves one file. Needs an agent and a route back to this host;
# a Windows guest also needs smbd and root here to bind port 445, where a Linux
# one needs neither.
#
# Which guest is on the other side is asked, not flagged -- see guest_os in
# modules/guest. DST is spelled in that guest's own flavour.

push_usage() {
    printf '%s\n' \
        "usage: virutil push VM SRC DST" \
        "" \
        "  VM   libvirt domain to copy into; it has to be running, since the" \
        "       copy is delivered over its own network" \
        "  SRC  host file or directory to copy" \
        "  DST  guest path, relative to the guest's root -- C:\\ on Windows," \
        "       / on Linux. A trailing slash means a directory, exactly as" \
        "       with rsync. On Windows, backslashes and a C:\\ prefix are" \
        "       tolerated; '..' is refused either way." \
        "" \
        "  -h, --help              this message" \
        "" \
        "A directory source is copied recursively. The payload is served to" \
        "the running guest, which fetches it itself -- robocopy on Windows," \
        "rsync on Linux -- and so moves only what changed. The guest's OS is" \
        "detected; see README.md." >&2
    exit "${1:-1}"
}

# Normalise a guest-side DST into a path relative to the guest's root, in the
# flavour that guest spells. The caller handles the trailing slash that marks a
# directory before this strips it. See guest_norm_win/guest_norm_posix in
# modules/guest for what "normalise" means and why the two flavours differ.
push_norm_dst() {
    if [[ "${GUEST_OS:-windows}" == linux ]]; then
        guest_norm_posix "$1" destination
    else
        guest_norm_win "$1" destination
    fi
}

# push_check_readable SRC -- refuse a payload holding files this user cannot
# read, before anything is served.
#
# The -r test above covers only the top of the tree, and a directory push serves
# its contents: the export is read as the invoking user by both servers, so a
# file that user cannot read is one the guest will be offered and denied. rsync
# reports that as exit 23 *after* transferring everything else, and the message
# names the file but not the side -- which is exactly the shape of failure this
# refuses to produce. Same reasoning as xfer_room_for: check before the spend.
#
# ! -readable is GNU find's, which is what is on any host that got this far.
push_check_readable() {
    local src="$1" bad count shown
    [[ -d "$src" ]] || return 0

    bad="$(find "$src" ! -readable -print 2>/dev/null)"
    [[ -n "$bad" ]] || return 0

    count="$(printf '%s\n' "$bad" | wc -l)"
    shown="$(printf '%s\n' "$bad" | head -10)"
    (( count > 10 )) && shown+=$'\n'"  ... and $(( count - 10 )) more"

    die "$src holds $count path(s) $(id -un) cannot read, and the payload is" \
        "served as you -- so the guest would be offered them and refused," \
        "and rsync would fail with exit 23 after moving everything else." \
        "Nothing was served." \
        "" \
        "$shown" \
        "" \
        "Check their mode and owner here on the host. Either fix those, or" \
        "push a subdirectory that does not include them."
}

push_main() {
    local VM="" SRC="" DST=""

    while (( $# )); do
        case "$1" in
            -h|--help)      push_usage 0 ;;
            # Rejected rather than ignored, and each for its own reason. --smb
            # is what push now does, and silently accepting it would teach
            # nothing; --live and --disk named transports that no longer
            # exist, and silently accepting either would send the payload by a
            # route the caller did not ask for.
            --smb)          die "--smb is gone: delivering into the running" \
                                "guest over SMB is what push does now." \
                                "Drop the flag." ;;
            --live)         die "--live is gone: the HTTP transport it named" \
                                "has been removed. Delivering into the running" \
                                "guest is what push does now and uses SMB," \
                                "which moves only what changed; drop the flag." ;;
            --disk)         die "--disk is gone: writing the guest's disk" \
                                "image has been removed. push delivers into" \
                                "the running guest over its own network;" \
                                "drop the flag and start the guest." ;;
            -*)             warn "unrecognised argument: $1"; push_usage ;;
            *)
                if   [[ -z "$VM"  ]]; then VM="$1"
                elif [[ -z "$SRC" ]]; then SRC="$1"
                elif [[ -z "$DST" ]]; then DST="$1"
                else warn "unexpected argument: $1"; push_usage
                fi
                shift ;;
        esac
    done
    [[ -n "$VM" && -n "$SRC" && -n "$DST" ]] || push_usage

    [[ -e "$SRC" ]] || die "source not found: $SRC"
    [[ -r "$SRC" ]] || die "source not readable: $SRC"
    push_check_readable "$SRC"

    DOMAIN="$VM"
    domain_exists "$DOMAIN" || die "no such domain: $DOMAIN (see: virutil domain list)"

    # Which guest, and so which copier, which shell and which path flavour.
    # Asked rather than flagged -- see guest_os in modules/guest.
    GUEST_OS="$(guest_os "$DOMAIN")"

    xfer_check net
    # Reports for itself: it knows what landed and how long it took, which is
    # more than "copied" says.
    push_net "$SRC" "$DST"
}

# --- delivering into the running guest, over its own network ----------------

# A path inside a single-quoted powershell string. Backslashes are literal
# there, which is the whole reason for preferring it over the double-quoted
# form; only the quote itself has to be escaped, by doubling.
push_ps_quote() {
    local s="$1"
    printf "'%s'" "${s//\'/\'\'}"
}

# push_net SRC DST -- what push does. The host exports the payload read-only
# and the running guest pulls it with its own
# copier, which takes only the files that differ from what it already holds --
# so a second push of a build that changed one file moves one file, and leaves
# the rest alone down to their timestamps.
#
# A file source is served from a one-entry staging directory; a directory source
# is served in place, no pack and no copy. That is not a Windows quirk it would
# be nice to drop on Linux: an SMB share and an rsync module are both a
# *directory*, so a bare file has to be given one to sit in either way.
#
# Everything up to the export is shared. What differs is the pair at the far end
# -- server and copier -- chosen by the dispatchers above.
#
# The Windows guest side is one powershell run, and nothing in it uses `throw`:
# a terminating error in powershell arrives as eight lines of CategoryInfo and
# FullyQualifiedErrorId wrapped around one useful sentence, and buries the
# message that says whether the network or the destination was at fault. So each
# failure writes one line and exits with a code the host can name below. The
# Linux side exits with rsync's own code, which needs no such translation.
PUSH_RC_MKDIR=92            # the destination directory could not be created
PUSH_RC_ROBO=93             # robocopy returned a failure code (>= 8)

push_net_serve() {
    if [[ "$GUEST_OS" == linux ]]; then xfer_rsyncd_serve "$1" "$2"
    else                                xfer_smb_serve    "$1" "$2"; fi
}

push_net_fetch() {
    if [[ "$GUEST_OS" == linux ]]; then push_lin_fetch "$@"
    else                                push_smb_fetch "$@"; fi
}

push_net_report() {
    if [[ "$GUEST_OS" == linux ]]; then push_lin_report "$@"
    else                                push_smb_report "$@"; fi
}

push_net_die() {
    if [[ "$GUEST_OS" == linux ]]; then
        guest_rsync_die "$1" "$2" "the payload"
    else
        push_smb_die "$1" "$2"
    fi
}

# push_show_dst DST IS_DIR -- the destination as the guest spells it, for the
# line a person reads. Cosmetic only; nothing is addressed through it.
push_show_dst() {
    local p
    if [[ "$GUEST_OS" == linux ]]; then
        p="/$1"
        (( $2 )) && p="${p%/}/"
        printf '%s' "$p"
    else
        p="${1//\//\\}"
        (( $2 )) && p="${p:+$p\\}"
        printf 'C:\\%s' "$p"
    fi
}

push_net() {
    local SRC="$1" DST="$2" VM="$DOMAIN"
    local DST_IS_DIR export_dir base ip host rc=0 reported t0 elapsed

    if [[ "$DST" == */ || "$DST" == *'\' ]]; then DST_IS_DIR=1; else DST_IS_DIR=0; fi
    DST="$(push_norm_dst "$DST")" || exit 1
    # A directory source always lands *in* a directory, as with rsync.
    [[ -d "$SRC" ]] && DST_IS_DIR=1

    ip="$(domain_ip "$DOMAIN")" \
        || die "could not work out $DOMAIN's address, so there is nothing to" \
               "serve the payload to. Check 'virutil domain addr $DOMAIN'."
    host="$(xfer_host_addr "$ip")"
    [[ -n "$host" ]] \
        || die "no route from this host to $DOMAIN at $ip, so the guest has" \
               "no address to fetch from. A guest on an isolated network" \
               "cannot be delivered to over its own network."

    # What gets exported. A directory is served where it lies; a file is
    # hardlinked (or, across filesystems, copied) into a scratch directory of
    # its own, so the share carries that one file and none of its siblings.
    #
    # Absolute, and not as a tidiness: smb.conf's `path` is resolved by smbd
    # against smbd's own working directory, which is root's and not the caller's.
    # rsyncd's `path` has the same problem for the same reason, so both need it.
    # A relative SRC -- `./build/`, the ordinary way to name a directory you are
    # standing in -- would name a path that does not exist over there, and the
    # share would come up pointing at nothing. The guest's robocopy then fails
    # its tree connect with exit 16, which says only "serious error" and nothing
    # about which side of the wire was at fault. The file branch below never had
    # this problem: its staging directory is an absolute mktemp path.
    if [[ -d "$SRC" ]]; then
        export_dir="$(cd -- "$SRC" && pwd -P)" \
            || die "could not resolve $SRC to an absolute path to serve it from"
    else
        mkdir -p "$VIRUTILS_TMP_DIR" \
            || die "could not create $VIRUTILS_TMP_DIR for the transfer payload"
        XFER_STAGE="$(mktemp -d "$VIRUTILS_TMP_DIR/smb.XXXXXX")" \
            || die "could not create a staging directory for the transfer"
        base="$(basename -- "$SRC")"
        # -p on the fallback, and it is not cosmetic: both copiers decide what
        # to move by comparing timestamps, so a staged copy stamped with the
        # current time is newer than anything in the guest and gets re-sent on
        # every push -- which quietly costs a file push the incrementality that
        # is the whole reason for this transport.
        #
        # The fallback is not the rare case it looks like. `ln` fails across
        # filesystems, and it also fails under fs.protected_hardlinks (default
        # on since Linux 3.6) for any file this user neither owns nor can
        # write -- which is every root-owned build artifact.
        ln "$SRC" "$XFER_STAGE/$base" 2>/dev/null \
            || cp -p -- "$SRC" "$XFER_STAGE/$base" \
            || die "could not stage $SRC for transfer"
        export_dir="$XFER_STAGE"
    fi

    push_net_serve "$export_dir" "$host"

    echo "push: $SRC -> $(push_show_dst "$DST" "$DST_IS_DIR")"

    t0="$(now_ms)"
    reported="$(push_net_fetch "$SRC" "$DST" "$DST_IS_DIR")" || rc=$?
    elapsed=$(( $(now_ms) - t0 ))
    (( rc == 0 )) || push_net_die "$rc" "$host"

    xfer_stop
    push_net_report "$SRC" "$reported" "$elapsed"
}

# push_smb_fetch SRC DST DST_IS_DIR -- the guest side, one powershell run.
# The script itself is payloads/push-dir.ps1 or payloads/push-file.ps1, shared
# verbatim with the Windows driver; all this decides is which of the two, and
# what the destination is called over there.
#
# Two payloads and not one because robocopy cannot rename onto a new name, so a
# single file has to go through Copy-Item -- see the head of push-file.ps1.
push_smb_fetch() {
    local SRC="$1" DST="$2" is_dir="$3" dst_win base script

    base="$(basename -- "$SRC")"

    if [[ -d "$SRC" ]]; then
        # Trailing slash means "contents into DST"; no slash means "DST/<name>",
        # matching rsync and the tar layout the --live path builds.
        if [[ "$SRC" == */ ]]; then
            dst_win="C:\\${DST//\//\\}"
        else
            dst_win="C:\\${DST:+${DST//\//\\}\\}$base"
        fi
        script="$(payload_render push-dir.ps1 \
            SRC="$XFER_SMB_UNC" DST="$dst_win")" || exit 1
        exec_ps_text "$script"
    else
        if (( is_dir )); then
            dst_win="C:\\${DST:+${DST//\//\\}\\}$base"
        else
            dst_win="C:\\${DST//\//\\}"
        fi
        script="$(payload_render push-file.ps1 \
            SRC="$XFER_SMB_UNC\\$base" DST="$dst_win")" || exit 1
        exec_ps_text "$script"
    fi
}

# push_smb_report SRC REPORTED MS -- what landed, and how fast. REPORTED is the
# guest's own line: "copied total ms" from a directory robocopy, or "bytes ms"
# from a file copy. The rate is computed from the guest's stopwatch rather than
# from MS: MS is this host's wall clock and holds an agent round trip and a
# powershell starting up, which for a small payload is nearly all of it -- so a
# rate computed from it would describe the overhead rather than the transfer.
push_smb_report() {
    local SRC="$1" reported="$2" ms="$3" rate what
    if [[ -d "$SRC" ]]; then
        local copied total gms
        read -r copied total gms <<<"$reported"
        what="$total file"; (( total == 1 )) || what+="s"
        if (( copied )); then what+=" present (some copied)"; else what+=" present (all up to date)"; fi
        echo "$DOMAIN: $what in $(fmt_duration "${gms:-$ms}")"
    else
        push_report_bytes "$reported" "$ms"
    fi
}

# push_report_bytes REPORTED MS -- a single file's landing, reported the same
# way whatever copied it: "bytes ms" from the guest. The rate comes from the
# guest's stopwatch rather than from MS, which is this host's wall clock and
# holds an agent round trip -- for a small payload, nearly all of it.
push_report_bytes() {
    local reported="$1" ms="$2" note="${3:-}" bytes gms rate
    read -r bytes gms <<<"$reported"
    rate="$(fmt_rate "$bytes" "${gms:-0}")"
    # No rate when nothing crossed: a throughput figure for a transfer that did
    # not happen describes the round trip, not the wire.
    [[ -n "$note" ]] && rate=""
    echo "$DOMAIN: done ($(fmt_bytes "${bytes:-0}")$note) in" \
         "$(fmt_duration "${gms:-$ms}")${rate:+ ($rate on the wire)}"
}

# --- the Linux guest side ---------------------------------------------------

# push_lin_fetch SRC DST DST_IS_DIR -- the guest side, one rsync. The script is
# payloads/push-dir.sh or payloads/push-file.sh, shared verbatim with the
# Windows driver; all this decides is which of the two, and what the destination
# is called over there.
#
# The trailing-slash rule is rsync's own, which is where push borrowed it from:
# `SRC/` means "the contents", `SRC` means "the directory itself". It costs
# nothing to honour here because the copier *is* rsync.
push_lin_fetch() {
    local SRC="$1" DST="$2" is_dir="$3" dst base script

    base="$(basename -- "$SRC")"

    if [[ -d "$SRC" ]]; then
        if [[ "$SRC" == */ ]]; then dst="/$DST"
        else                        dst="/${DST:+$DST/}$base"
        fi
        script="$(payload_render push-dir.sh \
            SRC="$XFER_RSYNCD_URL/" DST="$dst")" || exit 1
        exec_sh_text "$script"
    else
        if (( is_dir )); then dst="/${DST:+$DST/}$base"
        else                  dst="/$DST"
        fi
        script="$(payload_render push-file.sh \
            SRC="$XFER_RSYNCD_URL/$base" DST="$dst")" || exit 1
        exec_sh_text "$script"
    fi
}

# push_lin_report SRC REPORTED MS -- REPORTED is the guest's own line: "copied
# total ms" from a directory push, or "bytes ms" from a file one. The directory
# form carries a real count, where the Windows side can only say whether
# anything moved: rsync's --out-format is not localised, so counting its
# itemised lines is safe in a guest of any language.
push_lin_report() {
    local SRC="$1" reported="$2" ms="$3"
    local copied total gms what

    # The file form carries the same "did it move" flag the directory form
    # does, which the Windows side cannot: there a file push is Copy-Item and
    # always copies, so there would be nothing to report. Worth the extra field
    # -- "already current" is the answer a re-push is asked for.
    if [[ ! -d "$SRC" ]]; then
        read -r copied _ _ <<<"$reported"
        push_report_bytes "${reported#* }" "$ms" \
            "$( (( ${copied:-0} > 0 )) || printf ' (already current)' )"
        return 0
    fi

    read -r copied total gms <<<"$reported"
    what="$total file"; (( ${total:-0} == 1 )) || what+="s"
    if (( ${copied:-0} > 0 )); then what+=" present, $copied copied"
    else                            what+=" present (all up to date)"
    fi
    echo "$DOMAIN: $what in $(fmt_duration "${gms:-$ms}")"
}

# push_smb_die RC HOST -- name what went wrong; the guest has already printed
# its own line above.
push_smb_die() {
    local rc="$1" host="$2"
    case "$rc" in
        "$PUSH_RC_ROBO")
            die "robocopy could not complete the copy in the guest (its exit" \
                "code is above). Anything it did copy is left where it landed." ;;
        "$PUSH_RC_MKDIR")
            die "the guest could not create the destination directory; its" \
                "own message is above." ;;
        *)
            die "the guest failed to fetch the payload (exit $rc); its own" \
                "error is above. If it could not reach $host, check the" \
                "guest's outbound firewall." ;;
    esac
}
