# push -- copy a file or directory from the host into a guest's C: drive.
#
# Two transports, chosen by --live, both in modules/xfer:
#
#   default  the guest's disk image, mounted on the host. A running guest is
#            shut down around the copy and started again afterwards.
#   --live   HTTP over the guest's own NIC, driven by the guest agent. The
#            guest keeps running and sees no new device; it needs an agent, a
#            route back to this host and curl.exe.
#   --smb    the same, over SMB with robocopy in place of curl. The guest reads
#            a live tree rather than one tar, so a re-push moves only what
#            changed; it costs a rootful smbd on the host's port 445.

push_usage() {
    printf '%s\n' \
        "usage: virutil push [--live] VM SRC DST" \
        "" \
        "  VM   libvirt domain to copy into; without --live its disk image" \
        "       is written, so a running one is shut down first and started" \
        "       again afterwards" \
        "  SRC  host file or directory to copy" \
        "  DST  guest path, relative to C:\\; a trailing slash means a" \
        "       directory, exactly as with rsync. Backslashes and a C:\\" \
        "       prefix are tolerated; '..' is refused." \
        "" \
        "      --live              copy into the running guest instead: the" \
        "                          host serves the payload on the address the" \
        "                          guest reaches it at, and the guest fetches" \
        "                          it. Nothing is mounted, nothing is shut" \
        "                          down and no drive letter appears. Needs the" \
        "                          guest agent, a route from the guest back to" \
        "                          this host, and curl.exe in the guest." \
        "      --smb               like --live, but the guest fetches with" \
        "                          robocopy over SMB, copying only the files" \
        "                          that differ from what it already has. Needs" \
        "                          the guest agent, a route back to this host," \
        "                          and root on the host to bind port 445." \
        "  -h, --help              this message" \
        "" \
        "A directory source is copied recursively. Without --live the copy" \
        "writes to the guest's disk image, so the guest is shut down around" \
        "it; see README.md." >&2
    exit "${1:-1}"
}

# Normalise a guest-side DST into a C:-relative path: strip a drive prefix, turn
# backslashes into slashes, drop empty and '.' components, refuse '..' so the
# destination can never resolve outside the mount point. The caller handles the
# trailing slash that marks a directory before this strips it.
push_norm_dst() {
    local s="$1" out="" comp
    s="${s#[Cc]:}"
    s="${s//\\//}"
    while [[ -n "$s" ]]; do
        while [[ "$s" == /* ]]; do s="${s#/}"; done
        comp="${s%%/*}"
        [[ -n "$comp" ]] || break
        case "$comp" in
            '.') ;;
            '..') die "destination may not contain '..': $1" ;;
            *)    out="${out:+$out/}$comp" ;;
        esac
        s="${s#"$comp"}"
    done
    printf '%s' "$out"
}

push_main() {
    local VM="" SRC="" DST="" LIVE=0 SMB=0

    while (( $# )); do
        case "$1" in
            -h|--help)      push_usage 0 ;;
            --live)         LIVE=1; shift ;;
            --smb)          SMB=1; shift ;;
            -*)             warn "unrecognised argument: $1"; push_usage ;;
            *)
                if   [[ -z "$VM"  ]]; then VM="$1"
                elif [[ -z "$SRC" ]]; then SRC="$1"
                elif [[ -z "$DST" ]]; then DST="$1"
                else warn "unexpected argument: $1"; push_usage
                fi
                shift ;;
        esac
    done
    [[ -n "$VM" && -n "$SRC" && -n "$DST" ]] || push_usage
    (( LIVE && SMB )) && die "--live and --smb are two forms of the same" \
        "transport; pick one."

    [[ -e "$SRC" ]] || die "source not found: $SRC"
    [[ -r "$SRC" ]] || die "source not readable: $SRC"

    DOMAIN="$VM"
    domain_exists "$DOMAIN" || die "no such domain: $DOMAIN (see: virutil domain list)"

    if (( SMB )); then
        xfer_check live
        push_smb "$SRC" "$DST"
    elif (( LIVE )); then
        xfer_check live
        # Reports for itself: it knows what landed and how long it took, which
        # is more than "copied" says.
        push_live "$SRC" "$DST"
    else
        xfer_check write
        # guest_open arms the EXIT trap that unmounts and detaches again.
        guest_open
        push_copy "$SRC" "$DST"
        echo "copied -> $DOMAIN"
    fi
}

# push_copy SRC DST -- resolve DST under MNT and run the copy. A trailing slash
# on DST means "this is a directory, create it if needed".
push_copy() {
    local SRC="$1" DST="$2" dst_arg win_dst DST_IS_DIR
    if [[ "$DST" == */ || "$DST" == *'\' ]]; then DST_IS_DIR=1; else DST_IS_DIR=0; fi
    DST="$(push_norm_dst "$DST")" || exit 1
    dst_arg="$MNT"
    [[ -n "$DST" ]] && dst_arg="$MNT/$DST"
    [[ $DST_IS_DIR = 1 ]] && dst_arg="$dst_arg/"

    win_dst="${DST//\//\\}"
    [[ $DST_IS_DIR = 1 ]] && win_dst="${win_dst:+$win_dst\\}"
    echo "push: $SRC -> C:\\$win_dst"
    "${RSYNC[@]}" "$SRC" "$dst_arg"
}

# --- the live path ----------------------------------------------------------

# A path inside a single-quoted powershell string. Backslashes are literal
# there, which is the whole reason for preferring it over the double-quoted
# form; only the quote itself has to be escaped, by doubling.
push_ps_quote() {
    local s="$1"
    printf "'%s'" "${s//\'/\'\'}"
}

# push_live SRC DST -- serve the payload on the host and have the running guest
# fetch it. A file goes over the wire as itself; a directory goes as a tar,
# which Windows has unpacked natively since 1803 and which is the only way to
# carry a tree in the one request this transport makes.
push_live() {
    local SRC="$1" DST="$2" VM="$DOMAIN"
    local DST_IS_DIR DST_TAR="" win_dst ip host rc=0 reported t0 elapsed

    if [[ "$DST" == */ || "$DST" == *'\' ]]; then DST_IS_DIR=1; else DST_IS_DIR=0; fi
    DST="$(push_norm_dst "$DST")" || exit 1
    # A directory source always lands *in* a directory, as with rsync, so the
    # trailing slash is not the user's to get wrong.
    [[ -d "$SRC" ]] && { DST_IS_DIR=1; DST_TAR=1; }

    ip="$(domain_ip "$DOMAIN")" \
        || die "could not work out $DOMAIN's address, so there is nothing to" \
               "serve the payload to. Check 'virutil domain addr $DOMAIN'."
    host="$(xfer_host_addr "$ip")"
    [[ -n "$host" ]] \
        || die "no route from this host to $DOMAIN at $ip, so the guest has" \
               "no address to fetch from. A guest on an isolated network" \
               "cannot use --live; drop it to write to the disk image instead."

    # Not a command substitution: the payload may be a tar in the scratch
    # directory, and a subshell would take both the directory and its own EXIT
    # trap -- which removes it -- down with it.
    push_live_payload "$SRC"
    xfer_http_serve "$PUSH_PAYLOAD" "$host"

    win_dst="${DST//\//\\}"
    (( DST_IS_DIR )) && win_dst="${win_dst:+$win_dst\\}"
    # The size goes in the line printed *before* the transfer, not after it:
    # it is the number that tells you how long to wait, and after the fact you
    # already know.
    # A directory crosses as a tar, so its size is the tar's -- said out loud,
    # because a one-file directory reading as 10 KiB is otherwise a puzzle.
    echo "push --live: $SRC -> C:\\$win_dst ($(fmt_bytes "$XFER_HTTP_BYTES")${DST_TAR:+ tar})"

    t0="$(now_ms)"
    reported="$(push_live_fetch "$SRC" "$DST" "$DST_IS_DIR")" || rc=$?
    elapsed=$(( $(now_ms) - t0 ))
    (( rc == 0 )) || push_live_die "$rc" "$host"

    # The guest reporting success and the host never finishing the transfer
    # cannot both be true; if they are, the guest wrote something short.
    xfer_http_wait \
        || die "the guest reported success but the host never finished" \
               "serving the payload; treat what landed in the guest as" \
               "incomplete and run again."

    xfer_http_stop
    push_live_report "$SRC" "$reported" "$elapsed"
}

# push_live_report SRC REPORTED MS -- what landed, and how fast. REPORTED is
# what the guest printed: the byte count of the file it wrote, or the word "ok"
# from an unpack, which has nothing to count that the host does not already know.
push_live_report() {
    local SRC="$1" reported="$2" ms="$3" rate="" what
    # The rate comes from the server's own clock, not this one: the wall clock
    # here also holds an agent round trip and a powershell starting up, roughly
    # a second and a half of it, which for anything short is most of the run.
    # Said "on the wire" because the two numbers on this line will not multiply
    # out, and that is the honest reason why.
    rate="$(fmt_rate "$XFER_HTTP_BYTES" "$XFER_HTTP_MS")"
    [[ -n "$rate" ]] && rate="$rate on the wire"

    if [[ -d "$SRC" ]]; then
        what="$PUSH_PAYLOAD_FILES file"
        (( PUSH_PAYLOAD_FILES == 1 )) || what+="s"
        what+=" unpacked"
    else
        # A short write is the failure this transport can produce without
        # anything erroring, so the size the guest reports is checked rather
        # than printed back.
        [[ "$reported" == "$XFER_HTTP_BYTES" ]] \
            || die "the guest wrote $(fmt_bytes "${reported:-0}") of" \
                   "$(fmt_bytes "$XFER_HTTP_BYTES"); what landed in the guest" \
                   "is incomplete. Run again."
        what="done"
    fi

    echo "$DOMAIN: $what in $(fmt_duration "$ms")${rate:+ ($rate)}"
}

# push_live_payload SRC -- set PUSH_PAYLOAD to what actually goes over the wire.
# A file is served as itself with no copy; a directory is tarred into the
# scratch directory first. A trailing slash on a directory source means its
# contents rather than the directory itself, matching rsync.
PUSH_PAYLOAD=""
PUSH_PAYLOAD_FILES=0        # entries in the tar, for the line printed at the end
push_live_payload() {
    local SRC="$1" tar_path
    if [[ -f "$SRC" ]]; then
        PUSH_PAYLOAD="$SRC"
        return 0
    fi
    [[ -d "$SRC" ]] || die "source is neither a file nor a directory: $SRC"

    xfer_http_dir
    # du, not a guess: the tar is about the size of what goes into it, and the
    # check is worth more than its cost on the one case that matters.
    xfer_room_for "$(du -sb --apparent-size "$SRC" | cut -f1)" "$XFER_HTTP_DIR"
    tar_path="$XFER_HTTP_DIR/payload.tar"
    if [[ "$SRC" == */ ]]; then
        tar -cf "$tar_path" -C "$SRC" . \
            || die "could not pack $SRC for transfer"
    else
        tar -cf "$tar_path" -C "$(dirname -- "$SRC")" -- "$(basename -- "$SRC")" \
            || die "could not pack $SRC for transfer"
    fi
    # Counted from the tar rather than from the guest: this is the authority on
    # what was sent, and asking the guest would count whatever was already in
    # the destination too.
    PUSH_PAYLOAD_FILES="$(tar -tf "$tar_path" | grep -vc '/$' || true)"
    PUSH_PAYLOAD="$tar_path"
}

# push_live_fetch SRC DST DST_IS_DIR -- the guest side, as one powershell run.
# curl.exe rather than Invoke-WebRequest: it has shipped in Windows since 1803,
# it streams to the file instead of buffering the response in memory, and its
# exit code says what happened.
#
# Nothing here uses `throw`. A terminating error in powershell arrives as eight
# lines of CategoryInfo and FullyQualifiedErrorId wrapped around one useful
# sentence, and buries curl's own message -- which is the one that says whether
# the network or the destination was at fault. So each failure writes one line
# and exits with a code the host can name. curl's codes are passed through as
# they stand; the codes below 100 that curl does not use are ours.
PUSH_RC_UNPACK=90           # tar.exe could not unpack the payload
PUSH_RC_NO_TAR=91           # this guest has no tar.exe
PUSH_RC_MKDIR=92            # the destination directory could not be created

push_live_fetch() {
    local SRC="$1" DST="$2" is_dir="$3" script dst_win

    if [[ -d "$SRC" ]]; then
        dst_win="C:\\${DST//\//\\}"
        script=$(printf '%s\n' \
            '$ErrorActionPreference = "Stop"' \
            'if (-not (Get-Command tar.exe -ErrorAction SilentlyContinue)) {' \
            '  [Console]::Error.WriteLine("tar.exe is not present in this guest")' \
            "  exit $PUSH_RC_NO_TAR }" \
            "\$dst = $(push_ps_quote "$dst_win")" \
            "\$tmp = Join-Path \$env:TEMP $(push_ps_quote "virutil-push-$$.tar")" \
            'try { New-Item -ItemType Directory -Force -Path $dst | Out-Null }' \
            "catch { [Console]::Error.WriteLine(\$_.Exception.Message); exit $PUSH_RC_MKDIR }" \
            "& curl.exe -fsS --max-time $XFER_HTTP_TIMEOUT -o \$tmp $(push_ps_quote "$XFER_HTTP_URL")" \
            'if ($LASTEXITCODE -ne 0) {' \
            '  Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue' \
            '  exit $LASTEXITCODE }' \
            '& tar.exe -xf $tmp -C $dst' \
            '$rc = $LASTEXITCODE' \
            'Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue' \
            "if (\$rc -ne 0) { exit $PUSH_RC_UNPACK }" \
            '"ok"')
    else
        # A destination that names a directory takes the source's own basename,
        # as rsync would; one that names a file is used as it stands.
        if (( is_dir )); then
            dst_win="C:\\${DST:+${DST//\//\\}\\}$(basename -- "$SRC")"
        else
            dst_win="C:\\${DST//\//\\}"
        fi
        script=$(printf '%s\n' \
            '$ErrorActionPreference = "Stop"' \
            "\$dst = $(push_ps_quote "$dst_win")" \
            '$dir = Split-Path -Parent $dst' \
            'try { if ($dir) { New-Item -ItemType Directory -Force -Path $dir | Out-Null } }' \
            "catch { [Console]::Error.WriteLine(\$_.Exception.Message); exit $PUSH_RC_MKDIR }" \
            "& curl.exe -fsS --max-time $XFER_HTTP_TIMEOUT -o \$dst $(push_ps_quote "$XFER_HTTP_URL")" \
            'if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }' \
            '"$((Get-Item -LiteralPath $dst).Length)"')
    fi

    exec_ps_text "$script"
}

# push_live_die RC HOST -- name what actually went wrong. The guest has already
# printed its own line; this adds the part it cannot know, which is what to do
# about it. Guessing "check your firewall" at every failure trains people to
# ignore the message, so each code that means something specific says so.
push_live_die() {
    local rc="$1" host="$2"
    case "$rc" in
        7|28)
            die "the guest could not reach this host at $host (curl exit $rc)." \
                "The payload was served on that address only. Check that the" \
                "guest's firewall allows outbound connections to it, or drop" \
                "--live to write to the disk image instead." ;;
        23)
            die "the guest fetched the payload but could not write it to the" \
                "destination (curl exit 23) -- the path is locked, in use or" \
                "not writable by SYSTEM. The transfer itself was fine." ;;
        22)
            die "the host's own server refused the request (curl exit 22)." \
                "This is a virutil bug, not a guest problem." ;;
        "$PUSH_RC_UNPACK")
            die "the payload reached the guest but tar.exe could not unpack" \
                "it. Anything already extracted is left where it landed." ;;
        "$PUSH_RC_NO_TAR")
            die "this guest has no tar.exe, which a directory push --live" \
                "needs to unpack the payload (Windows 10 1803 or later has" \
                "it). Push the files one at a time, or drop --live." ;;
        "$PUSH_RC_MKDIR")
            die "the guest could not create the destination directory; its" \
                "own message is above." ;;
        *)
            die "the guest failed to fetch the payload (exit $rc); its own" \
                "error is above." ;;
    esac
}

# --- the live path, over SMB ------------------------------------------------

# push_smb SRC DST -- the SMB twin of push_live. The host exports the payload as
# a read-only share and the running guest pulls it with robocopy, which copies
# only the files that differ from what it already holds -- so a second push of a
# build that changed one file moves one file, where --live would resend the
# whole tar. A file source is served from a one-entry staging directory (robocopy
# and Copy-Item both want a directory to point at, not a bare file over UNC); a
# directory source is served in place, no pack and no copy.
PUSH_RC_ROBO=93             # robocopy returned a failure code (>= 8)

push_smb() {
    local SRC="$1" DST="$2" VM="$DOMAIN"
    local DST_IS_DIR export_dir base ip host rc=0 reported t0 elapsed win_dst

    if [[ "$DST" == */ || "$DST" == *'\' ]]; then DST_IS_DIR=1; else DST_IS_DIR=0; fi
    DST="$(push_norm_dst "$DST")" || exit 1
    # A directory source always lands *in* a directory, as with rsync.
    [[ -d "$SRC" ]] && DST_IS_DIR=1

    ip="$(domain_ip "$DOMAIN")" \
        || die "could not work out $DOMAIN's address, so there is nothing to" \
               "serve the payload to. Check 'virutil domain addr $DOMAIN'."
    host="$(xfer_host_addr "$ip")"
    [[ -n "$host" ]] \
        || die "no route from this host to $DOMAIN at $ip, so the guest has" \
               "no address to fetch from. A guest on an isolated network" \
               "cannot use --smb; drop it to write to the disk image instead."

    # What gets exported. A directory is served where it lies; a file is
    # hardlinked (or, across filesystems, copied) into a scratch directory of
    # its own, so the share carries that one file and none of its siblings.
    if [[ -d "$SRC" ]]; then
        export_dir="$SRC"
    else
        mkdir -p "$VIRUTILS_TMP_DIR" \
            || die "could not create $VIRUTILS_TMP_DIR for the transfer payload"
        XFER_SMB_STAGE="$(mktemp -d "$VIRUTILS_TMP_DIR/smb.XXXXXX")" \
            || die "could not create a staging directory for the transfer"
        base="$(basename -- "$SRC")"
        ln "$SRC" "$XFER_SMB_STAGE/$base" 2>/dev/null \
            || cp -- "$SRC" "$XFER_SMB_STAGE/$base" \
            || die "could not stage $SRC for transfer"
        export_dir="$XFER_SMB_STAGE"
    fi

    xfer_smb_serve "$export_dir" "$host"

    win_dst="${DST//\//\\}"
    (( DST_IS_DIR )) && win_dst="${win_dst:+$win_dst\\}"
    echo "push --smb: $SRC -> C:\\$win_dst"

    t0="$(now_ms)"
    reported="$(push_smb_fetch "$SRC" "$DST" "$DST_IS_DIR")" || rc=$?
    elapsed=$(( $(now_ms) - t0 ))
    (( rc == 0 )) || push_smb_die "$rc" "$host"

    xfer_smb_stop
    push_smb_report "$SRC" "$reported" "$elapsed"
}

# push_smb_fetch SRC DST DST_IS_DIR -- the guest side, one powershell run.
# robocopy for a directory (its whole reason for being: it skips unchanged
# files); Copy-Item for a single file, which robocopy cannot rename onto a new
# name. Both time themselves with a stopwatch so the reported duration is the
# copy alone, without the agent round trip and powershell start-up that the
# host's own wall clock would fold in. robocopy's exit code is a bitmap, not an
# error level: 0 means nothing needed copying, bit 0 means files were copied,
# and only >= 8 is a real failure -- so the usual 'non-zero is bad' is wrong
# here and would call every successful copy an error.
push_smb_fetch() {
    local SRC="$1" DST="$2" is_dir="$3" script dst_win base unc

    if [[ -d "$SRC" ]]; then
        base="$(basename -- "$SRC")"
        # Trailing slash means "contents into DST"; no slash means "DST/<name>",
        # matching rsync and the tar layout the --live path builds.
        if [[ "$SRC" == */ ]]; then
            dst_win="C:\\${DST//\//\\}"
        else
            dst_win="C:\\${DST:+${DST//\//\\}\\}$base"
        fi
        script=$(printf '%s\n' \
            '$ErrorActionPreference = "Stop"' \
            "\$src = $(push_ps_quote "$XFER_SMB_UNC")" \
            "\$dst = $(push_ps_quote "$dst_win")" \
            'try { New-Item -ItemType Directory -Force -Path $dst | Out-Null }' \
            "catch { [Console]::Error.WriteLine(\$_.Exception.Message); exit $PUSH_RC_MKDIR }" \
            '$sw = [Diagnostics.Stopwatch]::StartNew()' \
            '& robocopy $src $dst /E /R:1 /W:1 /NP /NFL /NDL /NJH /NJS | Out-Null' \
            '$rc = $LASTEXITCODE' \
            '$sw.Stop()' \
            "if (\$rc -ge 8) { [Console]::Error.WriteLine(\"robocopy exit \$rc\"); exit $PUSH_RC_ROBO }" \
            '$copied = [int][bool]($rc -band 1)' \
            '$total  = (Get-ChildItem -LiteralPath $dst -Recurse -File).Count' \
            '"$copied $total $([int]$sw.Elapsed.TotalMilliseconds)"')
    else
        base="$(basename -- "$SRC")"
        unc="$XFER_SMB_UNC\\$base"
        if (( is_dir )); then
            dst_win="C:\\${DST:+${DST//\//\\}\\}$base"
        else
            dst_win="C:\\${DST//\//\\}"
        fi
        script=$(printf '%s\n' \
            '$ErrorActionPreference = "Stop"' \
            "\$src = $(push_ps_quote "$unc")" \
            "\$dst = $(push_ps_quote "$dst_win")" \
            '$dir = Split-Path -Parent $dst' \
            'try { if ($dir) { New-Item -ItemType Directory -Force -Path $dir | Out-Null } }' \
            "catch { [Console]::Error.WriteLine(\$_.Exception.Message); exit $PUSH_RC_MKDIR }" \
            '$sw = [Diagnostics.Stopwatch]::StartNew()' \
            'Copy-Item -LiteralPath $src -Destination $dst -Force' \
            '$sw.Stop()' \
            '"$((Get-Item -LiteralPath $dst).Length) $([int]$sw.Elapsed.TotalMilliseconds)"')
    fi

    exec_ps_text "$script"
}

# push_smb_report SRC REPORTED MS -- what landed, and how fast. REPORTED is the
# guest's own line: "copied total ms" from a directory robocopy, or "bytes ms"
# from a file copy. The rate is computed from the guest's stopwatch, not MS,
# for the reason push_live_report gives -- MS holds the round trip too.
push_smb_report() {
    local SRC="$1" reported="$2" ms="$3" rate what
    if [[ -d "$SRC" ]]; then
        local copied total gms
        read -r copied total gms <<<"$reported"
        what="$total file"; (( total == 1 )) || what+="s"
        if (( copied )); then what+=" present (some copied)"; else what+=" present (all up to date)"; fi
        echo "$DOMAIN: $what in $(fmt_duration "${gms:-$ms}")"
    else
        local bytes gms
        read -r bytes gms <<<"$reported"
        rate="$(fmt_rate "$bytes" "${gms:-0}")"
        echo "$DOMAIN: done ($(fmt_bytes "${bytes:-0}")) in $(fmt_duration "${gms:-$ms}")${rate:+ ($rate on the wire)}"
    fi
}

# push_smb_die RC HOST -- name what went wrong; the guest has already printed
# its own line above.
push_smb_die() {
    local rc="$1" host="$2"
    case "$rc" in
        "$PUSH_RC_ROBO")
            die "robocopy could not complete the copy in the guest (its exit" \
                "code is above). Anything it did copy is left where it landed." ;;
        "$PUSH_RC_MKDIR")
            die "the guest could not create the destination directory; its" \
                "own message is above." ;;
        *)
            die "the guest failed to fetch the payload (exit $rc); its own" \
                "error is above. If it could not reach $host, check the" \
                "guest's outbound firewall or drop --smb for the disk image." ;;
    esac
}
