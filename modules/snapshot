# snapshot -- external snapshots for libvirt domains: disk + memory for a
# running domain, disk-only for one that is shut off.
#
# External snapshots are two things at once: a libvirt metadata record, and the
# overlay and memory files on disk that the record names. Deleting the record
# does not delete the files, and libvirt will not delete an external snapshot
# that is both current and has children. Both facts leak disk space if the
# commands here pretend otherwise, so delete accounts for the files explicitly.

DIR="${VIRUTIL_IMAGE_DIR:-$VIRUTILS_IMAGE_DIR}"

snapshot_usage() {
    printf '%s\n' \
        "usage: virutil snapshot create VM [SNAP]  (default name snap-<timestamp>)" \
        "       virutil snapshot list   VM" \
        "       virutil snapshot revert VM SNAP" \
        "       virutil snapshot delete VM SNAP" \
        "" \
        "delete takes SNAP's descendants with it, drops the libvirt records" \
        "without committing disk data, and unlinks the overlay and memory files" \
        "that no surviving record or live domain still reads." \
        "" \
        "A running domain gets a memory snapshot too; a shut-off one cannot," \
        "so its snapshot is disk-only -- the guest boots fresh from the" \
        "disk state on a revert." >&2
    exit "${1:-1}"
}

# snapshot_exists VM SNAP
snapshot_exists() {
    "${VIRSH_Q[@]}" snapshot-info --domain "$1" --snapshotname "$2" >/dev/null 2>&1
}

# snapshot_children VM SNAP -- direct children, one per line. Asked one snapshot
# at a time: `snapshot-list --parent` prints a creation time with spaces in it,
# so its Parent column cannot be read positionally.
snapshot_children() {
    local vm="$1" parent="$2" snap
    while read -r snap; do
        [[ -n "$snap" ]] || continue
        [[ "$("${VIRSH_Q[@]}" snapshot-parent --domain "$vm" \
              --snapshotname "$snap" 2>/dev/null)" == "$parent" ]] \
            && printf '%s\n' "$snap"
    done < <("${VIRSH_Q[@]}" snapshot-list --domain "$vm" --name 2>/dev/null)
    return 0
}

# snapshot_descendants VM SNAP -- SNAP's whole subtree, deepest first, so an
# unlink order that libvirt accepts falls straight out of the list.
snapshot_descendants() {
    local vm="$1" snap="$2" child
    while read -r child; do
        [[ -n "$child" ]] || continue
        snapshot_descendants "$vm" "$child"
        printf '%s\n' "$child"
    done < <(snapshot_children "$vm" "$snap")
}

# snapshot_files VM SNAP -- the external files SNAP's record names: its memory
# image, plus the overlay each disk was switched onto. Read from the record
# while it still exists; once the metadata is gone the names are unrecoverable.
#
# Scoped to <memory> and the <disks> element on purpose. A snapshot record also
# embeds the whole guest config in an inner <domain>, whose <source> elements
# name the *backing* images -- the domain's base disk among them. Collecting
# those would turn a snapshot delete into a delete of the domain's disk, so the
# <disks> bound is load-bearing, not tidiness.
#
# A record written by a create that libvirt had to rename around can carry more
# than one entry for the same disk, so every source is collected, not the first.
# Each line is "mem<TAB>PATH" or "disk<TAB>PATH": a memory image is never part of
# a disk backing chain, so the two kinds are safe to unlink under different
# conditions and the caller has to be able to tell them apart.
snapshot_files() {
    "${VIRSH[@]}" snapshot-dumpxml --domain "$1" --snapshotname "$2" 2>/dev/null \
        | awk '
            /<disks>/    { indisks = 1; next }
            /<\/disks>/  { indisks = 0; next }
            /<domain[ \t>]/ { done = 1 }
            done { next }        # the inner guest config: nothing past here
            !indisks && !/<memory[ \t]/ { next }
            match($0, /file='"'"'[^'"'"']*'"'"'/) {
                s = substr($0, RSTART + 6, RLENGTH - 7)
                if (s != "") printf "%s\t%s\n", (indisks ? "disk" : "mem"), s
            }'
}

# snapshot_paths VM SNAP -- snapshot_files without the kind tag.
snapshot_paths() {
    snapshot_files "$1" "$2" | cut -f2-
}

# snapshot_xml_chain XML DISK -- the backing chain the domain XML already carries
# for the disk whose top image is DISK, deepest entries included, one per line.
# Non-zero if the XML names that disk alone: libvirt records a chain in full or
# not at all, so one source and no <backingStore> means unprobed, not "no
# backing file" -- and the caller has to tell those apart.
snapshot_xml_chain() {
    printf '%s\n' "$1" | awk -v want="$2" '
        /<disk /   { indisk = ($0 ~ /device=.disk./); n = 0; delete chain; next }
        /<\/disk>/ {
            if (indisk && n > 1 && chain[1] == want)
                for (i = 1; i <= n; i++) { print chain[i]; found = 1 }
            indisk = 0; next
        }
        indisk && match($0, /file='"'"'[^'"'"']*'"'"'/) {
            chain[++n] = substr($0, RSTART + 6, RLENGTH - 7) }
        END { exit(found ? 0 : 1) }'
}

# snapshot_record_targets VM SNAP -- the disk targets SNAP's record actually
# snapshotted. A disk the record never knew about -- the transfer share, attached
# long after the snapshot was taken -- must stay out of every set derived from
# that record, and so must the cdroms, which the record lists as snapshot='no'.
snapshot_record_targets() {
    "${VIRSH[@]}" snapshot-dumpxml --domain "$1" --snapshotname "$2" 2>/dev/null \
        | awk '
            /<disks>/    { indisks = 1; next }
            /<\/disks>/  { exit }
            indisks && /snapshot='"'"'external'"'"'/ &&
            match($0, /name='"'"'[^'"'"']*'"'"'/) {
                print substr($0, RSTART + 6, RLENGTH - 7) }'
}

# snapshot_domain_chain XML TARGETS -- every image the disks in TARGETS (space
# separated, trailing space) read in XML: top overlay and backing store both.
snapshot_domain_chain() {
    printf '%s\n' "$1" | awk -v want="$2" '
        /<disk /   { indisk = ($0 ~ /device=.disk./); n = 0; keep = 0; delete c; next }
        /<\/disk>/ {
            if (keep) for (i = 1; i <= n; i++) print c[i]
            indisk = 0; next
        }
        !indisk { next }
        match($0, /file='"'"'[^'"'"']*'"'"'/) {
            c[++n] = substr($0, RSTART + 6, RLENGTH - 7); next }
        /<target / && match($0, /dev='"'"'[^'"'"']*'"'"'/) {
            if (index(want, substr($0, RSTART + 5, RLENGTH - 6) " ")) keep = 1 }'
}

# snapshot_live_files VM -- every file the domain's disk chain reads, so a delete
# can refuse to unlink out from under the guest. Returns non-zero if the chain
# could not be resolved in full; a caller that unlinks on a partial answer would
# delete a live backing file, so the status is not optional.
#
# The domain XML is the source here, not qemu-img: libvirt nests the whole chain
# under each disk as <backingStore>, and virsh answers over the libvirt socket,
# which the libvirt group can read. qemu-img has to open the overlay itself,
# which is 0600 and owned by the qemu user, so it needs root.
snapshot_live_files() {
    local vm="$1" xml disk out rc=0

    xml="$("${VIRSH[@]}" dumpxml "$vm" 2>/dev/null)" || return 1
    [[ -n "$xml" ]] || return 1

    # Bounded to <disk device='disk'> so a cdrom's iso never enters the set, and
    # picking up the nested <backingStore> sources along with the top image.
    printf '%s\n' "$xml" | awk '
        /<disk /   { indisk = ($0 ~ /device=.disk./); next }
        /<\/disk>/ { indisk = 0; next }
        indisk && match($0, /file='"'"'[^'"'"']*'"'"'/) {
            print substr($0, RSTART + 6, RLENGTH - 7) }'

    # A shut-off domain's XML may name the top image alone -- libvirt fills
    # <backingStore> in when it probes the chain, and a domain that has never run
    # under this definition has nothing recorded. Only those disks need qemu-img;
    # asking it about a disk the XML already chained would be a root prompt for
    # an answer we have. When it is needed it is tried as ourselves first and
    # only then under sudo, because the images are 0600 and owned by the qemu
    # user: without the escalation every delete against a shut-off domain
    # reports a partial chain and keeps overlays that nothing reads.
    if [[ "$("${VIRSH[@]}" domstate "$vm" 2>/dev/null)" != running ]]; then
        while read -r disk; do
            [[ -n "$disk" ]] || continue
            snapshot_xml_chain "$xml" "$disk" >/dev/null && continue
            if out="$(qemu-img info --backing-chain -- "$disk" 2>/dev/null)" \
               || { say "chain:  reading $disk needs root" && \
                    out="$("${SUDO[@]}" qemu-img info --backing-chain -- "$disk" \
                           2>/dev/null)"; }
            then
                printf '%s\n' "$out" | awk '/^image: /{ sub(/^image: /, ""); print }'
            else
                rc=1
            fi
        done < <(domain_disks "$vm")
    fi
    return "$rc"
}

# snapshot_backing_files VM SNAP -- the images SNAP's overlays are stacked on:
# the disk sources inside the record's inner <domain>, which is the chain as it
# stood when the snapshot was taken.
#
# The exact set snapshot_files refuses to collect, and for the exact opposite
# reason. Nothing may *unlink* these -- the domain's own base disk is among them.
# But a record whose backing file is gone is a record that cannot be reverted to,
# so anything deciding what is safe to remove has to count them as in use.
#
# It is not a hypothetical: a revert re-points the reverted record onto a fresh
# overlay, and the overlay it drops is routinely the backing file of a *child*
# snapshot's overlay -- named nowhere in that child's <disks>, only here.
snapshot_backing_files() {
    "${VIRSH[@]}" snapshot-dumpxml --domain "$1" --snapshotname "$2" 2>/dev/null \
        | awk '
            /<domain[ \t>]/ { indomain = 1 }
            !indomain  { next }
            /<disk /   { indisk = ($0 ~ /device=.disk./); next }
            /<\/disk>/ { indisk = 0; next }
            indisk && match($0, /file='"'"'[^'"'"']*'"'"'/) {
                print substr($0, RSTART + 6, RLENGTH - 7) }'
}

# snapshot_kept_files VM EXCLUDE... -- every file the records that survive this
# operation still need: the overlays they name, and the images those overlays
# are stacked on. An overlay shared with another snapshot stays, and so does one
# that only a surviving record's backing chain reads.
snapshot_kept_files() {
    local vm="$1"; shift
    local -a skip=("$@")
    local snap s keep
    while read -r snap; do
        [[ -n "$snap" ]] || continue
        keep=1
        for s in ${skip[@]+"${skip[@]}"}; do
            [[ "$snap" == "$s" ]] && { keep=0; break; }
        done
        (( keep )) || continue
        snapshot_paths "$vm" "$snap"
        snapshot_backing_files "$vm" "$snap"
    done < <("${VIRSH_Q[@]}" snapshot-list --domain "$vm" --name 2>/dev/null)
}

# snapshot_clear_clobber VM SNAP FILE... -- make room for a create whose overlay
# names are already taken on disk.
#
# Left over from an earlier delete: libvirt would rename around these the same
# way it renames around a duplicate snapshot name, and the record would come out
# naming two overlays for one disk. What to do about them turns entirely on
# whether anything still reads them, which is a question with an answer -- and
# the wrong answer is the expensive one. A file the domain reads through is
# exactly what a delete leaves behind when it keeps an overlay the guest still
# needs, and telling the user to remove that is telling them to unlink their own
# disk. So: unreferenced ones go, referenced ones are a name collision the user
# has to resolve, and an unreadable chain is neither and stops the create.
snapshot_clear_clobber() {
    local vm="$1" snap="$2"; shift 2
    local LIVE CHAINOK=1 f
    local -A INUSE=()
    local -a BLOCKED=()

    (( $# )) || return 0

    LIVE="$(snapshot_live_files "$vm")" || CHAINOK=0
    (( CHAINOK )) || die \
        "these files are in the way of snapshot '$snap':" \
        "$(printf '  %s\n' "$@")" \
        "The domain's disk chain could not be read in full, so whether anything" \
        "still needs them is unknown. Check them by hand, or pick another name" \
        "for this snapshot."

    while read -r f; do
        [[ -n "$f" ]] || continue
        INUSE["$f"]=1
    done < <(printf '%s\n' "$LIVE"; snapshot_kept_files "$vm")

    for f in "$@"; do
        [[ -n "${INUSE[$f]:-}" ]] && BLOCKED+=("$f")
    done

    (( ${#BLOCKED[@]} )) && die \
        "snapshot '$snap' would be written over a file that is in use:" \
        "$(printf '  %s\n' "${BLOCKED[@]}")" \
        "No record names it, but the domain reads through it or another snapshot" \
        "does -- it is the overlay a delete kept back. Removing it would take the" \
        "disk with it. Pick another name for this snapshot; this one cannot be" \
        "reused while that file is live."

    # Named by nothing and read by nothing: the create is free to have the name
    # back, and a leftover the user cannot act on is not worth stopping for.
    for f in "$@"; do
        domain_rm "$f" || die "could not clear $f out of the way of '$snap'"
    done
}

# snapshot_sweep VM SKIP... -- unlink the files named on stdin, one
# "kind<TAB>PATH" line each as snapshot_files prints them, that nothing still
# reads: not in the domain's disk chain, and not named by any record other than
# the SKIP ones. Non-zero if anything had to be kept.
#
# Shared by delete and revert because the question is the same either way -- a
# file the metadata used to name and does not any more -- and only the reason it
# stopped being named differs. --quiet drops the note about a file kept for being
# in use: a delete was asked about those files by name and is owed the answer,
# while a revert offers up a whole chain speculatively and most of it staying is
# the ordinary outcome, not news.
snapshot_sweep() {
    local quiet=0
    [[ "${1:-}" == --quiet ]] && { quiet=1; shift; }
    local vm="$1"; shift
    local LIVE CHAINOK=1 f kind rc=0
    local -A OWNED=() INUSE=()

    while IFS=$'\t' read -r kind f; do
        [[ -n "$f" ]] || continue
        OWNED["$f"]="$kind"
    done
    (( ${#OWNED[@]} )) || return 0

    # Read now, not before the caller dropped its records: the set that matters
    # is what survives, and an overlay a surviving record shares stays.
    LIVE="$(snapshot_live_files "$vm")" || CHAINOK=0
    while read -r f; do
        [[ -n "$f" ]] || continue
        INUSE["$f"]=1
    done < <(printf '%s\n' "$LIVE"; snapshot_kept_files "$vm" "$@")

    for f in "${!OWNED[@]}"; do
        [[ -e "$f" ]] || continue
        if [[ -n "${INUSE[$f]:-}" ]]; then
            (( quiet )) || warn "kept $f -- still in use"
            continue
        fi
        # An unresolved chain makes that set incomplete, and a disk image
        # missing from it may still be something the guest reads through.
        # Keep every disk image in that case: leaving a file behind costs
        # space, unlinking a live backing file costs the guest.
        if (( ! CHAINOK )) && [[ "${OWNED[$f]}" == disk ]]; then
            warn "kept $f -- could not confirm it is out of the disk chain"
            rc=1
            continue
        fi
        domain_rm "$f" || rc=1
    done
    return "$rc"
}

snapshot_main() {
    local CMD VM SNAP
    CMD="${1:-}"
    [ -n "$CMD" ] || snapshot_usage
    case "$CMD" in -h|--help) snapshot_usage 0 ;; esac
    VM="${2:-}"
    [ -n "$VM" ] || snapshot_usage

    # The commands that unlink root-owned files escalate only that step, exactly
    # as the domain module does.
    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi

    case "$CMD" in
    create)
        SNAP="${3:-snap-$(date +%Y%m%d-%H%M%S)}"

        # A name libvirt already holds is not an overwrite: libvirt keeps the
        # old record, renames the overlay it cannot create to
        # <file>.<timestamp>, and the record ends up naming two overlays for
        # one disk. That state cannot be reverted to and cannot be deleted
        # without --metadata, so refuse it here instead.
        ! snapshot_exists "$VM" "$SNAP" \
            || die "snapshot '$SNAP' already exists on $VM" \
                   "Pick another name, or: virutil snapshot delete $VM $SNAP"

        # Every block device gets a diskspec, not just the disks. A device left
        # out is not a device left alone: libvirt's default for it is an
        # external overlay created *beside its own source*. For a cdrom that
        # means an overlay next to the ISO, and under WSL the ISO lives on a 9p
        # /mnt/c share where libvirt can neither create nor label one -- so the
        # create fails outright, and the ones that get through leave a record
        # whose revert fails on the drive every time it is tried. Naming the
        # drives snapshot='no' is the fix, and it is the same fix whether the
        # domain is running or shut off. Ejecting them was not: a shut-off
        # domain has no tray to open, and a record written with the drives
        # empty is a revert that takes the media away from the guest.
        #
        # Disk targets vary by bus, so ask the domain. The header is skipped off
        # the dashed rule rather than by line count, since a device row must
        # never be read as a header row or the reverse.
        local -a DISKSPECS=() CLOBBER=()
        local dev target file ndisk=0
        mkdir -p "$DIR"
        paths_qemu_warn "$DIR"
        while IFS=$'\t' read -r dev target; do
            [ -n "$target" ] || continue
            if [[ "$dev" == disk ]]; then
                file="$DIR/$VM.$SNAP.$target.qcow2"
                [[ -e "$file" ]] && CLOBBER+=("$file")
                DISKSPECS+=(--diskspec "$target,snapshot=external,file=$file")
                ndisk=$(( ndisk + 1 ))
            else
                DISKSPECS+=(--diskspec "$target,snapshot=no")
            fi
        done < <("${VIRSH[@]}" domblklist "$VM" --details \
                 | awk '!seen   { if ($1 ~ /^--+$/) seen = 1; next }
                        NF >= 3 { printf "%s\t%s\n", $2, $3 }')
        (( ndisk )) || {
            echo "no disks found for domain '$VM'" >&2
            exit 1
        }
        [[ -e "$DIR/$VM.$SNAP.mem" ]] && CLOBBER+=("$DIR/$VM.$SNAP.mem")

        snapshot_clear_clobber "$VM" "$SNAP" ${CLOBBER[@]+"${CLOBBER[@]}"}

        # A shut-off domain has no memory to save, and libvirt refuses the
        # memspec for one outright, so a non-running domain takes a disk-only
        # snapshot. Revert still works -- with no memory to restore the guest
        # just boots fresh from the disk state.
        local -a MEMSPEC=()
        if xfer_running "$VM"; then
            MEMSPEC=(--memspec "$DIR/$VM.$SNAP.mem,snapshot=external")
        else
            say "shut off: disk-only snapshot (no memory image)"
        fi

        local rc=0
        "${VIRSH[@]}" snapshot-create-as \
            --domain "$VM" \
            --name "$SNAP" \
            "${MEMSPEC[@]}" \
            "${DISKSPECS[@]}" \
            --atomic || rc=$?

        (( rc )) && die "could not create snapshot '$SNAP' on $VM"
        echo "created: $SNAP"
        ;;
    list)
        "${VIRSH[@]}" snapshot-list --domain "$VM" --tree
        ;;
    revert)
        SNAP="${3:?usage: virutil snapshot revert VM_NAME SNAP_NAME}"
        # A revert restores the configuration stored in the record, devices
        # included -- so what the domain gets back is what it had when the
        # snapshot was taken. The create leaves the removable drives loaded and
        # marks them snapshot='no', so the media comes back with it; a record
        # written with the drives empty would take them away from the guest
        # here, and from the guest's own memory image, which was captured with
        # them present.

        # A revert does not reuse the overlay the record names: libvirt builds a
        # fresh one per disk beside the base and rewrites the record onto it. Two
        # kinds of file are left with nothing pointing at them afterwards, and
        # both have to be named now -- a moment later the metadata that named
        # them is gone and they are unrecoverable:
        #
        #   the overlay the record dropped    what the revert replaced
        #   the chain the domain was reading  overlays of the branch being left,
        #                                     including ones whose record was
        #                                     already deleted while the domain
        #                                     still read through them -- the case
        #                                     delete can only warn about
        #
        # Both are candidates, not conclusions: what survives the sweep's in-use
        # test is what actually goes. Scoped to the targets the record covers, so
        # a disk attached since -- the transfer share -- is never a candidate.
        local -a WAS=()
        local line kind f tgt targets="" xml
        while read -r tgt; do
            [[ -n "$tgt" ]] || continue
            targets+="$tgt "
        done < <(snapshot_record_targets "$VM" "$SNAP")

        while IFS=$'\t' read -r kind f; do
            [[ -n "$f" ]] || continue
            WAS+=("$kind"$'\t'"$f")
        done < <(snapshot_files "$VM" "$SNAP")

        if [[ -n "$targets" ]] && xml="$("${VIRSH[@]}" dumpxml "$VM" 2>/dev/null)"; then
            while read -r f; do
                [[ -n "$f" ]] || continue
                WAS+=($'disk\t'"$f")
            done < <(snapshot_domain_chain "$xml" "$targets")
        fi

        "${VIRSH[@]}" snapshot-revert --domain "$VM" --snapshotname "$SNAP" --running
        echo "reverted: $SNAP"

        # Only what the record stopped naming. Everything it still names is in
        # use by definition, and feeding those to the sweep would be a warning
        # about a file doing its job, on every single revert.
        local -A NOW=()
        while IFS=$'\t' read -r kind f; do
            [[ -n "$f" ]] || continue
            NOW["$f"]=1
        done < <(snapshot_files "$VM" "$SNAP")

        for line in ${WAS[@]+"${WAS[@]}"}; do
            f="${line#*$'\t'}"
            [[ -n "${NOW[$f]:-}" ]] || printf '%s\n' "$line"
        done | snapshot_sweep --quiet "$VM" \
            || warn "some files the revert replaced were left behind"

        # A guest reverted here wakes with the clock it had when the snapshot
        # was taken, and nothing in virutil sets it: the copiers compare
        # timestamps for equality, not for which side is newer, so the skew
        # costs a transfer nothing. Guest-side tooling is another matter --
        # 'virsh domtime VM --now' is the fix when it matters.
        ;;
    delete)
        SNAP="${3:?usage: virutil snapshot delete VM_NAME SNAP_NAME}"

        snapshot_exists "$VM" "$SNAP" || die "no such snapshot on $VM: $SNAP"

        # Deepest first, and spelled out here rather than handed to virsh's
        # --children: libvirt only ever accepts a leaf, and every record removed
        # has to be walked anyway to collect the files it names.
        local -a TARGETS=()
        local s
        while read -r s; do
            [[ -n "$s" ]] || continue
            TARGETS+=("$s")
        done < <(snapshot_descendants "$VM" "$SNAP")
        TARGETS+=("$SNAP")

        (( ${#TARGETS[@]} > 1 )) \
            && say "taking ${#TARGETS[@]} records: ${TARGETS[*]}"

        # Collected before anything is deleted -- the record is the only place
        # these names exist.
        local -a FILES=()
        local f kind
        for s in "${TARGETS[@]}"; do
            while IFS=$'\t' read -r kind f; do
                [[ -n "$f" ]] || continue
                FILES+=("$kind"$'\t'"$f")
            done < <(snapshot_files "$VM" "$s")
        done

        # --metadata unconditionally. Without it libvirt tries to commit the
        # overlay into its backing file, which it refuses outright for a snapshot
        # that is both current and has children -- the one case a delete most
        # needs to work. Dropping the record discards that overlay's data rather
        # than merging it, which is the trade a revert point is for: the state
        # worth keeping is the one already committed under it.
        for s in "${TARGETS[@]}"; do
            "${VIRSH[@]}" snapshot-delete --domain "$VM" \
                --snapshotname "$s" --metadata \
                || die "could not delete the record for '$s'"
            say "deleted: $s"
        done

        local rc=0
        printf '%s\n' ${FILES[@]+"${FILES[@]}"} \
            | snapshot_sweep "$VM" "${TARGETS[@]}" || rc=1
        (( rc )) && warn "some files were left behind; re-run once the domain is" \
                         "running, or remove them by hand"
        return "$rc"
        ;;
    *)
        snapshot_usage
        ;;
    esac
}
