# guest -- the offline attach lifecycle, plus the helpers every module shares.
#
# guest_open() shuts a running guest down, attaches its qcow2 with qemu-nbd,
# mounts the largest NTFS partition at MNT and arms guest_finish() as the EXIT
# trap, which unmounts, detaches and starts the guest again if it was running.
#
# State lives at module scope: the trap runs after a main has returned and
# set -u must not trip on it.

RSYNC=(rsync -rlt --mkpath --info=progress2 --no-perms --no-owner --no-group)

# Arrays, not strings: an unquoted expansion would word-split on a path.
VIRSH=(virsh --connect qemu:///system)
VIRSH_Q=("${VIRSH[@]}" --quiet)
SUDO=()

DOMAIN=""; NBD="/dev/nbd0"; MNT=""
SHUTDOWN_TIMEOUT=180                 # seconds to wait for a graceful shutdown
ORIG_STATE=""                        # the domain's state before guest_open
IMG=""

# Rewrite every letter as [Aa] so a path matches case-insensitively. nocaseglob
# is not enough: bash never glob-expands a word with no wildcard in it.
ci_glob() {
    local s="$1" out="" c i
    for (( i = 0; i < ${#s}; i++ )); do
        c="${s:i:1}"
        if [[ "$c" == [A-Za-z] ]]; then out+="[${c^^}${c,,}]"; else out+="$c"; fi
    done
    printf '%s' "$out"
}

# '.' spells "the root of this tree", but must not reach rsync: --mkpath takes
# the EEXIST on a literal '.' as fatal ("mkdir ..././ failed: File exists").
root_rel() { local s="$1"; [[ "$s" == "." ]] && s=""; printf '%s' "$s"; }

# --- numbers a person can read ----------------------------------------------
#
# These exist because a log line is read by someone deciding whether a transfer
# is going well, and "50000000 bytes" does not answer that question as fast as
# "47.7 MiB" does. Binary units throughout, to match what Windows will report
# for the same file once it lands.

# fmt_bytes N -- a byte count. Whole bytes below a kibibyte, one decimal above:
# a second decimal on a file size is noise nobody acts on.
fmt_bytes() {
    awk -v b="${1:-0}" 'BEGIN {
        split("B KiB MiB GiB TiB", u, " ")
        i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i]
    }'
}

# fmt_duration MS -- a wall-clock interval. Sub-second runs are the common case
# here and read better in milliseconds than as "0.0s".
fmt_duration() {
    awk -v ms="${1:-0}" 'BEGIN {
        if      (ms <  1000) printf "%dms", ms
        else if (ms < 60000) printf "%.1fs", ms / 1000
        else                 printf "%dm%02ds", int(ms / 60000), int(ms % 60000 / 1000)
    }'
}

# fmt_rate BYTES MS -- throughput over that interval. Prints nothing when the
# interval is too short to divide by, rather than a number invented from a
# rounding artefact.
fmt_rate() {
    local ms="${2:-0}"
    (( ms > 0 )) || return 0
    awk -v b="${1:-0}" -v ms="$ms" 'BEGIN {
        r = b * 1000 / ms
        split("B KiB MiB GiB", u, " ")
        i = 1
        while (r >= 1024 && i < 4) { r /= 1024; i++ }
        printf "%.1f %s/s", r, u[i]
    }'
}

# now_ms -- a monotonic-enough clock for timing one transfer.
now_ms() { printf '%s' "$(( $(date +%s%N) / 1000000 ))"; }

# --- the guest clock --------------------------------------------------------
#
# A guest's clock stops whenever the guest is not running, and a reverted
# snapshot restores memory whose clock stopped when the snapshot was taken: the
# guest wakes up however long ago that was. Nothing inside fixes it promptly.
# Windows would use the hypervisor's own time provider, but that is a Hyper-V
# device KVM does not present, so all that is left is w32tm, which resyncs
# against a time server on a schedule of its own -- an hour or more after the
# damage is done, and never at all on a guest with no route to one.
#
# The damage is not cosmetic here: timestamps are what every copy in this tool
# compares. rsync and robocopy both skip a file whose destination looks no older
# than the source, so a guest running ahead of the host turns a transfer into a
# silent no-op, and one running behind makes the next transfer back out stale.
# So the clock is set at the two points drift appears -- after a revert, and
# before a transfer -- rather than left for the guest to notice.

TIME_SYNC_WAIT="${VIRUTIL_TIME_SYNC_WAIT:-60}"  # agent wait after a revert
TIME_SKEW_MAX=2                                 # seconds; below this, in step

# guest_agent_wait VM [SECS] -- true once the agent answers. guest-ping, not the
# channel state: the channel reads 'connected' with nothing listening behind it.
guest_agent_wait() {
    local vm="$1" secs="${2:-0}" i
    for (( i = 0; ; i++ )); do
        "${VIRSH[@]}" qemu-agent-command "$vm" '{"execute":"guest-ping"}' \
            >/dev/null 2>&1 && return 0
        (( i >= secs )) && return 1
        sleep 1
    done
}

# guest_time VM -- the guest's clock, in seconds since the epoch, or nothing.
guest_time() {
    "${VIRSH[@]}" domtime "$1" 2>/dev/null \
        | awk -F'[: \t]+' '/[Tt]ime:/ && !found { print $2; found=1 }'
}

# guest_time_sync VM [WAIT] -- put the guest's clock on the host's, through the
# agent. Advisory: a guest that cannot be reached is reported and the caller
# carries on, since every caller has real work that is worth doing anyway.
# VIRUTIL_TIME_SYNC=0 turns it off.
guest_time_sync() {
    local vm="$1" wait="${2:-0}" before now skew

    [[ "${VIRUTIL_TIME_SYNC:-1}" == 0 ]] && return 0

    # A domain with no agent channel has no agent to wait for -- waiting the
    # full timeout on every revert of such a guest would be a minute of nothing.
    if ! "${VIRSH[@]}" dumpxml "$vm" 2>/dev/null \
         | awk '/org.qemu.guest_agent/ {found=1} END {exit !found}'; then
        warn "clock not synced: $vm has no qemu-guest-agent channel, so nothing" \
             "can set its clock from here. A domain from 'virutil domain create'" \
             "has one; an older one needs it cold-plugged."
        return 0
    fi

    if ! guest_agent_wait "$vm" "$wait"; then
        local waited=""
        (( wait )) && waited=" after ${wait}s"
        warn "clock not synced: the qemu guest agent in $vm is not answering$waited." \
             "Install the guest-agent MSI from the virtio-win ISO (see the guest" \
             "prerequisites in README.md), or set VIRUTIL_TIME_SYNC=0 to stop trying."
        return 0
    fi

    before="$(guest_time "$vm")"
    now="$(date +%s)"

    # An agent that answers guest-ping may still not implement guest-get-time;
    # an unknown skew is a reason to set the clock, not to skip it.
    if [[ "$before" =~ ^[0-9]+$ ]]; then
        skew=$(( before - now ))
        (( skew < 0 )) && skew=$(( -skew ))
        (( skew <= TIME_SKEW_MAX )) && return 0
    fi

    # --now, not --sync: --sync re-reads the emulated RTC, whose offset a
    # Windows guest reads as local time, so it only ever restores the same
    # answer the guest already had. --now hands the agent the host's clock.
    if "${VIRSH[@]}" domtime "$vm" --now >/dev/null 2>&1; then
        if [[ -n "${skew:-}" ]]; then
            say "clock: $vm was ${skew}s $( (( before > now )) && echo ahead || echo behind ) -> synced to the host"
        else
            say "clock: $vm synced to the host"
        fi
    else
        warn "could not set the clock in $vm (virsh domtime --now failed);" \
             "file timestamps there may not compare against the host's"
    fi
    return 0
}

# Verified from observed state, not exit codes. Both probes are world-readable,
# so verification cannot itself fail on sudo auth.
nbd_attached() {
    local sys="/sys/block/${NBD##*/}"
    [[ -e "$sys/pid" ]] && return 0
    [[ -r "$sys/size" ]] && (( $(< "$sys/size") > 0 ))
}
mnt_mounted() {
    awk -v m="$MNT" '$2 == m { found = 1 } END { exit !found }' /proc/mounts
}

# ntfs-3g does not fail a read-write mount on a dirty volume: it warns, mounts
# read-only and exits 0. Field 4 of /proc/mounts leads with the ro/rw flag.
mnt_writable() {
    awk -v m="$MNT" '$2 == m { split($4, o, ","); if (o[1] == "rw") found = 1 }
                     END { exit !found }' /proc/mounts
}

# guest_state_check -- the disk transport can work on a guest that is shut off
# and on one that is running (it is shut down by guest_open and started again
# by the EXIT trap). What it cannot touch is paused or pmsuspended RAM, which
# would no longer match the disk being edited. Sets ORIG_STATE.
guest_state_check() {
    ORIG_STATE="$("${VIRSH[@]}" domstate "$DOMAIN" 2>/dev/null || true)"
    [[ -n "$ORIG_STATE" ]] || die "could not read the state of $DOMAIN"
    echo "domain: $DOMAIN ($ORIG_STATE)"

    case "$ORIG_STATE" in
        running|"shut off") ;;
        *)  # paused / pmsuspended: their RAM would no longer match the disk.
            die "$DOMAIN is '$ORIG_STATE'; its RAM no longer matches the disk," \
                "so it cannot be shut down and started again around a write." \
                "Shut it down by hand (or destroy it) and run this again."
            ;;
    esac
}

guest_finish() {
    # No step may abort the handler under set -e.
    if mnt_mounted; then
        sync
        "${SUDO[@]}" umount "$MNT" || true
    fi
    if nbd_attached; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
    fi
    sync

    # Verified from observed state, not the exit codes above: two writers on one
    # qcow2 is the failure this module must never cause, and a guest started
    # while the image is still attached would be exactly that.
    if mnt_mounted || nbd_attached; then
        warn "" \
             "teardown could not be verified -- do not start $DOMAIN yet." \
             "Starting it while ${IMG:-its disk} is still attached would put" \
             "two writers on the image. Recover by hand:" \
             "  sudo umount $MNT" \
             "  sudo qemu-nbd -d $NBD" \
             "  virsh --connect qemu:///system start $DOMAIN"
        exit 1
    fi

    # The restart is gated on observed state, not intent: only start what is
    # actually off. A run that aborted on a guest that would not shut down
    # reaches here with the domain still running, and must not start it again.
    if [[ "$ORIG_STATE" == running ]]; then
        local now
        now="$("${VIRSH[@]}" domstate "$DOMAIN" 2>/dev/null || true)"
        if [[ "$now" == "shut off" ]]; then
            echo "restoring $DOMAIN to running"
            "${VIRSH[@]}" start "$DOMAIN" >/dev/null \
                || warn "failed to restart $DOMAIN -- start it manually"
        elif [[ -z "$now" ]]; then
            warn "could not read the state of $DOMAIN -- it was running when" \
                 "this started; check it and start it manually if needed"
        fi
    fi
}

# guest_open -- requires DOMAIN (and optionally NBD, MNT, SHUTDOWN_TIMEOUT) from
# the caller; sets ORIG_STATE and IMG, shuts a running guest down, and mounts
# the guest filesystem at MNT.
guest_open() {

    xfer_privilege

    MNT="${MNT:-$(virutils_mnt "$DOMAIN")}"
    command -v rsync >/dev/null || die "rsync not installed"

    # The state of the guest decides whether this can happen at all, so it is
    # settled before the password prompt.
    guest_state_check

    # Authenticate up front rather than partway through the attach.
    if (( ${#SUDO[@]} )); then
        command -v sudo >/dev/null || die "sudo not installed; nbd and mount need it"
        sudo -v || die "sudo authentication failed"
    fi

    # A stale nbd or mount left by a failed run is not ours to tear down.
    nbd_attached && die "$NBD is already attached; free it or set @nbd elsewhere" \
                        "  sudo qemu-nbd -d $NBD"
    mnt_mounted && die "$MNT is already mounted; unmount it first" \
                       "  sudo umount $MNT"

    # A managed-save image means the guest resumes from stale RAM, whose cached
    # NTFS metadata would not match the disk we are about to edit.
    "${VIRSH[@]}" dominfo "$DOMAIN" \
        | awk '/^[Mm]anaged [Ss]ave: *[Yy]es/ {found=1} END {exit !found}' \
        && die "$DOMAIN has a managed-save image; resuming it after editing the disk" \
               "would corrupt the filesystem. Run: virsh managedsave-remove $DOMAIN"

    trap guest_finish EXIT

    if [[ "$ORIG_STATE" == running ]]; then
        # Prefer the agent: ACPI is a power-button event Windows is free to
        # deliberate over -- a modal dialog or "an app is preventing shutdown"
        # and the wait runs to the full timeout. The agent calls Windows' own
        # shutdown with applications forced closed, which usually takes seconds,
        # and it is still a real shutdown: Windows closes the NTFS volume, so
        # the disk is left clean.
        local mode=acpi
        if "${VIRSH[@]}" qemu-agent-command "$DOMAIN" \
               '{"execute":"guest-ping"}' >/dev/null 2>&1; then
            mode=agent
        else
            warn "   qemu-guest-agent is not answering; falling back to ACPI." \
                 "Installing it in the guest makes this shutdown much faster" \
                 "-- see the README note on guest shutdown."
        fi

        echo "   shutting down (--mode $mode, up to ${SHUTDOWN_TIMEOUT}s)..."
        "${VIRSH[@]}" shutdown --mode "$mode" "$DOMAIN" >/dev/null
        local state="$ORIG_STATE"
        for (( i = 0; i < SHUTDOWN_TIMEOUT; i++ )); do
            state="$("${VIRSH[@]}" domstate "$DOMAIN" 2>/dev/null || true)"
            [[ "$state" == "shut off" ]] && break
            # A silent wait of up to @shutdown_timeout looks like a hang.
            (( i > 0 && i % 15 == 0 )) \
                && echo "   still '$state' after ${i}s of ${SHUTDOWN_TIMEOUT}s" \
                        "-- check the guest console for a dialog blocking shutdown"
            sleep 1
        done

        # No destroy fallback: cutting power leaves the NTFS volume dirty, which
        # ntfs-3g then refuses to mount read-write. The guest stays running; the
        # EXIT trap sees it still running and does not start it again.
        [[ "$state" == "shut off" ]] \
            || die "$DOMAIN did not shut down within ${SHUTDOWN_TIMEOUT}s (still '$state')." \
                   "Nothing was written and the guest is left running." \
                   "Check its console for a dialog blocking shutdown, or raise" \
                   "@shutdown_timeout. If you must force it, run" \
                   "'virsh --connect qemu:///system destroy $DOMAIN' yourself and" \
                   "expect to boot Windows once to clear the dirty NTFS volume."
        echo "   shut off"
    fi

    # Top of the backing chain: writing to the base would corrupt the guest.
    IMG="$("${VIRSH[@]}" domblklist "$DOMAIN" --details \
           | awk '$2=="disk" && !found {print $4; found=1}')"
    [[ -f "$IMG" ]] || die "could not resolve disk image for $DOMAIN"
    echo "image: $IMG"

    nbd_connect "$IMG"

    local PART; PART="$(nbd_find_part ntfs)"
    if [[ -z "$PART" ]]; then
        lsblk -o NAME,SIZE,FSTYPE,PARTTYPENAME "$NBD" >&2 || true
        die "no NTFS partition found on $NBD (layout above)"
    fi
    echo "partition: $PART ($(nbd_part_size "$PART") GiB)"

    "${SUDO[@]}" mkdir -p "$MNT"

    # uid=/gid= hand the tree over, so the copy phase needs no privilege.
    "${SUDO[@]}" mount -t ntfs-3g -o "uid=$(id -u),gid=$(id -g)" "$PART" "$MNT"

    # Stop here rather than let the copy phase discover it file by file.
    mnt_writable || die \
        "$PART mounted read-only: the NTFS volume is dirty, so ntfs-3g refused" \
        "read-write (it warns and falls back rather than failing the mount)." \
        "Nothing was written. Usually this means the guest was powered off" \
        "abruptly, or Fast Startup is still enabled in it. Boot the guest, let" \
        "Windows check the volume, shut it down fully, then run this again."
}
