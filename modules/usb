# usb -- USB passthrough for libvirt VMs, end to end from the Windows host under
# WSL. Sourced by virutil; entry point is usb_main. Usage:
#   virutil usb list                       list host USB devices and sharing state
#   virutil usb show      VM               show devices passed to VM, live and persistent
#   virutil usb attach    VM BUSID         share on Windows, import into WSL, hand to the VM
#   virutil usb detach    VM BUSID         take it out of the VM and give it back to Windows
#   virutil usb unbind    BUSID            stop sharing the device on Windows (needs UAC)
#
# A device is named by the BUSID in the first column of `virutil usb list`, the same
# handle usbipd itself takes. libvirt hostdevs are written in terms of vendor/product,
# so the busid is resolved to a VENDOR:PRODUCT once, up front, and the libvirt and
# sysfs stages work from that.
#
# attach crosses three layers: usbipd bind on Windows, usbipd attach --wsl to import
# the device over vhci_hcd, then virsh attach-device. Every stage is skipped when
# `usbipd state` says it is already done, so rerunning after a failure is safe.
#
# Only bind and unbind need Administrator, and a bind is persistent, so expect one
# UAC prompt per physical device ever. detach deliberately stops short of unbinding:
# a bound but detached device is still usable in Windows, so unbinding would spend a
# UAC prompt to discard the state the bind just paid for.

USBIPD="/mnt/c/Program Files/usbipd-win/usbipd.exe"
USBIPD_WIN='C:\Program Files\usbipd-win\usbipd.exe'
DISTRO=archlinux

usb_usage() {
    echo "usage: virutil usb {list|show|attach|detach|unbind} [VM] [BUSID]" >&2
    exit 1
}

# A busid identifies a port, so it is only meaningful while something is plugged into
# it. A VENDOR:PRODUCT is therefore also accepted: it is the only way to name a device
# that has already been unplugged, which detach still needs in order to clear the
# persistent hostdev it left behind. sysfs and the libvirt XML both want lowercase hex.
read_dev() {
    if [[ $1 =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]]; then
        echo "$1"
    elif [[ $1 =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]]; then
        echo "${1,,}"
    else
        die "expected a BUSID (e.g. 3-3, see: virutil usb list), got '$1'"
    fi
}

# usbipd's view of one device, looked up by busid or by hardware id, as
# VendProd|BusId|StubInstanceId|PersistedGuid|ClientIPAddress, or the words none/many.
# The hardware id only appears in InstanceId, which reads USB\VID_0951&PID_1666\<serial>.
usbipd_state() {
    local busid="" key=""
    case "$1" in
    *:*) key=$(printf 'VID_%s&PID_%s' "${1%:*}" "${1#*:}" | tr 'a-f' 'A-F') ;;
    *) busid="$1" ;;
    esac
    "$USBIPD" state | tr -d '\r' | jq -r --arg busid "$busid" --arg key "$key" '
        def vendprod: [.InstanceId | scan("(?i)VID_([0-9a-f]{4})&PID_([0-9a-f]{4})")]
                      | if length > 0 then (.[0] | join(":") | ascii_downcase)
                        else "" end;
        [ .Devices[]
          | select(if $busid != "" then .BusId == $busid
                   else (.InstanceId | ascii_upcase) | contains($key) end) ]
        | if length == 0 then "none"
          elif length > 1 then "many"
          else .[0] | [vendprod, (.BusId // ""), (.StubInstanceId // ""),
                       (.PersistedGuid // ""), (.ClientIPAddress // "")] | join("|")
          end'
}

# a busid lookup is exact, so only a hardware id can be ambiguous
resolve_dev() {
    STATE=$(usbipd_state "$1")
    case "$STATE" in
    none) die "no connected USB device at $1 (see: virutil usb list)" ;;
    many) die "several connected devices share hardware id $1; unplug one" ;;
    esac
    IFS='|' read -r ID BUSID STUB GUID CLIENT <<<"$STATE"
    [ -n "$ID" ] || die "could not read the vendor:product of $1 from usbipd state"
}

# the address usbipd attaches us as; virbr0 has one too, so pin to eth0
wsl_ip() { ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1; }

# bind and unbind always need Administrator, so go straight through UAC rather than
# spending a doomed call first. Start-Process discards the child's exit code, so
# callers confirm the outcome by rereading usbipd state instead of trusting this.
elevate() {
    local args="'$1'"
    shift
    local a
    for a in "$@"; do args="$args,'$a'"; done
    powershell.exe -NoProfile -Command \
        "Start-Process -FilePath '$USBIPD_WIN' -ArgumentList $args -Verb RunAs -Wait" \
        >/dev/null 2>&1 || true
}

in_sysfs() {
    local d
    # root hubs live at /sys/bus/usb/devices/usbN and are skipped by the glob
    for d in /sys/bus/usb/devices/[0-9]*-[0-9]*/; do
        [ -r "$d/idVendor" ] || continue
        [ "$(cat "$d/idVendor"):$(cat "$d/idProduct")" = "$1" ] && return 0
    done
    return 1
}

# libvirt resolves a managed hostdev by looking the device up on the host, so the
# import has to finish enumerating before virsh sees it; without this wait the race
# surfaces as a libvirt error blaming the VM layer
wait_sysfs() {
    local i
    for i in $(seq 25); do
        in_sysfs "$1" && return 0
        sleep 0.2
    done
    return 1
}

domstate() { "${VIRSH[@]}" domstate "$VM" 2>/dev/null | head -1; }

# checked before anything else touches Windows, so a mistyped VM name cannot cost a
# UAC prompt first and then fail at the last stage
require_domain() {
    "${VIRSH[@]}" domstate "$VM" >/dev/null 2>&1 ||
        die "no such VM: $VM (see: virsh -c qemu:///system list --all)"
}

# startupPolicy only matters while a domain starts, so it belongs in persistent
# config and is left out of a live attach. Without it a persisted hostdev whose
# device is unplugged can stop the VM from booting at all.
hostdev_xml() {
    cat <<EOF
<hostdev mode='subsystem' type='usb' managed='yes'>
  <source${2:-}>
    <vendor id='0x${1%:*}'/>
    <product id='0x${1#*:}'/>
  </source>
</hostdev>
EOF
}

hostdevs() { "${VIRSH[@]}" dumpxml "$@" | sed -n '/<hostdev/,/<\/hostdev>/p'; }

# libvirt has no idempotent attach-device, so the last stage needs the same gate as
# the usbipd ones or a rerun after a partial failure dies on the device it already
# added. libvirt always emits <vendor> before <product>, so pairing successive ids
# reconstructs the VENDOR:PRODUCT of each usb hostdev.
has_hostdev() {
    hostdevs "$@" |
        sed -n "s/.*<\(vendor\|product\) id='0x\([0-9a-f]*\)'.*/\2/p" |
        paste -d: - - | grep -qx "$ID"
}

# a device can sit in the live domain, in the persistent config, or both, so each is
# tried on its own. Only "not found" is tolerated; anything else is a real failure
# and must not be mistaken for a clean detach.
detach_scope() {
    local scope="$1" out
    if out=$(hostdev_xml "$ID" | "${VIRSH[@]}" detach-device "$VM" "$scope" /dev/stdin 2>&1); then
        say "libvirt: removed from $scope"
        return 0
    fi
    case "$out" in
    *"not found"* | *"Not found"*) return 1 ;;
    esac
    die "$out"
}

usb_main() {
    local CMD VM DEV ID STATE BUSID STUB GUID CLIENT REMOVED
    CMD="${1:-}"
    [ -n "$CMD" ] || usb_usage

    case "$CMD" in
    list)
        "$USBIPD" list | tr -d '\r'
        ;;
    show)
        VM="${2:?usage: virutil usb show VM}"
        # the two views can disagree now that attach writes persistent config, and a
        # persisted hostdev that is not live is exactly the one that surprises you at
        # the next boot, so never show one without the other
        echo "=== live ==="
        hostdevs "$VM"
        echo "=== persistent ==="
        hostdevs --inactive "$VM"
        ;;
    attach)
        VM="${2:?usage: virutil usb attach VM BUSID}"
        DEV=$(read_dev "${3:?usage: virutil usb attach VM BUSID}")
        require_domain
        resolve_dev "$DEV"

        if [ -n "$STUB$GUID" ]; then
            say "bind: $BUSID ($ID) already shared, skipping"
        else
            say "bind: sharing $BUSID ($ID) on the Windows host, expect a UAC prompt"
            elevate bind -b "$BUSID"
            IFS='|' read -r ID BUSID STUB GUID CLIENT <<<"$(usbipd_state "$BUSID")"
            [ -n "$STUB$GUID" ] || die "bind did not take effect; was the UAC prompt declined?"
        fi

        IP=$(wsl_ip)
        if [ -n "$CLIENT" ]; then
            [ "$CLIENT" = "$IP" ] ||
                die "$BUSID is attached to $CLIENT, not to this WSL instance ($IP)"
            say "wsl: $BUSID already attached here, skipping"
        else
            say "wsl: importing $BUSID ($ID) into $DISTRO"
            "$USBIPD" attach --wsl "$DISTRO" -b "$BUSID"
        fi

        wait_sysfs "$ID" || die "$ID never appeared in WSL; the usbipd import did not land"

        if [ "$(domstate)" = running ]; then
            if has_hostdev "$VM"; then
                say "libvirt: $ID is already attached to $VM, skipping"
            else
                say "libvirt: attaching to $VM (live)"
                hostdev_xml "$ID" | "${VIRSH[@]}" attach-device "$VM" --live /dev/stdin
            fi
        elif has_hostdev --inactive "$VM"; then
            say "libvirt: $ID is already in $VM's persistent config, skipping"
        else
            say "libvirt: $VM is not running, attaching to its persistent config"
            hostdev_xml "$ID" " startupPolicy='optional'" |
                "${VIRSH[@]}" attach-device "$VM" --config /dev/stdin
        fi
        ;;
    detach)
        VM="${2:?usage: virutil usb detach VM BUSID}"
        DEV=$(read_dev "${3:?usage: virutil usb detach VM BUSID}")
        require_domain

        # libvirt wrote the hostdev in terms of vendor/product, so a busid has to be
        # resolved before anything can be removed. A device that is already gone from
        # the host cannot be resolved, and its persistent hostdev is exactly the one
        # still worth removing, so in that case the argument has to name it directly.
        STATE=$(usbipd_state "$DEV")
        case "$STATE" in
        many) die "several connected devices share hardware id $DEV; unplug one" ;;
        none)
            case "$DEV" in
            *:*) ID="$DEV" ;;
            *) die "nothing is connected at busid $DEV; name the device as VENDOR:PRODUCT to remove a leftover hostdev (see: virutil usb show $VM)" ;;
            esac
            ;;
        *) IFS='|' read -r ID BUSID STUB GUID CLIENT <<<"$STATE" ;;
        esac

        REMOVED=0
        if [ "$(domstate)" = running ]; then
            if detach_scope --live; then REMOVED=1; fi
        fi
        if detach_scope --config; then REMOVED=1; fi
        [ "$REMOVED" = 1 ] || die "$VM has no hostdev for $ID, live or persistent"

        # leaves the device bound: still usable in Windows, and ready for a prompt-free
        # reattach later. Use `virutil usb unbind` to stop sharing it altogether.
        # Removing the hostdev only rebinds the driver inside WSL, so the client
        # attachment read above still holds.
        if [ -n "${CLIENT:-}" ]; then
            say "wsl: returning $BUSID ($ID) to the Windows host"
            "$USBIPD" detach -b "$BUSID"
        fi
        ;;
    unbind)
        DEV=$(read_dev "${2:?usage: virutil usb unbind BUSID}")
        resolve_dev "$DEV"

        if [ -z "$STUB$GUID" ]; then
            say "unbind: $BUSID ($ID) is not shared, nothing to do"
        else
            say "unbind: unsharing $BUSID ($ID), expect a UAC prompt"
            elevate unbind -b "$BUSID"
            IFS='|' read -r ID BUSID STUB GUID CLIENT <<<"$(usbipd_state "$DEV")"
            [ -z "$STUB$GUID" ] || die "unbind did not take effect; was the UAC prompt declined?"
        fi
        ;;
    *)
        usb_usage
        ;;
    esac
}
