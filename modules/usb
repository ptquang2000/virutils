# usb -- USB passthrough for libvirt domains, end to end from the Windows host
# under WSL: usbipd bind, usbipd attach --wsl over vhci_hcd, virsh attach-device.
# Every stage is skipped when `usbipd state` says it is already done, so
# rerunning after a failure is safe.
#
# Only bind and unbind need Administrator, and a bind is persistent, so expect
# one UAC prompt per physical device ever -- twice at worst, if the first bind
# has to be redone with --force. detach stops short of unbinding: a bound but
# detached device is still usable in Windows.
#
# `usb media` is the virtual counterpart: no physical device, just a qcow2 the
# host fills over qemu-nbd and hands to the guest as a usb-storage device, which
# Windows lists under removable media. It follows the volume transport's strict
# turn: the image is never mounted here while it is attached there.

USBIPD="/mnt/c/Program Files/usbipd-win/usbipd.exe"
USBIPD_WIN='C:\Program Files\usbipd-win\usbipd.exe'
DISTRO=archlinux

# Removable media state, module scope for the EXIT trap.
USB_MEDIA_SIZE=4              # GiB, sparse -- an upper bound, not an allocation
USB_MEDIA_FS=""               # ''=auto (exfat>ntfs>guest); else exfat|ntfs|fat32|guest
USB_IMG=""                    # the drive image
USB_TARGET=""                 # the sdX the usb-storage device attaches as
USB_ATTACHED=0                # attached to the guest
USB_ABORTED=0                 # a failed run undoes the guest attach too
# Serial and filesystem label both. 10 chars, under exFAT's 11-char limit, and
# distinct from XFER_LABEL so a staging volume can never be mistaken for it.
USB_MEDIA_LABEL="VIRUTILUSB"

usb_usage() {
    printf '%s\n' \
        "usage: virutil usb list" \
        "       virutil usb show   VM" \
        "       virutil usb attach VM BUSID" \
        "       virutil usb detach VM BUSID|VENDOR:PRODUCT" \
        "       virutil usb unbind BUSID" \
        "       virutil usb media  VM [-s GiB] [SRC...]" \
        "       virutil usb media  VM --mount|--eject|--detach" \
        "" \
        "media -- a virtual USB flash drive, created once per VM and kept:" \
        "  (no options)  fill the drive from SRC (if any) and attach it to the" \
        "                running VM as removable media; empty if no SRC" \
        "  -s, --size GiB  drive size when the image is first created" \
        "                  (default $USB_MEDIA_SIZE; ignored once it exists)" \
        "  -f, --fs TYPE   filesystem when the image is first created:" \
        "                  exfat, ntfs, fat32, or guest (let Windows format it;" \
        "                  needs the matching host mkfs otherwise)" \
        "                  (default: exfat if the host can, else ntfs, else guest)" \
        "  --mount        mount the drive image on the host for hand-filling" \
        "  --eject        flush and detach the drive in the guest" \
        "  --detach       unmount and release the image on the host" \
        "" \
        "BUSID is the first column of 'virutil usb list'." >&2
    exit "${1:-1}"
}

# A busid identifies a port, so it is only meaningful while something is plugged
# in. VENDOR:PRODUCT is the only way to name an unplugged device, which detach
# needs to clear a leftover hostdev. sysfs and libvirt want lowercase hex.
read_dev() {
    if [[ $1 =~ ^[0-9]+-[0-9]+(\.[0-9]+)*$ ]]; then
        echo "$1"
    elif [[ $1 =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]]; then
        echo "${1,,}"
    else
        die "expected a BUSID (e.g. 3-3, see: virutil usb list), got '$1'"
    fi
}

# usbipd's view of one device as
# VendProd|BusId|StubInstanceId|PersistedGuid|ClientIPAddress|IsForced, or
# none/many.
# The hardware id only appears in InstanceId: USB\VID_0951&PID_1666\<serial>.
usbipd_state() {
    local busid="" key=""
    case "$1" in
    *:*) key=$(printf 'VID_%s&PID_%s' "${1%:*}" "${1#*:}" | tr 'a-f' 'A-F') ;;
    *) busid="$1" ;;
    esac
    "$USBIPD" state | tr -d '\r' | jq -r --arg busid "$busid" --arg key "$key" '
        def vendprod: [.InstanceId | scan("(?i)VID_([0-9a-f]{4})&PID_([0-9a-f]{4})")]
                      | if length > 0 then (.[0] | join(":") | ascii_downcase)
                        else "" end;
        [ .Devices[]
          | select(if $busid != "" then .BusId == $busid
                   else (.InstanceId | ascii_upcase) | contains($key) end) ]
        | if length == 0 then "none"
          elif length > 1 then "many"
          else .[0] | [vendprod, (.BusId // ""), (.StubInstanceId // ""),
                       (.PersistedGuid // ""), (.ClientIPAddress // ""),
                       (.IsForced | tostring)] | join("|")
          end'
}

# a busid lookup is exact, so only a hardware id can be ambiguous
resolve_dev() {
    STATE=$(usbipd_state "$1")
    case "$STATE" in
    none) die "no connected USB device at $1 (see: virutil usb list)" ;;
    many) die "several connected devices share hardware id $1; unplug one" ;;
    esac
    IFS='|' read -r ID BUSID STUB GUID CLIENT FORCED <<<"$STATE"
    [ -n "$ID" ] || die "could not read the vendor:product of $1 from usbipd state"
}

# the address usbipd attaches us as; virbr0 has one too, so pin to eth0
wsl_ip() { ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1; }

# Start-Process discards the child's exit code, so callers confirm the outcome by
# rereading usbipd state instead of trusting this.
elevate() {
    local args="'$1'"
    shift
    local a
    for a in "$@"; do args="$args,'$a'"; done
    powershell.exe -NoProfile -Command \
        "Start-Process -FilePath '$USBIPD_WIN' -ArgumentList $args -Verb RunAs -Wait" \
        >/dev/null 2>&1 || true
}

in_sysfs() {
    local d
    # root hubs live at /sys/bus/usb/devices/usbN and are skipped by the glob
    for d in /sys/bus/usb/devices/[0-9]*-[0-9]*/; do
        [ -r "$d/idVendor" ] || continue
        [ "$(cat "$d/idVendor"):$(cat "$d/idProduct")" = "$1" ] && return 0
    done
    return 1
}

# libvirt resolves a managed hostdev by looking it up on the host, so the import
# has to finish enumerating first; the race surfaces as a libvirt error blaming
# the VM layer.
wait_sysfs() {
    local i
    for i in $(seq 25); do
        in_sysfs "$1" && return 0
        sleep 0.2
    done
    return 1
}

# An import is two steps -- usbipd exports the device on the Windows side, then
# the in-WSL usbip client claims it -- and a failure between them leaves the
# export standing with nothing holding it. Every later attempt then dies on
# "Device busy (exported)", which usbipd reports as Windows using the device even
# though it is usbipd's own leftover. Returns 2 for that case, the recoverable
# one, so the caller can clear the export and try again.
usbipd_attach() {
    local out rc=0
    out=$("$USBIPD" attach --wsl "$DISTRO" -b "$BUSID" 2>&1 | tr -d '\r') || rc=$?
    printf '%s\n' "$out" >&2
    [ "$rc" = 0 ] && return 0
    case "$out" in
    *"Device busy"* | *"used by Windows"*) return 2 ;;
    esac
    return 1
}

# Dropping a stale export costs nothing, so it is tried before concluding that
# Windows is at fault. When it really is -- a plain bind leaves the Windows
# driver in place, and for a mass storage device an open Explorer window is
# enough to lose the race -- only `bind --force` settles it, by swapping in the
# stub driver for good. That needs Administrator, hence last.
wsl_import() {
    local rc=0
    usbipd_attach || rc=$?
    [ "$rc" = 0 ] && return 0
    [ "$rc" = 2 ] || exit 1

    say "wsl: $BUSID is still exported from an earlier import, dropping it and retrying"
    "$USBIPD" detach -b "$BUSID"
    rc=0
    usbipd_attach || rc=$?
    [ "$rc" = 0 ] && return 0
    [ "$rc" = 2 ] || exit 1

    [ "$FORCED" != true ] ||
        die "$BUSID ($ID) is force-shared yet still busy; unplug it and plug it back in"

    say "bind: Windows is holding $BUSID ($ID), resharing it with --force, expect a UAC prompt"
    elevate bind --force -b "$BUSID"
    IFS='|' read -r ID BUSID STUB GUID CLIENT FORCED <<<"$(usbipd_state "$BUSID")"
    [ "$FORCED" = true ] ||
        die "force bind did not take effect; was the UAC prompt declined?"

    say "wsl: retrying the import of $BUSID ($ID) into $DISTRO"
    usbipd_attach
}

domstate() { "${VIRSH[@]}" domstate "$VM" 2>/dev/null | head -1; }

# checked before anything touches Windows, so a mistyped VM name cannot cost a
# UAC prompt and then fail at the last stage
require_domain() {
    "${VIRSH[@]}" domstate "$VM" >/dev/null 2>&1 ||
        die "no such VM: $VM (see: virsh -c qemu:///system list --all)"
}

# startupPolicy only matters while a domain starts, so it belongs in persistent
# config and is left out of a live attach. Without it a persisted hostdev whose
# device is unplugged can stop the VM from booting at all.
hostdev_xml() {
    cat <<EOF
<hostdev mode='subsystem' type='usb' managed='yes'>
  <source${2:-}>
    <vendor id='0x${1%:*}'/>
    <product id='0x${1#*:}'/>
  </source>
</hostdev>
EOF
}

hostdevs() { "${VIRSH[@]}" dumpxml "$@" | sed -n '/<hostdev/,/<\/hostdev>/p'; }

# libvirt has no idempotent attach-device, so this gates the last stage. libvirt
# always emits <vendor> before <product>, so pairing successive ids reconstructs
# each hostdev's VENDOR:PRODUCT.
has_hostdev() {
    hostdevs "$@" |
        sed -n "s/.*<\(vendor\|product\) id='0x\([0-9a-f]*\)'.*/\2/p" |
        paste -d: - - | grep -qx "$ID"
}

# A device can sit in the live domain, the persistent config, or both. Only
# "not found" is tolerated.
detach_scope() {
    local scope="$1" out
    if out=$(hostdev_xml "$ID" | "${VIRSH[@]}" detach-device "$VM" "$scope" /dev/stdin 2>&1); then
        say "libvirt: removed from $scope"
        return 0
    fi
    case "$out" in
    *"not found"* | *"Not found"*) return 1 ;;
    esac
    die "$out"
}

# --- removable media --------------------------------------------------------

usb_media_image() { printf '%s/%s-usb.qcow2' "$VOLUME_DIR" "$1"; }

usb_media_mnt() { virutils_mnt "$1-usb"; }

# libvirt attaches a usb-storage device at a SCSI target name; the first free
# one is picked so a real SCSI disk, or a second drive, is never shadowed.
usb_media_free_target() {
    local used letter
    used="$("${VIRSH[@]}" domblklist "$DOMAIN" 2>/dev/null | awk 'NR>2 {print $1}')"
    for letter in a b c d e f g h i j k l m n o p q r s t u v w x y z; do
        grep -qx "sd$letter" <<<"$used" || { printf 'sd%s' "$letter"; return 0; }
    done
    die "no free SCSI target on $DOMAIN"
}

# libvirt matches a disk by its source; anything under the image path is ours.
usb_media_attached() {
    "${VIRSH[@]}" domblklist "$DOMAIN" 2>/dev/null \
        | awk -v img="$USB_IMG" '$2 == img { found = 1 } END { exit !found }'
}

# removable='on' is what QEMU's usb-storage needs to present the RMB bit, which
# is what makes Windows call the drive removable media at all.
usb_media_xml() {
    cat <<EOF
<disk type='file' device='disk'>
  <driver name='qemu' type='qcow2' cache='none' io='io_uring' discard='unmap'/>
  <source file='$USB_IMG'/>
  <target dev='$USB_TARGET' bus='usb' removable='on'/>
  <serial>$USB_MEDIA_LABEL</serial>
</disk>
EOF
}

# The host half that can format TYPE, or nothing if it cannot. guest never gets
# here -- that branch needs no host mkfs at all.
usb_media_fs_ok() {
    case "$1" in
    exfat) command -v mkfs.exfat || true ;;
    ntfs)  command -v mkfs.ntfs || command -v mkntfs || true ;;
    fat32) command -v mkfs.vfat || command -v mkfs.fat || true ;;
    esac
}

# usb_media_create -- make the drive image and format it by whichever half of
# the machine can, exactly as the volume transport does for its staging image:
# one GPT partition spanning the disk, exFAT when the host can, NTFS otherwise,
# and Windows itself when neither exists. --fs narrows the choice to the named
# type, which still needs its host mkfs. Idempotent; ends with $NBD detached.
usb_media_create() {
    local created=0
    if [[ ! -e "$USB_IMG" ]]; then
        mkdir -p "$VOLUME_DIR"
        paths_qemu_warn "$VOLUME_DIR"
        say "usb media: creating $USB_IMG (${USB_MEDIA_SIZE} GiB, sparse)"
        local -a imgsudo=()
        [[ -w "$(dirname -- "$USB_IMG")" ]] || imgsudo=("${SUDO[@]}")
        "${imgsudo[@]}" qemu-img create -f qcow2 -o cluster_size=1M \
            -- "$USB_IMG" "${USB_MEDIA_SIZE}G" >/dev/null \
            || die "could not create $USB_IMG"
        created=1
    fi

    nbd_connect "$USB_IMG"

    local part; part="$(nbd_find_part exfat ntfs vfat)"
    if [[ -n "$part" ]]; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
        return 0
    fi

    volume_pick_fs
    if [[ -n "$USB_MEDIA_FS" && "$USB_MEDIA_FS" != guest ]]; then
        local mk; mk="$(usb_media_fs_ok "$USB_MEDIA_FS")"
        [[ -n "$mk" ]] || die "--fs $USB_MEDIA_FS needs its mkfs on the host (or" \
                               "--fs guest, to let Windows format the drive)"
        VOLUME_FS="$USB_MEDIA_FS"
    elif [[ "$USB_MEDIA_FS" == guest ]]; then
        VOLUME_FS=guest
    fi

    (( created )) || warn "usb media $USB_IMG has no readable filesystem;" \
                          "reformatting it (nothing on it is worth keeping)"
    volume_partition

    case "$VOLUME_FS" in
    exfat)
        say "usb media: formatting exFAT"
        "${SUDO[@]}" mkfs.exfat -n "$USB_MEDIA_LABEL" "${NBD}p1" >/dev/null \
            || die "mkfs.exfat failed on ${NBD}p1"
        ;;
    ntfs)
        say "usb media: formatting NTFS"
        local mk; mk="$(command -v mkfs.ntfs || command -v mkntfs)"
        "${SUDO[@]}" "$mk" --quick --label "$USB_MEDIA_LABEL" "${NBD}p1" >/dev/null \
            || die "$mk failed on ${NBD}p1"
        ;;
    fat32)
        say "usb media: formatting FAT32"
        local mk; mk="$(command -v mkfs.vfat || command -v mkfs.fat)"
        "${SUDO[@]}" "$mk" -n "$USB_MEDIA_LABEL" "${NBD}p1" >/dev/null \
            || die "$mk failed on ${NBD}p1"
        ;;
    guest)
        [[ "$(domstate)" == running ]] || die \
            "$DOMAIN is not running, so the drive cannot be formatted in the" \
            "guest. Start it, or install a host mkfs (exfatprogs, ntfs-3g or" \
            "dosfstools) to format here."
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
        usb_format_in_guest
        return 0
        ;;
    esac

    "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
}

# The fallback for a host with no mkfs the guest could read: the blank drive is
# handed to the guest once, Initialize-Disk and Format-Volume run inside it, and
# it comes back ready.
usb_format_in_guest() {
    say "usb media: formatting the drive in $DOMAIN"
    usb_attach_device

    xfer_ps '
$disk = $null
$deadline = (Get-Date).AddSeconds(30)
do {
  $disk = Get-Disk | Where-Object { $_.SerialNumber -like "*'"$USB_MEDIA_LABEL"'*" } | Select-Object -First 1
  if (-not $disk) {
    $disk = Get-Disk | Where-Object { $_.PartitionStyle -eq "RAW" } | Select-Object -First 1
  }
  if ($disk) { break }
  Start-Sleep -Milliseconds 500
} while ((Get-Date) -lt $deadline)
if (-not $disk) { throw "the usb drive never appeared in the guest" }
if ($disk.IsOffline)  { Set-Disk -Number $disk.Number -IsOffline $false }
if ($disk.IsReadOnly) { Set-Disk -Number $disk.Number -IsReadOnly $false }
if ($disk.PartitionStyle -eq "RAW") { Initialize-Disk -Number $disk.Number -PartitionStyle GPT }
$part = Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |
        Where-Object { $_.Type -ne "Reserved" } | Select-Object -First 1
if (-not $part) { $part = New-Partition -DiskNumber $disk.Number -UseMaximumSize -AssignDriveLetter }
Format-Volume -Partition $part -FileSystem NTFS -FileSystemLabel "'"$USB_MEDIA_LABEL"'" -Full:$false -Confirm:$false | Out-Null
Write-Output "formatted"' \
        || die "formatting the usb media inside $DOMAIN failed"

    usb_release_in_guest
    usb_detach_device
}

# The gate on every host-side mount: the drive must be the host's alone. Usable
# with the guest running or not -- mounting a drive is purely a host action.
usb_media_open() {
    xfer_privilege
    command -v sfdisk >/dev/null || die "sfdisk not installed (util-linux)"
    if (( ${#SUDO[@]} )); then
        command -v sudo >/dev/null || die "sudo not installed; nbd and mount need it"
        sudo -v || die "sudo authentication failed"
    fi

    USB_IMG="$(usb_media_image "$DOMAIN")"
    MNT="${MNT:-$(usb_media_mnt "$DOMAIN")}"

    usb_media_attached \
        && die "the usb media is attached to $DOMAIN; eject it first" \
               "  virutil usb media $DOMAIN --eject"
    nbd_attached && die "$NBD is already attached; free it or set @nbd elsewhere" \
                        "  sudo qemu-nbd -d $NBD"
    if mnt_mounted; then
        say "usb media: already mounted at $MNT, reusing it"
        return 0
    fi

    usb_media_create
    nbd_connect "$USB_IMG"
    local part; part="$(nbd_find_part exfat ntfs vfat)"
    [[ -n "$part" ]] || die "no exFAT, NTFS or FAT32 partition on the usb media" \
                            "-- remove $USB_IMG and run again to rebuild it"
    local fstype; fstype="$("${SUDO[@]}" blkid -o value -s TYPE "$part")"
    "${SUDO[@]}" mkdir -p "$MNT"
    # uid=/gid= hand the tree to the invoking user.
    "${SUDO[@]}" mount -t "$fstype" -o "uid=$(id -u),gid=$(id -g)" "$part" "$MNT" \
        || die "could not mount the usb media ($fstype) at $MNT"
    mnt_writable || die "the usb media mounted read-only at $MNT"
    say "usb media: $MNT ($fstype, $(nbd_part_size "$part") GiB)"
}

# Copy a host path onto the drive, keeping its basename at the root; a trailing
# slash on a directory means its contents, rsync-style.
usb_media_copy_in() {
    local src="$1"
    [[ -e "$src" ]] || die "no such file or directory: $src"
    if [[ -d "$src" ]]; then
        command -v rsync >/dev/null || die "rsync not installed"
        say "usb media: copying $src into the drive"
        rsync -rlt --info=progress2 --no-perms --no-owner --no-group -- "$src" "$MNT/"
    else
        say "usb media: copying $src into the drive"
        cp -f -- "$src" "$MNT/"
    fi
}

# Release the image host-side -- verified from /proc/mounts and sysfs, not exit
# codes -- then hotplug it into the guest. Two writers on one image is the one
# mistake nothing can undo, so the handover refuses if either probe still holds.
usb_media_handoff() {
    sync
    if mnt_mounted; then
        "${SUDO[@]}" umount "$MNT" || die "could not unmount $MNT"
    fi
    if nbd_attached; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
    fi
    sync

    if mnt_mounted || nbd_attached; then
        die "the usb media is still held by the host ($MNT / $NBD); refusing to" \
            "hand it to $DOMAIN -- two writers on one image is the one mistake" \
            "nothing here can undo"
    fi

    usb_attach_device
}

usb_attach_device() {
    USB_TARGET="$(usb_media_free_target)"
    usb_media_xml | "${VIRSH[@]}" attach-device "$DOMAIN" --live /dev/stdin \
        || die "could not attach the usb media to $DOMAIN"
    USB_ATTACHED=1
    say "usb media: handed to $DOMAIN as removable media (${USB_TARGET})"
}

usb_detach_device() {
    (( USB_ATTACHED )) || return 0
    usb_media_xml | "${VIRSH[@]}" detach-device "$DOMAIN" --live /dev/stdin \
        >/dev/null 2>&1 \
        || warn "could not detach the usb media from $DOMAIN; remove it by hand:" \
                "  ${VIRSH[*]} detach-disk $DOMAIN $USB_TARGET --live"

    # The detach is asynchronous: libvirt returns once the guest has been asked.
    local i
    for (( i = 0; i < 30; i++ )); do
        usb_media_attached || { USB_ATTACHED=0; return 0; }
        sleep 0.5
    done
    warn "$DOMAIN has not released the usb media after 15s"
    USB_ATTACHED=0
}

# Flush the guest's cache and take the drive offline, so the filesystem is
# closed before the device disappears underneath it. Mirrors the volume
# transport's release, matching the drive by its own serial and label so a
# staging volume can never be offlined instead. The drive letter goes back
# first: Windows remembers an assignment long after the disk behind it has gone.
usb_release_in_guest() {
    xfer_ps '
try { Get-Volume -FileSystemLabel "'"$USB_MEDIA_LABEL"'" -ErrorAction SilentlyContinue |
      Write-VolumeCache -ErrorAction SilentlyContinue } catch {}
try {
  $lv = Get-Volume -FileSystemLabel "'"$USB_MEDIA_LABEL"'" -ErrorAction SilentlyContinue |
        Select-Object -First 1
  if ($lv -and $lv.DriveLetter) {
    Get-Partition -DriveLetter $lv.DriveLetter -ErrorAction Stop |
      Remove-PartitionAccessPath -AccessPath ($lv.DriveLetter + ":\") -ErrorAction Stop
  }
} catch {}
$d = Get-Disk | Where-Object { $_.SerialNumber -like "*'"$USB_MEDIA_LABEL"'*" } | Select-Object -First 1
if (-not $d) {
  $v = Get-Volume -FileSystemLabel "'"$USB_MEDIA_LABEL"'" -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($v -and $v.DriveLetter) {
    $d = Get-Partition -DriveLetter $v.DriveLetter -ErrorAction SilentlyContinue |
         Get-Disk -ErrorAction SilentlyContinue | Select-Object -First 1
  }
}
if ($d) { try { Set-Disk -Number $d.Number -IsOffline $true -ErrorAction Stop } catch {} }
exit 0' >/dev/null 2>&1 || true
}

# The letter Windows gave the drive, by label, or nothing. Polled: a hotplugged
# USB device takes a moment to enumerate and be assigned one.
usb_drive_letter() {
    local tries="${1:-30}"
    xfer_ps '
$deadline = (Get-Date).AddSeconds('"$tries"')
do {
  $v = Get-Volume -FileSystemLabel "'"$USB_MEDIA_LABEL"'" -ErrorAction SilentlyContinue |
       Select-Object -First 1
  if ($v -and $v.DriveLetter) { Write-Output $v.DriveLetter; exit 0 }
  $disk = Get-Disk -ErrorAction SilentlyContinue |
          Where-Object { $_.SerialNumber -like "*'"$USB_MEDIA_LABEL"'*" } | Select-Object -First 1
  if ($disk -and $v -and -not $v.DriveLetter) {
    try {
      Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |
        Where-Object { -not $_.DriveLetter -and $_.Type -ne "Reserved" } |
        Add-PartitionAccessPath -AssignDriveLetter -ErrorAction Stop
    } catch {}
  }
  Start-Sleep -Milliseconds 500
} while ((Get-Date) -lt $deadline)
exit 1' 2>/dev/null | tr -d '[:space:]'
}

# Teardown, from the EXIT trap of the attach flow: nothing the host holds may
# survive the run. A run that failed after reaching the guest undoes the attach
# there too; a successful one leaves the drive where the user asked for it.
usb_media_trap() {
    if [[ -n "$MNT" ]] && mnt_mounted; then
        sync
        "${SUDO[@]}" umount "$MNT" 2>/dev/null || true
    fi
    if [[ -n "$NBD" ]] && nbd_attached; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
    fi
    if (( USB_ATTACHED && USB_ABORTED )); then
        usb_release_in_guest >/dev/null 2>&1 || true
        usb_detach_device >/dev/null 2>&1 || true
    fi
    sync
}

usb_media_attach() {
    local letter src
    trap usb_media_trap EXIT
    USB_ABORTED=1

    usb_media_open
    for src in "$@"; do
        usb_media_copy_in "$src"
    done
    usb_media_handoff

    letter="$(usb_drive_letter 30 || true)"
    if [[ -n "$letter" ]]; then
        say "usb media: $letter: in $DOMAIN"
    else
        warn "the drive is attached, but no drive letter has appeared yet; check" \
             "it with:  virutil exec ps $DOMAIN Get-Volume"
    fi
    USB_ABORTED=0
}

usb_media_main() {
    local VM="" SIZE="" FS="" CMD=attach
    local -a SRC=()

    while (( $# )); do
        case "$1" in
        -s|--size)  SIZE="${2:?$1 needs a value}"; shift 2 ;;
        -f|--fs)    FS="${2:?$1 needs a value}"; shift 2 ;;
        --mount)    CMD=mount; shift ;;
        --eject)    CMD=eject; shift ;;
        --detach)   CMD=detach; shift ;;
        -h|--help)  usb_usage 0 ;;
        -*)         die "virutil usb media: unknown option: $1" ;;
        *)          if [[ -z "$VM" ]]; then VM="$1"
                    else SRC+=("$1")
                    fi
                    shift ;;
        esac
    done
    [[ -n "$VM" ]] || usb_usage
    if [[ -n "$SIZE" ]]; then
        [[ "$SIZE" =~ ^[0-9]+$ ]] || die "--size wants a whole number of GiB, got '$SIZE'"
        USB_MEDIA_SIZE="$SIZE"
    fi
    if [[ -n "$FS" ]]; then
        case "$FS" in
        exfat|ntfs|fat32|guest) USB_MEDIA_FS="$FS" ;;
        *) die "--fs wants exfat, ntfs, fat32 or guest, got '$FS'" ;;
        esac
    fi

    DOMAIN="$VM"
    require_domain

    case "$CMD" in
    mount)
        # Only the host is touched, so this works with the domain shut off. The
        # trap undoes a half-finished open, then is dropped so the mount is the
        # caller's to keep, fill and hand over.
        trap usb_media_trap EXIT
        usb_media_open
        trap - EXIT
        say "fill the drive at $MNT, then hand it over with:" \
            "  virutil usb media $VM" \
            "(or unmount it again with: virutil usb media $VM --detach)"
        ;;
    eject)
        local st; st="$(domstate)"
        [[ "$st" == running ]] \
            || die "$VM is '$st'; nothing to eject"
        xfer_agent_ok "$VM" || die "the qemu guest agent is not answering in $VM," \
            "which is what flushes the drive before it is detached. Install it" \
            "(see the guest prerequisites in README.md)."
        USB_IMG="$(usb_media_image "$VM")"
        usb_media_attached || die "the usb media is not attached to $VM"
        USB_TARGET="$("${VIRSH[@]}" domblklist "$VM" 2>/dev/null \
                      | awk -v img="$USB_IMG" '$2 == img {print $1; exit}')"
        USB_ATTACHED=1
        usb_release_in_guest
        usb_detach_device
        if usb_media_attached; then
            say "usb media: the guest still holds $USB_IMG; remove it by hand (see above)"
        else
            say "usb media: removed from $VM; the image is kept at $USB_IMG"
        fi
        ;;
    detach)
        USB_IMG="$(usb_media_image "$VM")"
        MNT="$(usb_media_mnt "$VM")"
        xfer_privilege
        usb_media_attached && die "the usb media is attached to $VM; eject it first" \
                                  "  virutil usb media $VM --eject"
        if mnt_mounted; then
            sync
            "${SUDO[@]}" umount "$MNT" || die "could not unmount $MNT"
        fi
        if nbd_attached; then
            "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
        fi
        sync
        if mnt_mounted || nbd_attached; then
            die "the host still holds the usb media ($MNT / $NBD); free it by hand:" \
                "  sudo umount $MNT" \
                "  sudo qemu-nbd -d $NBD"
        fi
        say "usb media: released on the host"
        ;;
    *)
        # The headline flow: create if needed, fill from SRC, attach to the
        # running guest. Idempotent: an already-attached drive is reported and
        # left alone.
        local st; st="$(domstate)"
        [[ "$st" == running ]] \
            || die "$VM is '$st'; a USB device can only hotplug into a running" \
                   "guest." \
                   "  virutil domain start $VM"
        xfer_agent_ok "$VM" || die "the qemu guest agent is not answering in $VM," \
            "which is what formats and releases the drive inside it. Install it" \
            "(see the guest prerequisites in README.md)."
        USB_IMG="$(usb_media_image "$VM")"
        MNT="$(usb_media_mnt "$VM")"
        if usb_media_attached; then
            say "usb media is already attached to $VM"
            return 0
        fi
        usb_media_attach "${SRC[@]}"
        say "remove it from the guest again with:" \
            "  virutil usb media $VM --eject"
        ;;
    esac
}

usb_main() {
    local CMD VM DEV ID STATE BUSID STUB GUID CLIENT FORCED REMOVED
    CMD="${1:-}"
    [ -n "$CMD" ] || usb_usage
    case "$CMD" in -h|--help) usb_usage 0 ;; esac

    case "$CMD" in
    list)
        "$USBIPD" list | tr -d '\r'
        ;;
    show)
        VM="${2:?usage: virutil usb show VM}"
        # A persisted hostdev that is not live is the one that surprises you at
        # the next boot, so never show one view without the other.
        echo "=== live ==="
        hostdevs "$VM"
        echo "=== persistent ==="
        hostdevs --inactive "$VM"
        echo "=== usb media ==="
        local img; img="$(usb_media_image "$VM")"
        if "${VIRSH[@]}" domblklist "$VM" 2>/dev/null \
            | awk -v i="$img" '$2 == i { found = 1 } END { exit !found }'; then
            echo "  $img (attached)"
        elif [[ -e "$img" ]]; then
            echo "  $img (not attached)"
        else
            echo "  none -- create one with: virutil usb media $VM"
        fi
        ;;
    attach)
        VM="${2:?usage: virutil usb attach VM BUSID}"
        DEV=$(read_dev "${3:?usage: virutil usb attach VM BUSID}")
        require_domain
        resolve_dev "$DEV"

        if [ -n "$STUB$GUID" ]; then
            say "bind: $BUSID ($ID) already shared, skipping"
        else
            say "bind: sharing $BUSID ($ID) on the Windows host, expect a UAC prompt"
            elevate bind -b "$BUSID"
            IFS='|' read -r ID BUSID STUB GUID CLIENT FORCED <<<"$(usbipd_state "$BUSID")"
            [ -n "$STUB$GUID" ] || die "bind did not take effect; was the UAC prompt declined?"
        fi

        IP=$(wsl_ip)
        [ -z "$CLIENT" ] || [ "$CLIENT" = "$IP" ] ||
            die "$BUSID is attached to $CLIENT, not to this WSL instance ($IP)"

        # usbipd records the export the moment it hands the device out, so
        # ClientIPAddress cannot tell a live import from one that died half way.
        # sysfs is the only witness that the device really arrived, and skipping
        # on the record alone is what turns a stale export into a wait_sysfs
        # timeout blaming the import.
        if [ -n "$CLIENT" ] && in_sysfs "$ID"; then
            say "wsl: $BUSID already attached here, skipping"
        else
            say "wsl: importing $BUSID ($ID) into $DISTRO"
            wsl_import
        fi

        wait_sysfs "$ID" || die "$ID never appeared in WSL; the usbipd import did not land"

        if [ "$(domstate)" = running ]; then
            if has_hostdev "$VM"; then
                say "libvirt: $ID is already attached to $VM, skipping"
            else
                say "libvirt: attaching to $VM (live)"
                hostdev_xml "$ID" | "${VIRSH[@]}" attach-device "$VM" --live /dev/stdin
            fi
        elif has_hostdev --inactive "$VM"; then
            say "libvirt: $ID is already in $VM's persistent config, skipping"
        else
            say "libvirt: $VM is not running, attaching to its persistent config"
            hostdev_xml "$ID" " startupPolicy='optional'" |
                "${VIRSH[@]}" attach-device "$VM" --config /dev/stdin
        fi
        ;;
    detach)
        VM="${2:?usage: virutil usb detach VM BUSID}"
        DEV=$(read_dev "${3:?usage: virutil usb detach VM BUSID}")
        require_domain

        # libvirt wrote the hostdev in terms of vendor/product, so a busid has to
        # be resolved first. A device already gone from the host cannot be, so the
        # argument has to name it as VENDOR:PRODUCT.
        STATE=$(usbipd_state "$DEV")
        case "$STATE" in
        many) die "several connected devices share hardware id $DEV; unplug one" ;;
        none)
            case "$DEV" in
            *:*) ID="$DEV" ;;
            *) die "nothing is connected at busid $DEV; name the device as VENDOR:PRODUCT to remove a leftover hostdev (see: virutil usb show $VM)" ;;
            esac
            ;;
        *) IFS='|' read -r ID BUSID STUB GUID CLIENT FORCED <<<"$STATE" ;;
        esac

        REMOVED=0
        if [ "$(domstate)" = running ]; then
            if detach_scope --live; then REMOVED=1; fi
        fi
        if detach_scope --config; then REMOVED=1; fi
        [ "$REMOVED" = 1 ] || die "$VM has no hostdev for $ID, live or persistent"

        # Leaves the device bound: still usable in Windows, and ready for a
        # prompt-free reattach. `virutil usb unbind` stops sharing altogether.
        if [ -n "${CLIENT:-}" ]; then
            say "wsl: returning $BUSID ($ID) to the Windows host"
            "$USBIPD" detach -b "$BUSID"
        fi
        ;;
    unbind)
        DEV=$(read_dev "${2:?usage: virutil usb unbind BUSID}")
        resolve_dev "$DEV"

        if [ -z "$STUB$GUID" ]; then
            say "unbind: $BUSID ($ID) is not shared, nothing to do"
        else
            say "unbind: unsharing $BUSID ($ID), expect a UAC prompt"
            elevate unbind -b "$BUSID"
            IFS='|' read -r ID BUSID STUB GUID CLIENT FORCED <<<"$(usbipd_state "$DEV")"
            [ -z "$STUB$GUID" ] || die "unbind did not take effect; was the UAC prompt declined?"
        fi
        ;;
    media)
        shift
        usb_media_main "$@"
        ;;
    *)
        usb_usage
        ;;
    esac
}
