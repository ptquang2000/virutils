# usb -- pass a physical USB device through to a guest.
#
# The bash half of the module docs/contract.md section 7 describes, and the
# counterpart of modules/usb.ps1: the same four verbs, the same way of naming a
# device, over libvirt instead of over the QEMU monitor. An attach is a
# <hostdev> element attached to the domain; libvirt resolves it on the host and
# hands qemu the device.
#
# A device is named by VENDOR:PRODUCT, lowercase hex, and never by a bus path.
# libvirt takes a bus/device address too and it is the more precise of the two,
# but it names a *port* -- it changes when the device moves sockets, and that
# was the single easiest thing to get wrong about the usbip module this replaced.
#
# An attach is two things at once, as the Windows driver's is: the live domain,
# so the device arrives now, and the persistent config, so it is still there
# after the next boot. managed='yes' is what makes the first half work at all --
# libvirt detaches the device from the host driver and gives it back on detach.
#
# **On WSL the device has to get into the kernel first.** libvirt here is a
# Linux-side view of a device plugged into Windows, and nothing in this file
# crosses that boundary: `virutil usb list` cannot see a device usbipd has not
# handed over, and an attach of one fails in libvirt looking it up. The usbipd
# round trip that brings it across is a recipe in the README, deliberately not a
# command -- see section 7 of the contract for why.

usb_usage() {
    printf '%s\n' \
        "usage: virutil usb list" \
        "       virutil usb show   VM" \
        "       virutil usb attach VM VENDOR:PRODUCT" \
        "       virutil usb detach VM VENDOR:PRODUCT" \
        "" \
        "VENDOR:PRODUCT is lowercase hex, the first column of 'virutil usb" \
        "list'. It names the device rather than the port it is plugged into," \
        "so it survives moving it between sockets." \
        "" \
        "attach acts on the running domain and on its persistent config, so a" \
        "device attached once is still attached after the next boot. attach on" \
        "a shut-off domain writes the config alone." \
        "" \
        "Under WSL a device plugged into Windows is not here until usbipd has" \
        "imported it; see the README. This module only ever sees the Linux" \
        "side." >&2
    exit "${1:-1}"
}

# read_usb_id ARG -- VENDOR:PRODUCT, lowercased. sysfs and libvirt both want
# lower hex; lsusb and Windows both print upper, so this is where case stops
# mattering.
read_usb_id() {
    if [[ $1 =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}$ ]]; then
        printf '%s' "${1,,}"
    else
        die "expected a VENDOR:PRODUCT (e.g. 0951:1666, see: virutil usb list), got '$1'"
    fi
}

# --- the host's devices -----------------------------------------------------
#
# Read from sysfs rather than from lsusb: this is the one thing in the module
# that would otherwise need a package (usbutils) that a minimal host and most
# containers do not have, and the two fields worth printing are right there.
# The names are the device's own strings, so a device that reports none shows
# its id alone -- lsusb would name it from usb.ids, which is nicer and not worth
# a dependency.
usb_devices() {
    local d vendor product name
    # root hubs live at /sys/bus/usb/devices/usbN and are skipped by the glob
    for d in /sys/bus/usb/devices/[0-9]*-[0-9]*/; do
        [ -r "$d/idVendor" ] || continue
        vendor=$(<"$d/idVendor")
        product=$(<"$d/idProduct")
        name=""
        [ -r "$d/manufacturer" ] && name=$(<"$d/manufacturer")
        [ -r "$d/product" ] && name="${name:+$name }$(<"$d/product")"
        printf '%s:%s  %s\n' "${vendor,,}" "${product,,}" "$name"
    done | sort -u
}

# Matched on the whole first field rather than as a prefix: 0951:1666 must not
# be answered for by 0951:16660, and awk's default splitting gets the id back
# out of the listing without caring how it is spaced.
in_sysfs() {
    usb_devices | awk -v id="$1" '$1 == id { found = 1 } END { exit !found }'
}

# --- the domain -------------------------------------------------------------

domstate() { "${VIRSH[@]}" domstate "$VM" 2>/dev/null | head -1; }

require_domain() {
    "${VIRSH[@]}" domstate "$VM" >/dev/null 2>&1 ||
        die "no such VM: $VM (see: virsh -c qemu:///system list --all)"
}

# startupPolicy only matters while a domain starts, so it belongs in the
# persistent config and is left out of a live attach, where libvirt rejects it.
# Without it a persisted hostdev whose device is unplugged can stop the domain
# from booting at all -- the one place this driver needs a setting the Windows
# one does not, because qemu on its own waits for the device instead.
hostdev_xml() {
    cat <<EOF
<hostdev mode='subsystem' type='usb' managed='yes'>
  <source${2:-}>
    <vendor id='0x${1%:*}'/>
    <product id='0x${1#*:}'/>
  </source>
</hostdev>
EOF
}

hostdevs() { "${VIRSH[@]}" dumpxml "$@" | sed -n '/<hostdev/,/<\/hostdev>/p'; }

# libvirt always emits <vendor> before <product>, so pairing successive ids
# reconstructs each hostdev's VENDOR:PRODUCT. There is no idempotent
# attach-device, so this is what stands in for one.
has_hostdev() {
    hostdevs "$@" |
        sed -n "s/.*<\(vendor\|product\) id='0x\([0-9a-f]*\)'.*/\2/p" |
        paste -d: - - |
        awk -v id="$ID" '$0 == id {found=1} END {exit !found}'
}

# A device can sit in the live domain, the persistent config, or both. Only
# "not found" is tolerated: it is the ordinary answer for a scope this device
# was never in, and the caller decides whether a miss on both is an error.
detach_scope() {
    local scope="$1" out
    if out=$(hostdev_xml "$ID" | "${VIRSH[@]}" detach-device "$VM" "$scope" /dev/stdin 2>&1); then
        say "libvirt: removed from $scope"
        return 0
    fi
    case "$out" in
    *"not found"* | *"Not found"*) return 1 ;;
    esac
    die "$out"
}

usb_main() {
    local CMD VM ID REMOVED
    CMD="${1:-}"
    [ -n "$CMD" ] || usb_usage
    case "$CMD" in -h|--help) usb_usage 0 ;; esac

    case "$CMD" in
    list)
        # An empty listing is the ordinary state under WSL, where the kernel
        # has no USB devices at all until usbipd hands one over -- and a silent
        # empty list is indistinguishable from a broken one, so say which.
        if [ -z "$(usb_devices)" ]; then
            say "no USB devices on this host" \
                "under WSL that is expected until usbipd imports one -- see the README"
        else
            usb_devices
        fi
        ;;
    show)
        VM="${2:?usage: virutil usb show VM}"
        require_domain
        # A persisted hostdev that is not live is the one that surprises you at
        # the next boot, so never show one view without the other.
        echo "=== live ==="
        if [ "$(domstate)" = running ]; then
            hostdevs "$VM"
        else
            echo "  not running"
        fi
        echo "=== persistent ==="
        hostdevs --inactive "$VM"
        ;;
    attach)
        VM="${2:?usage: virutil usb attach VM VENDOR:PRODUCT}"
        ID=$(read_usb_id "${3:?usage: virutil usb attach VM VENDOR:PRODUCT}")
        require_domain

        # libvirt resolves a managed hostdev by looking the device up on this
        # host, and a lookup that fails surfaces as an error blaming the VM
        # layer. Saying it here, once, is worth more than that error.
        in_sysfs "$ID" ||
            die "no USB device $ID on this host (see: virutil usb list)" \
                "under WSL, usbipd has to import it into this kernel first -- see the README"

        if has_hostdev --inactive "$VM"; then
            die "$VM already passes through $ID (see: virutil usb show $VM)"
        fi

        if [ "$(domstate)" = running ]; then
            say "libvirt: attaching $ID to $VM (live)"
            hostdev_xml "$ID" | "${VIRSH[@]}" attach-device "$VM" --live /dev/stdin
        else
            say "$VM is not running: $ID goes into its persistent config for the next boot"
        fi
        hostdev_xml "$ID" " startupPolicy='optional'" |
            "${VIRSH[@]}" attach-device "$VM" --config /dev/stdin
        ;;
    detach)
        VM="${2:?usage: virutil usb detach VM VENDOR:PRODUCT}"
        ID=$(read_usb_id "${3:?usage: virutil usb detach VM VENDOR:PRODUCT}")
        require_domain

        # if, not &&: under `set -e` a trailing `cmd && x=1` that fails takes
        # the whole run down with it, and a scope this device was never in is
        # the ordinary case here rather than a failure.
        REMOVED=0
        if [ "$(domstate)" = running ]; then
            if detach_scope --live; then REMOVED=1; fi
        fi
        if detach_scope --config; then REMOVED=1; fi
        [ "$REMOVED" = 1 ] ||
            die "$VM does not pass through $ID, live or persistent (see: virutil usb show $VM)"
        ;;
    *)
        usb_usage
        ;;
    esac
}
