# xfer -- the transport behind sync, pull and push: the guest's own qcow2 over
# qemu-nbd, mounted on the host. There is one, so nothing here chooses.
#
# Write direction:  xfer_check write -> guest_open      -> caller writes into $MNT
# Read direction:   xfer_check read  -> pull_open_disk  -> caller reads  from $MNT
#
# MNT is the root of the guest's C: -- literally, since the mount *is* C:, so a
# copy into it needs no delivery step afterwards.

# Escalate only what needs root: under sudo $HOME is root's, so config
# discovery would read /root.
xfer_privilege() {
    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi
}

xfer_running() {
    [[ "$("${VIRSH[@]}" domstate "$1" 2>/dev/null)" == running ]]
}

# xfer_check MODE -- the guest has to be in the right state for the direction
# about to be taken, and the two directions want opposite ones:
#
#   write  the mount writes straight to the disk image, which a running guest
#          also has open -- so the guest must be shut off
#   read   the read runs off a live disk-only snapshot, taken while the guest
#          keeps running -- so the guest must be running
#
# Checked here, up front, rather than inside the open: the guest's state decides
# whether the run can happen at all, so it is settled before the fetch or any
# other work that would be thrown away.
xfer_check() {
    local mode="$1" dom="$DOMAIN" state
    state="$("${VIRSH[@]}" domstate "$dom" 2>/dev/null)"

    case "$mode" in
        write)
            [[ "$state" == "shut off" ]] \
                || die "$dom has to be shut off for this; it is '$state'." \
                       "The copy writes straight to the disk image, which a" \
                       "running guest also has open. Shut it down with" \
                       "'virutil domain shutdown $dom' and start it again" \
                       "yourself afterwards."
            ;;
        read)
            [[ "$state" == running ]] \
                || die "$dom has to be running for this; it is '$state'." \
                       "The copy reads the live disk through a disk-only" \
                       "snapshot, so there is nothing to read from a guest" \
                       "that is not up. Start it with" \
                       "'virutil domain start $dom'."
            ;;
        *) die "internal: xfer_check wants write or read, got '$mode'" ;;
    esac
}

# --- host-side primitives ---------------------------------------------------

# max_part only takes effect at module load, so a module already up without it
# has to be reloaded or the partition nodes never appear.
nbd_reload() {
    if [[ ! -e /sys/module/nbd/parameters/max_part ]] \
       || (( $(< /sys/module/nbd/parameters/max_part) < 1 )); then
        "${SUDO[@]}" rmmod nbd 2>/dev/null || true
        "${SUDO[@]}" modprobe nbd max_part=8
    fi
}

# nbd_connect IMG [-r] -- attach IMG at $NBD and settle the partition table.
nbd_connect() {
    local img="$1" ro="${2:-}"
    nbd_reload
    "${SUDO[@]}" qemu-nbd ${ro:+-r} -c "$NBD" "$img"
    nbd_settle
}

# Does $NBD have at least one partition node yet?
nbd_has_parts() {
    local dev
    for dev in "$NBD"p*; do [[ -b "$dev" ]] && return 0; done
    return 1
}

# Is $NBD serving reads? Straight after qemu-nbd -c it may be sized but not yet
# answering: that is what makes partx report "failed to read partition table".
nbd_readable() {
    "${SUDO[@]}" dd if="$NBD" bs=512 count=1 status=none >/dev/null 2>&1
}

nbd_has_table() {
    [[ -n "$("${SUDO[@]}" blkid -p -s PTTYPE -o value "$NBD" 2>/dev/null)" ]]
}

# nbd_settle -- wait for the kernel's partition scan to land.
#
# qemu-nbd -c returns as soon as the device is sized, but the scan is
# asynchronous and udevadm settle cannot wait for a uevent that has not been
# queued yet. A deep backing chain opens slowly enough that the nodes appear
# after the caller has already globbed for them, which reads as "no partition
# found" on a perfectly good image.
#
# The wait is gated on a partition table actually being there: an image with no
# table has nothing to wait for, and must not stall for the whole timeout.
NBD_SETTLE_TRIES=50          # x 0.2s
nbd_settle() {
    local i
    for (( i = 0; i < NBD_SETTLE_TRIES; i++ )); do
        "${SUDO[@]}" partx -a "$NBD" >/dev/null 2>&1 || true   # force a rescan
        udevadm settle

        nbd_has_parts && return 0
        # Readable with no table: an unpartitioned image, nothing to wait for.
        nbd_readable && ! nbd_has_table && return 0

        sleep 0.2
    done
    # Not fatal here: the caller reports the layout it actually found.
    warn "$NBD still shows no partitions after" \
         "$(( NBD_SETTLE_TRIES / 5 ))s of waiting for the kernel to scan it"
}

# nbd_find_part TYPE... -- the largest partition on $NBD whose filesystem is one
# of TYPE. blkid directly: lsblk's FSTYPE column can lag behind udev.
nbd_find_part() {
    local dev fstype size want=" $* " best=0 part=""
    for dev in "$NBD"p*; do
        [[ -b "$dev" ]] || continue
        fstype="$("${SUDO[@]}" blkid -o value -s TYPE "$dev" 2>/dev/null)"
        [[ -n "$fstype" && "$want" == *" $fstype "* ]] || continue
        size="$("${SUDO[@]}" blockdev --getsize64 "$dev")"
        (( size > best )) && { best="$size"; part="$dev"; }
    done
    printf '%s' "$part"
}

# nbd_part_size DEV -- its size in whole GiB.
nbd_part_size() {
    local bytes; bytes="$("${SUDO[@]}" blockdev --getsize64 "$1" 2>/dev/null || echo 0)"
    printf '%s' "$(( bytes / 1024 / 1024 / 1024 ))"
}
