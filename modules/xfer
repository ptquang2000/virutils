# xfer -- the transport behind sync, pull and push: live, over the guest's own
# NIC. The reason it is the only one is incrementality: the host serves a tree
# on the address the guest already reaches it at, and the guest's own copier
# takes only what differs from what it already holds -- so a re-push of a build
# that changed one file moves one file. Nothing is mounted on either side, no
# device appears in the guest, and the guest keeps running.
#
# There are two servers behind that, one per guest OS, because the copier on the
# far side is whatever the guest actually has:
#
#   xfer_check net -> xfer_smb_serve    -> Windows guest copies with robocopy
#   xfer_check net -> xfer_rsyncd_serve -> Linux guest copies with rsync
#
#   Windows gets SMB because robocopy speaks it and nothing else, which costs a
#   rootful smbd on port 445 -- the one privileged port virutil binds, and not
#   negotiable, since 445 is what SMB means to a Windows client. Linux gets an
#   rsync daemon on an ephemeral port, which needs no root at all and no
#   privileged port to collide with. Direction is the export's, not the
#   transport's: read-only and the guest fetches from it (sync, push), writable
#   and the guest copies into it (pull). See the sections at the foot of this
#   file.

# Escalate only what needs root: under sudo $HOME is root's, so config
# discovery would read /root.
xfer_privilege() {
    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi
}

xfer_running() {
    [[ "$("${VIRSH[@]}" domstate "$1" 2>/dev/null)" == running ]]
}

# xfer_check MODE -- the guest has to be in the right state for the copy about
# to be made. Checked here, up front: the guest's state decides whether the run
# can happen at all, so it is settled before the fetch or any other work that
# would be thrown away.
xfer_check() {
    local mode="$1" dom="$DOMAIN" state
    state="$("${VIRSH[@]}" domstate "$dom" 2>/dev/null)"

    case "$mode" in
        net)
            # Nothing is written to the disk image, so the only requirement is
            # that the guest is up with an agent to drive it. The same for both
            # servers: which one gets stood up is decided by the guest's OS, and
            # neither can be driven without an agent to say "fetch this".
            [[ "$state" == running ]] \
                || die "$dom has to be running for this; it is '$state'." \
                       "The copy goes over the guest's own network and is" \
                       "driven from inside it, so there has to be a guest at" \
                       "the other end. Start it with" \
                       "'virutil domain start $dom'."
            guest_agent_wait "$dom" 5 \
                || die "$dom is running but its QEMU guest agent is not" \
                       "answering, and the agent is what starts the copy" \
                       "inside the guest. Check that qemu-ga is running in the" \
                       "guest."
            ;;
        *) die "internal: xfer_check wants net, got '$mode'" ;;
    esac
}

# --- host-side primitives ---------------------------------------------------

# xfer_host_addr GUEST_IP -- the address the guest reaches this host at, which
# is the source address the kernel would use to reach the guest. Asking the
# routing table settles bridge naming, WSL's networking mode and multi-homing in
# one question. Empty when there is no route at all.
xfer_host_addr() {
    ip -o -4 route get "$1" 2>/dev/null |
        awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

# --- the live path, over SMB -------------------------------------------------
#
# How sync and push deliver. The host serves the
# payload as a live tree and the guest fetches it with robocopy, which compares
# the tree it already has against the one being served and copies only what
# differs -- so a second push of a build where one file changed moves one file,
# and leaves the rest untouched down to their timestamps.
#
#   xfer_smb_serve DIR ADDR -> guest robocopies from \\ADDR\<share>
#
# The agent's own channel could carry these bytes instead, and does not: a
# guest-exec payload is base64 inside JSON inside a single argv entry, which
# Linux caps at 128KB -- about 98KB of file per call, a call per second. The NIC
# does the same work three orders of magnitude faster, so the agent is used only
# to say "fetch this".
#
# Two things this costs. The share is SMB, which for a Windows client means port
# 445, which no ephemeral-port trick can move -- so this binds the one
# privileged port, needs root to do it, and refuses to run if something (on WSL,
# the Windows host's own file sharing) already holds 445. And the bind address
# is load-bearing: this host is on the guest's network and usually on a real one
# as well, so the share goes to the single address that reaches the guest and
# never the wildcard, which would offer it to every network this host is on.
# Nothing is mounted in the guest all the same: robocopy against a UNC path is a
# redirector read, no drive letter and no share of the guest's own.

# The share name the guest is told and nothing else can guess. Not a secret in
# any strong sense -- it is one private network and one transfer long -- but it
# keeps the payload from being reachable by anything else on that network that
# goes looking for shares.
xfer_share_token() {
    local t
    t="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')"
    [[ ${#t} -ge 16 ]] || die "internal: could not generate a transfer token"
    printf '%s' "${t:0:24}"
}

# xfer_room_for BYTES DIR -- refuse a payload that will not fit, before spending
# minutes writing most of it. A tar that runs the filesystem out of space fails
# somewhere less legible than here.
xfer_room_for() {
    local need="$1" dir="$2" free
    free="$(df -B1 --output=avail "$dir" 2>/dev/null | tail -1)" || return 0
    [[ "$free" =~ ^[0-9]+$ ]] || return 0
    (( free > need )) \
        || die "packing this needs about $(fmt_bytes "$need") in $dir and" \
               "there is $(fmt_bytes "$free") free. Point VIRUTILS_TMP_DIR at" \
               "somewhere with room, or push fewer files."
}

# Shared by both live servers, and cleared by xfer_stop however the run ends.
XFER_RUN=""                  # short-path runtime dir for the server's own state
XFER_RUN_ROOT=0              # was anything in it created by a root process?
XFER_STAGE=""                # scratch under VIRUTILS_TMP_DIR for the payload tree

XFER_SMB_PID=""              # the smbd; killed by xfer_stop
XFER_SMB_CONF=""             # the throwaway smb.conf, also our kill key
XFER_SMB_SHARE=""            # the random share name the guest is told
XFER_SMB_UNC=""              # \\ADDR\<share>, the guest's source path

XFER_RSYNCD_PID=""           # the rsync daemon; killed by xfer_stop
XFER_RSYNCD_CONF=""          # the throwaway rsyncd.conf, also our kill key
XFER_RSYNCD_MODULE=""        # the random module name the guest is told
XFER_RSYNCD_PORT=""          # the ephemeral port it was given
XFER_RSYNCD_URL=""           # rsync://ADDR:PORT/<module>, the guest's source path

# 445 cannot be moved for a Windows client, so a listener already on it is a
# hard stop rather than something to work around. On WSL that listener is
# usually the Windows host's own file sharing.
xfer_smb_free() {
    # An if, not `... && die`: on the free path the grep returns non-zero, and a
    # bare function ending on that would trip set -e and abort the whole run --
    # silently, and only ever when the port was actually available.
    if xfer_smb_bound; then
        die "something already holds TCP 445 on this host, and SMB cannot" \
            "be served on any other port to a Windows guest. On WSL this is" \
            "usually the Windows host's own file sharing; stop it and run" \
            "again."
    fi
}

# Where a live server keeps its own state -- conf, log, pid, sockets -- for the
# one transfer it lives for. A short /tmp path rather than the scratch tree
# virutil uses elsewhere, and that is smbd's requirement rather than a
# preference: it opens an AF_UNIX socket under its runtime dirs, whose path is
# capped near 108 bytes, and the usual tree is far too long for that (it is what
# made a first attempt fail with "File name too long"). rsyncd needs none of
# that, and shares the directory anyway so there is one thing to clean up.
xfer_run_dir() {
    [[ -n "$XFER_RUN" ]] && return 0
    XFER_RUN="$(mktemp -d /tmp/vxfer.XXXXXX)" \
        || die "could not create a runtime directory for the transfer"
    trap xfer_stop EXIT
    # An EXIT trap alone does not cover a run killed at the sudo password
    # prompt: the shell dies from the signal and never reaches its exit. That
    # leaves the runtime directory and its conf on disk, which is where the one
    # stray /tmp/vsmb.* this once left behind came from. These handlers do no
    # cleanup of their own -- they only turn the signal into an exit, which is
    # what runs the trap above.
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

# Is anything listening on 445 yet? A function because it is asked three times --
# before the launch, around the launch, and after a failure to launch -- and the
# three must agree on what "taken" means.
xfer_smb_bound() {
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq '[:.]445$'
}

# How long to wait for the bind, in 0.1s steps. smbd binds in about two tenths
# of a second on a warm host; the rest of the budget is for a cold one building
# its tdb databases in a runtime directory that did not exist a moment ago.
XFER_SMB_TRIES=150

# Is the launch still actually running? Not kill -0: a process that has exited
# but has not been reaped still answers that, so a launcher which died on the
# spot would be called alive for the whole wait and then reported as "started
# but never bound" -- with its exit code, the one thing that says what happened,
# never read. An empty state means gone; Z means gone and unreaped.
xfer_smb_alive() {
    local st
    st="$(ps -o stat= -p "$XFER_SMB_PID" 2>/dev/null | tr -d '[:space:]')" || true
    [[ -n "$st" && "$st" != Z* ]]
}

# xfer_smb_nobind ADDR -- smbd was launched and 445 never answered. Everything
# smbd has to say about why is in one of two places and neither is this shell's
# stdout, so both are printed before the run ends: sudo's own complaint and
# smbd's pre-logging errors land in out, and everything after it opens its log
# file lands in there. The runtime directory is removed by the EXIT trap
# immediately after this, which is exactly why the log is quoted here rather
# than pointed at.
# xfer_smb_diag -- what the failing launch looked like from outside, written
# into the runtime directory so the copy below preserves it. This answers the one
# question the launcher's own output cannot: whether sudo ever exec'd smbd at
# all. An isolated harness that reproduces this launch exactly -- same short
# runtime dir, same generated conf, same primed-then-backgrounded sudo -- binds
# every time, so a failure here is something about the surrounding run, and
# narrowing it needs the process tree rather than more of smbd's silence.
xfer_smb_diag() {
    local f="$XFER_RUN/diag"
    {
        echo "== launcher $XFER_SMB_PID"
        ps -o pid,ppid,pgid,sess,tpgid,stat,wchan:25,args -p "$XFER_SMB_PID" 2>&1
        # The split: no smbd process while the launcher lives means sudo never
        # got as far as exec, and nothing smbd could have logged would say so.
        echo "== any smbd on this host"
        pgrep -af smbd 2>&1 || echo "NO smbd PROCESS AT ALL -- sudo never exec'd it"
        echo "== launcher's descendants"
        ps -eo pid,ppid,pgid,sess,stat,wchan:25,args --forest 2>&1 |
            grep -E 'smbd|sudo' 2>&1 || true
        echo "== what the launcher is parked on"
        cat /proc/"$XFER_SMB_PID"/wchan 2>&1; echo
        echo "== listeners"
        ss -ltnp 2>&1
        echo "== is the credential still valid?"
        if [[ -n "${SUDO[*]:-}" ]]; then
            "${SUDO[@]}" -n true 2>&1 && echo "sudo -n OK" || echo "sudo -n REFUSED"
        fi
    } > "$f" 2>&1 || true
}

xfer_smb_nobind() {
    local addr="$1" out log keep rc=0
    # || true on both: a file that was never created makes the *assignment*
    # fail, which under set -e takes the whole run down here -- silently, and
    # only ever on the path whose entire job is to explain a failure.
    out="$(cat "$XFER_RUN/out" 2>/dev/null)" || true
    log="$(tail -n 20 "$XFER_RUN/log" 2>/dev/null)" || true
    [[ -n "$out" ]] && warn "$out"
    [[ -n "$log" ]] && warn "$log"

    # Kept rather than summarised. The EXIT trap removes the runtime directory
    # moments from now, and when the launch says nothing at all -- which is the
    # hard case -- what it left in there is the only evidence there is.
    xfer_smb_diag
    keep="$VIRUTILS_TMP_DIR/smb-failed.$$"
    mkdir -p "$VIRUTILS_TMP_DIR" 2>/dev/null || true
    cp -a "$XFER_RUN" "$keep" 2>/dev/null || true
    [[ -d "$keep" ]] || keep=""

    # An exit needs no timeout to explain it, and its status is readable only
    # once the process is waited for.
    if ! xfer_smb_alive; then
        wait "$XFER_SMB_PID" 2>/dev/null || rc=$?
        die "the smbd launch exited with status $rc without binding" \
            "$addr:445.${out:+ Its own output is above.}" \
            "${keep:+What it left behind is kept at $keep, where out holds its stdout and stderr.}" \
            "Status 1 from sudo means the credential went stale between" \
            "priming it and this launch; anything else is smbd's own." \
            "Run it by hand to see it live:" \
            "  sudo smbd -s $XFER_SMB_CONF -F --no-process-group --debug-stdout"
    fi

    # A listener that appeared between the check at the start and now is a
    # different failure from smbd refusing to start, and reads nothing like it.
    if kill -0 "$XFER_SMB_PID" 2>/dev/null; then
        # A stopped process is its own diagnosis and reads nothing like a slow
        # one: it means something put the launch in the background while it was
        # still touching the terminal, and it will never bind on its own.
        local state=""
        state="$(ps -o stat= -p "$XFER_SMB_PID" 2>/dev/null | tr -d '[:space:]')" || true
        if [[ "$state" == T* ]]; then
            die "the process serving the share is stopped (state $state) and so" \
                "never bound $addr:445 -- it was suspended for touching the" \
                "terminal from the background. This is a virutil bug rather" \
                "than anything about this host; the command that produced it is" \
                "worth reporting.${keep:+ Its runtime state is kept at $keep.}"
        fi
        die "smbd started but has not bound $addr:445 after" \
            "$(( XFER_SMB_TRIES / 10 ))s; whatever it logged is above. On WSL," \
            "check whether the Windows host is holding 445 -- the check this" \
            "run made looks at Linux's own sockets and cannot see Windows'." \
            "${keep:+Its runtime state is kept at $keep, where diag holds the}" \
            "${keep:+process tree at the moment it gave up -- read that first.}"
    fi
    die "smbd exited without binding $addr:445; its own output is above." \
        "If it says nothing, run it by hand to see why:" \
        "  sudo smbd -s $XFER_SMB_CONF -F --no-process-group --debug-stdout"
}

# xfer_smb_serve DIR ADDR [rw] -- export DIR on ADDR:445, once, under a random
# share name, and set XFER_SMB_UNC. Read-only unless the third argument is `rw`,
# which the read direction needs: there the guest is the one doing the writing,
# copying out of its C: into a directory of this host's. Anonymous and
# guest-only either way: the guest reaches it with no credential, and the share
# carries nothing but this transfer's tree. The bind address is ADDR alone, the
# one that reaches the guest -- not the wildcard, which would offer the share to
# every network this host is on, and which a writable share makes a worse idea
# still.
xfer_smb_serve() {
    local dir="$1" addr="$2" mode="${3:-ro}" i readonly=yes

    [[ "$mode" == rw || "$mode" == ro ]] \
        || die "internal: xfer_smb_serve wants ro or rw, got '$mode'"
    [[ "$mode" == rw ]] && readonly=no

    command -v smbd >/dev/null 2>&1 \
        || die "delivering into a running guest serves the payload over SMB" \
               "and needs smbd (the Samba server) on the host; it is not" \
               "installed. Install it and run again."
    # Both the "is 445 taken" check and the "has smbd bound it yet" wait read
    # ss. Without it each would silently answer no, which reads as a free port
    # and then as an smbd that never started -- so it is required outright
    # rather than treated as absent evidence.
    command -v ss >/dev/null 2>&1 \
        || die "the delivery needs ss (iproute2) to tell whether port 445 is" \
               "free and whether smbd has bound it; it is not on PATH." \
               "Install iproute2 and run again."

    xfer_privilege
    xfer_smb_free
    xfer_run_dir
    # smbd will write its log and databases in there as root, so the removal at
    # the end has to be root's too.
    XFER_RUN_ROOT=1
    XFER_SMB_SHARE="$(xfer_share_token)"
    XFER_SMB_CONF="$XFER_RUN/smb.conf"

    # guest account is the invoking user so smbd reads the payload as its owner
    # rather than as nobody; under sudo that is still the real user, since
    # xfer_privilege refuses to run as root-via-sudo in the first place.
    cat > "$XFER_SMB_CONF" <<CONF
[global]
    workgroup = WORKGROUP
    server min protocol = SMB2
    map to guest = Bad User
    guest account = ${SUDO_USER:-$USER}
    security = user
    private dir = $XFER_RUN
    lock directory = $XFER_RUN
    state directory = $XFER_RUN
    cache directory = $XFER_RUN
    pid directory = $XFER_RUN
    ncalrpc dir = $XFER_RUN
    log file = $XFER_RUN/log
    bind interfaces only = yes
    interfaces = lo $addr
    disable netbios = yes
[$XFER_SMB_SHARE]
    path = $dir
    read only = $readonly
    guest ok = yes
    guest only = yes
    create mask = 0644
    directory mask = 0755
CONF

    # smbd runs detached, so sudo cannot prompt once it is in the background:
    # prime the credential up front, synchronously, where the prompt has a
    # terminal to reach.
    if (( ${#SUDO[@]} )); then
        "${SUDO[@]}" -v || die "could not obtain the root privilege needed to bind port 445" \
            "and serve the payload."
    fi
    # --debug-stdout so everything smbd has to say lands in one file this shell
    # owns. Without it, its first messages go to the compiled-in
    # /var/log/samba/log.smbd -- which under sudo it can actually open, so a
    # failure to bind would log there, be unreadable without root, and leave the
    # run reporting "did not come up" with nothing to say about why.
    # -n and </dev/null, because this one runs in the background: there,
    # anything that touches the terminal is a hang and not a prompt. A
    # background process reading the tty is stopped with SIGTTIN, and a stopped
    # sudo never execs smbd -- which is the "started but never bound, and logged
    # nothing" failure this produced whenever the run's output was redirected
    # away from the terminal. The credential was primed above, synchronously,
    # where a prompt could still reach one; by here there is nothing left to ask,
    # so -n turns a stale timestamp into an error instead of a wait.
    local -a launch=("${SUDO[@]}")
    (( ${#SUDO[@]} )) && launch+=(-n)
    launch+=(smbd -s "$XFER_SMB_CONF" -F --no-process-group --debug-stdout)
    "${launch[@]}" >"$XFER_RUN/out" 2>&1 </dev/null &
    XFER_SMB_PID=$!

    # The bind is done when 445 answers; poll for it, and stop early if smbd has
    # already died -- its output holds the reason.
    for (( i = 0; i < XFER_SMB_TRIES; i++ )); do
        xfer_smb_bound && break
        xfer_smb_alive || break
        sleep 0.1
    done
    if ! xfer_smb_bound; then xfer_smb_nobind "$addr"; fi

    XFER_SMB_UNC="\\\\$addr\\$XFER_SMB_SHARE"
}

# xfer_stop -- retire whichever server is up and clear the scratch, however the
# run ends. The EXIT trap is armed in xfer_run_dir; the copy phases also call
# this directly, to put the server away before the cleanup and post rules that
# follow, so every part of it is idempotent and the trap firing afterwards costs
# nothing.
xfer_stop() {
    xfer_smb_kill
    xfer_rsyncd_kill
    xfer_scratch_clear
}

# smbd is root and leaves helper children (notifyd, cleanupd); killing by the
# unique conf path catches the lot, where killing one pid would not. Nothing is
# escalated unless smbd was actually launched: before that the kill has nothing
# to aim at, so a failure that never got as far as binding does not need -- and
# should not noisily attempt -- a root pkill.
xfer_smb_kill() {
    [[ -n "$XFER_SMB_PID" ]] || return 0
    [[ -n "$XFER_SMB_CONF" ]] \
        && { "${SUDO[@]}" pkill -f "smbd -s $XFER_SMB_CONF" 2>/dev/null || true; }
    XFER_SMB_PID=""; XFER_SMB_CONF=""
}

# rsyncd is this user's own process and forks a child per connection, so the
# same kill-by-unique-conf catches the parent and any child still draining one.
# No sudo anywhere in it: an unprivileged port needed none to bind, and asking
# for root to clean up after something that never had it would be its own bug.
xfer_rsyncd_kill() {
    [[ -n "$XFER_RSYNCD_PID" ]] || return 0
    [[ -n "$XFER_RSYNCD_CONF" ]] \
        && { pkill -f "rsync --daemon --no-detach --config=$XFER_RSYNCD_CONF" \
                 2>/dev/null || true; }
    XFER_RSYNCD_PID=""; XFER_RSYNCD_CONF=""
}

# The runtime directory and the payload tree. Whether removing the first needs
# root is not a guess: smbd runs as root and writes its log and tdb databases in
# there as root, so the invoking user cannot unlink them afterwards -- while
# rsyncd wrote its own as that user, and must not be sudo'd for. XFER_RUN_ROOT
# is set by whichever server actually escalated.
xfer_scratch_clear() {
    if [[ -n "$XFER_RUN" && -d "$XFER_RUN" ]]; then
        if (( XFER_RUN_ROOT )); then
            "${SUDO[@]}" rm -rf "$XFER_RUN" || true
        else
            rm -rf "$XFER_RUN"
        fi
    fi
    [[ -n "$XFER_STAGE" && -d "$XFER_STAGE" ]] && rm -rf "$XFER_STAGE"
    XFER_RUN=""; XFER_RUN_ROOT=0; XFER_STAGE=""
}

# --- the live path, over an rsync daemon --------------------------------------
#
# How sync delivers into a running Linux guest. Same shape as the SMB path
# above -- the host serves the payload tree on the address the guest already
# reaches it at, and the guest's own copier takes only what differs -- with a
# different server behind it, because a Linux guest has rsync and does not have
# robocopy.
#
#   xfer_rsyncd_serve DIR ADDR -> guest rsyncs from rsync://ADDR:PORT/<module>
#
# This is the cheaper of the two transports, and every way in which it is
# cheaper comes from one thing: rsync's port is not fixed. SMB has to be 445 to
# a Windows client, which is what makes the other path bind a privileged port,
# escalate to do it, need a terminal to prime the credential on, and refuse to
# run when the Windows host's own file sharing already holds 445. An rsync
# daemon takes any port at all, so this asks for no root, prompts for nothing,
# and cannot collide with what is already listening. It is also a real delta
# transfer rather than a timestamp comparison, and no mount, device or share
# appears in the guest either way.
#
# The module name is the same one-transfer random token the SMB share uses, and
# for the same reason: the export is anonymous, so what keeps it from being
# reachable by anything else on that network is that nothing else can name it.
# `list = no` keeps it out of a module listing as well.

# How long to wait for the bind, in 0.1s steps. rsyncd binds immediately -- it
# has no databases to build, which is what most of the SMB budget is for -- so
# this is short and is really only here to cover a loaded host.
XFER_RSYNCD_TRIES=50

# Is anything listening on PORT?
xfer_port_bound() {
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$1\$"
}

# A free port in the ephemeral-but-unregistered range, or nothing. Checked
# before the bind rather than after a failure, because "address already in use"
# from rsyncd says nothing about which port it wanted.
#
# There is an unavoidable race between the check and the bind, and it is
# harmless: something else taking the port in that window fails this transfer
# with rsyncd's own message and no other side effect, where the same race on 445
# would be a privileged bind fighting over the one port SMB can use.
xfer_pick_port() {
    local i port
    for (( i = 0; i < 64; i++ )); do
        port=$(( 20000 + RANDOM % 20000 ))
        xfer_port_bound "$port" || { printf '%s' "$port"; return 0; }
    done
    return 1
}

# xfer_rsyncd_serve DIR ADDR [rw] -- export DIR on ADDR at an ephemeral port,
# once, under a random module name, and set XFER_RSYNCD_URL. Read-only unless
# the third argument is `rw`. The bind address is ADDR alone, the one that
# reaches the guest -- not the wildcard, which would offer the export to every
# network this host is on, and which a writable export makes a worse idea still.
xfer_rsyncd_serve() {
    local dir="$1" addr="$2" mode="${3:-ro}" i readonly=yes

    [[ "$mode" == rw || "$mode" == ro ]] \
        || die "internal: xfer_rsyncd_serve wants ro or rw, got '$mode'"
    [[ "$mode" == rw ]] && readonly=no

    command -v rsync >/dev/null 2>&1 \
        || die "delivering into a running Linux guest serves the payload from" \
               "an rsync daemon and needs rsync on the host; it is not" \
               "installed."
    command -v ss >/dev/null 2>&1 \
        || die "the delivery needs ss (iproute2) to find a free port to serve" \
               "the payload on, and to tell whether the daemon has bound it;" \
               "it is not on PATH. Install iproute2."

    XFER_RSYNCD_PORT="$(xfer_pick_port)" \
        || die "could not find a free port to serve the payload on after 64" \
               "tries, which means something on this host is listening on" \
               "most of 20000-40000. Nothing was served."

    xfer_run_dir
    XFER_RSYNCD_MODULE="$(xfer_share_token)"
    XFER_RSYNCD_CONF="$XFER_RUN/rsyncd.conf"

    # No uid/gid: those are for a daemon started as root, which drops to them.
    # This one is already the invoking user, so it reads the payload as its
    # owner and any setuid directive would only be refused. `use chroot = no`
    # for the same reason -- chroot is root's to call -- and it costs nothing
    # here, since the export is one directory this run just built.
    #
    # `reverse lookup = no` because the log line is the only thing that would
    # use the name, and a host with no reverse zone for its guest network makes
    # every connection wait on a DNS timeout to write it.
    cat > "$XFER_RSYNCD_CONF" <<CONF
port = $XFER_RSYNCD_PORT
address = $addr
use chroot = no
reverse lookup = no
max connections = 4
log file = $XFER_RUN/log
pid file = $XFER_RUN/pid
lock file = $XFER_RUN/lock

[$XFER_RSYNCD_MODULE]
    path = $dir
    read only = $readonly
    list = no
    timeout = 600
CONF

    # Backgrounded and never escalated, so unlike the SMB launch there is no
    # credential to prime, nothing that can be stopped by touching the terminal
    # from the background, and no reason for this to need a terminal at all --
    # which is what makes the Linux path the one that works unattended.
    rsync --daemon --no-detach --config="$XFER_RSYNCD_CONF" \
        >"$XFER_RUN/out" 2>&1 </dev/null &
    XFER_RSYNCD_PID=$!

    for (( i = 0; i < XFER_RSYNCD_TRIES; i++ )); do
        xfer_port_bound "$XFER_RSYNCD_PORT" && break
        kill -0 "$XFER_RSYNCD_PID" 2>/dev/null || break
        sleep 0.1
    done
    if ! xfer_port_bound "$XFER_RSYNCD_PORT"; then xfer_rsyncd_nobind "$addr"; fi

    XFER_RSYNCD_URL="rsync://$addr:$XFER_RSYNCD_PORT/$XFER_RSYNCD_MODULE"
}

# xfer_rsyncd_nobind ADDR -- the daemon was launched and its port never
# answered. Everything it has to say is in one of two files this shell owns, so
# both are quoted here rather than pointed at: the EXIT trap removes the runtime
# directory immediately after this returns.
xfer_rsyncd_nobind() {
    local addr="$1" out log rc=0
    out="$(cat "$XFER_RUN/out" 2>/dev/null)" || true
    log="$(tail -n 20 "$XFER_RUN/log" 2>/dev/null)" || true
    [[ -n "$out" ]] && warn "$out"
    [[ -n "$log" ]] && warn "$log"

    if ! kill -0 "$XFER_RSYNCD_PID" 2>/dev/null; then
        wait "$XFER_RSYNCD_PID" 2>/dev/null || rc=$?
        die "the rsync daemon exited with status $rc without binding" \
            "$addr:$XFER_RSYNCD_PORT.${out:+ Its own output is above.}" \
            "Run it by hand to see it live:" \
            "  rsync --daemon --no-detach --config=$XFER_RSYNCD_CONF"
    fi
    die "the rsync daemon started but has not bound $addr:$XFER_RSYNCD_PORT" \
        "after $(( XFER_RSYNCD_TRIES / 10 ))s; whatever it logged is above." \
        "Nothing was delivered."
}
