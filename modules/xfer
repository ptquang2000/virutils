# xfer -- the transport layer behind sync, pull and push
#
# Write direction:  xfer_open -> caller writes into $MNT -> xfer_deliver -> xfer_close
# Read direction:   xfer_open_read -> xfer_collect PAT... -> caller reads $MNT -> xfer_close
#
# MNT always stands for the root of the guest's C:. For the disk transport it
# *is* C:, so xfer_deliver is a no-op.

XFER=""            # the resolved backend: disk, volume or virtiofs
XFER_MODE=""       # write or read
XFER_ARMED=0       # whether the EXIT trap has anything to undo

XFER_DEFAULT=virtiofs

# Both halves find the staging volume and the share by name, so these are part
# of the protocol. 11 characters: the exFAT label limit.
XFER_LABEL="VIRUTILXFER"
XFER_TAG="virutil-xfer"

xfer_transport_help() {
    printf '%s\n' \
        "  -t, --transport T       how to move the files (default: $XFER_DEFAULT):" \
        "                            virtiofs  a live virtio-fs share" \
        "                            volume    a staging qcow2 hotplugged into" \
        "                                      the running guest" \
        "                            disk      the guest's own disk over" \
        "                                      qemu-nbd (a write shuts it down)"
}

# Escalate only what needs root: under sudo $HOME is root's, so config
# discovery would read /root.
xfer_privilege() {
    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi
}

xfer_running() {
    [[ "$("${VIRSH[@]}" domstate "$1" 2>/dev/null)" == running ]]
}

# guest-ping, not the channel's XML state: the channel reads 'connected' with
# nothing listening on the other side.
xfer_agent_ok() {
    "${VIRSH[@]}" qemu-agent-command "$1" '{"execute":"guest-ping"}' \
        >/dev/null 2>&1
}

# xfer_select MODE REQUEST -- validate the transport before anything is touched.
# No fallback: a transport that cannot work is an error naming the fix, never a
# silent downgrade that turns "copy a file" into "reboot Windows".
xfer_select() {
    XFER_MODE="$1"
    local want="${2:-$XFER_DEFAULT}" dom="$DOMAIN"

    case "$want" in
        disk|volume|virtiofs) ;;
        *) die "unknown transport: $want (disk, volume or virtiofs)" ;;
    esac

    case "$want" in
        volume|virtiofs)
            xfer_running "$dom" \
                || die "--transport $want needs $dom running; it is" \
                       "'$("${VIRSH[@]}" domstate "$dom" 2>/dev/null)'." \
                       "Start it, or use --transport disk."
            xfer_agent_ok "$dom" \
                || die "--transport $want needs the qemu guest agent in $dom," \
                       "which is what runs the copy inside it. Install the" \
                       "guest-agent MSI from the virtio-win ISO (see the guest" \
                       "prerequisites in README.md), or use --transport disk."
            command -v jq >/dev/null \
                || die "jq not installed; --transport $want talks to the guest agent"
            ;;
    esac

    XFER="$want"
    echo "transport: $XFER"
}

# --- dispatch ---------------------------------------------------------------
#
# One EXIT trap for the whole run, armed by whichever open() succeeded. Backend
# state lives at module scope: the trap fires after the main has returned.

xfer_open() {
    XFER_MODE=write
    case "$XFER" in
        disk)     guest_open ;;          # arms its own trap; see modules/guest
        volume)   volume_open write ;;
        virtiofs) virtiofs_open write ;;
    esac
}

xfer_open_read() {
    XFER_MODE=read
    case "$XFER" in
        volume)   volume_open read ;;
        virtiofs) virtiofs_open read ;;
        *)        die "internal: xfer_open_read is not for the $XFER transport" ;;
    esac
}

xfer_deliver() {
    case "$XFER" in
        disk)     ;;                     # MNT is C: -- already delivered
        volume)   volume_deliver ;;
        virtiofs) virtiofs_deliver ;;
    esac
}

xfer_collect() {
    case "$XFER" in
        volume)   volume_collect "$@" ;;
        virtiofs) virtiofs_collect "$@" ;;
        *)        die "internal: xfer_collect is not for the $XFER transport" ;;
    esac
}

xfer_close() {
    case "$XFER" in
        volume)   volume_close ;;
        virtiofs) virtiofs_close ;;
    esac
}

# --- host-side primitives ---------------------------------------------------

# max_part only takes effect at module load, so a module already up without it
# has to be reloaded or the partition nodes never appear.
nbd_reload() {
    if [[ ! -e /sys/module/nbd/parameters/max_part ]] \
       || (( $(< /sys/module/nbd/parameters/max_part) < 1 )); then
        "${SUDO[@]}" rmmod nbd 2>/dev/null || true
        "${SUDO[@]}" modprobe nbd max_part=8
    fi
}

# nbd_connect IMG [-r] -- attach IMG at $NBD and settle the partition table.
nbd_connect() {
    local img="$1" ro="${2:-}"
    nbd_reload
    "${SUDO[@]}" qemu-nbd ${ro:+-r} -c "$NBD" "$img"
    nbd_settle
}

# Does $NBD have at least one partition node yet?
nbd_has_parts() {
    local dev
    for dev in "$NBD"p*; do [[ -b "$dev" ]] && return 0; done
    return 1
}

# Is $NBD serving reads? Straight after qemu-nbd -c it may be sized but not yet
# answering: that is what makes partx report "failed to read partition table".
nbd_readable() {
    "${SUDO[@]}" dd if="$NBD" bs=512 count=1 status=none >/dev/null 2>&1
}

nbd_has_table() {
    [[ -n "$("${SUDO[@]}" blkid -p -s PTTYPE -o value "$NBD" 2>/dev/null)" ]]
}

# nbd_settle -- wait for the kernel's partition scan to land.
#
# qemu-nbd -c returns as soon as the device is sized, but the scan is
# asynchronous and udevadm settle cannot wait for a uevent that has not been
# queued yet. A deep backing chain opens slowly enough that the nodes appear
# after the caller has already globbed for them, which reads as "no partition
# found" on a perfectly good image.
#
# The wait is gated on a partition table actually being there: volume_create
# probes a freshly made, still-unpartitioned image, and that must not stall for
# the whole timeout.
NBD_SETTLE_TRIES=50          # x 0.2s
nbd_settle() {
    local i
    for (( i = 0; i < NBD_SETTLE_TRIES; i++ )); do
        "${SUDO[@]}" partx -a "$NBD" >/dev/null 2>&1 || true   # force a rescan
        udevadm settle

        nbd_has_parts && return 0
        # Readable with no table: an unpartitioned image, nothing to wait for.
        nbd_readable && ! nbd_has_table && return 0

        sleep 0.2
    done
    # Not fatal here: the caller reports the layout it actually found.
    warn "$NBD still shows no partitions after" \
         "$(( NBD_SETTLE_TRIES / 5 ))s of waiting for the kernel to scan it"
}

# nbd_find_part TYPE... -- the largest partition on $NBD whose filesystem is one
# of TYPE. blkid directly: lsblk's FSTYPE column can lag behind udev.
nbd_find_part() {
    local dev fstype size want=" $* " best=0 part=""
    for dev in "$NBD"p*; do
        [[ -b "$dev" ]] || continue
        fstype="$("${SUDO[@]}" blkid -o value -s TYPE "$dev" 2>/dev/null)"
        [[ -n "$fstype" && "$want" == *" $fstype "* ]] || continue
        size="$("${SUDO[@]}" blockdev --getsize64 "$dev")"
        (( size > best )) && { best="$size"; part="$dev"; }
    done
    printf '%s' "$part"
}

# nbd_part_size DEV -- its size in whole GiB.
nbd_part_size() {
    local bytes; bytes="$("${SUDO[@]}" blockdev --getsize64 "$1" 2>/dev/null || echo 0)"
    printf '%s' "$(( bytes / 1024 / 1024 / 1024 ))"
}

# --- guest-side primitives --------------------------------------------------

# xfer_ps SCRIPT -- run SCRIPT in the guest via modules/exec. Bash scoping is
# dynamic, so VM set here reaches gexec().
xfer_ps() {
    VM="$DOMAIN"
    DETACH=0
    exec_ps_text "$1"
}

# The letter Windows gave a volume, by label, or nothing. Polled: a hotplugged
# disk takes a moment to be enumerated and assigned one. Also brings the disk
# online (Windows' SAN policy) and assigns a letter if it came up without one.
#
# Both of those are scoped to the staging disk. Windows keeps an online state
# and a letter assignment in the registry, so doing either to a disk a file copy
# was not asked to touch is a permanent change to the guest.
xfer_drive_letter() {
    local tries="${1:-30}"
    xfer_ps '
$deadline = (Get-Date).AddSeconds('"$tries"')
do {
  $v = Get-Volume -FileSystemLabel "'"$XFER_LABEL"'" -ErrorAction SilentlyContinue |
       Select-Object -First 1
  if ($v -and $v.DriveLetter) { Write-Output $v.DriveLetter; exit 0 }

  # By serial, then by the labelled volume -- never the RAW fallback, which
  # names any unformatted disk and so is not an identity.
  $disk = Get-Disk -ErrorAction SilentlyContinue |
          Where-Object { $_.SerialNumber -like "*'"$XFER_LABEL"'*" } | Select-Object -First 1
  if (-not $disk -and $v) {
    # Matched on the volume path: the volume has no letter to look it up by yet.
    $disk = Get-Partition -ErrorAction SilentlyContinue |
            Where-Object { $_.AccessPaths -contains $v.Path } |
            Get-Disk -ErrorAction SilentlyContinue | Select-Object -First 1
  }

  if ($disk) {
    if ($disk.IsOffline) {
      try { Set-Disk -Number $disk.Number -IsOffline $false -ErrorAction Stop } catch {}
    }
    if ($v -and -not $v.DriveLetter) {
      try {
        Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |
          Where-Object { -not $_.DriveLetter -and $_.Type -ne "Reserved" } |
          Add-PartitionAccessPath -AssignDriveLetter -ErrorAction Stop
      } catch {}
    }
  }
  Start-Sleep -Milliseconds 500
} while ((Get-Date) -lt $deadline)
exit 1' 2>/dev/null | tr -d '[:space:]'
}

# Doubling is how a single quote is escaped in a powershell literal.
xfer_ps_quote() { printf '%s' "${1//\'/\'\'}"; }

# xfer_empty_guest_dirs PATTERN... -- sync's cleanup rules, run inside the guest
# (the live transports hold what we are *sending*, not the guest's C:).
# Two levels down minimum, so a mistyped pattern cannot empty C:\.
xfer_empty_guest_dirs() {
    local pat script rel sep=""
    script='$ErrorActionPreference = "Stop"
foreach ($p in @('
    for pat in "$@"; do
        rel="${pat#/}"; rel="${rel%/}"
        [[ "$rel" == */* ]] \
            || { warn "refusing unsafe cleanup pattern (too shallow): $pat"; continue; }
        [[ "$rel" == *..* ]] \
            && { warn "refusing unsafe cleanup pattern: $pat"; continue; }
        script+="$sep'$(xfer_ps_quote "${rel//\//\\}")'"; sep=","
    done
    script+=')) {
  foreach ($d in @(Get-Item -Path (Join-Path "C:\" $p) -ErrorAction SilentlyContinue)) {
    if (-not $d.PSIsContainer) { continue }
    $n = @(Get-ChildItem -LiteralPath $d.FullName -Force -Recurse -ErrorAction SilentlyContinue).Count
    Get-ChildItem -LiteralPath $d.FullName -Force -ErrorAction SilentlyContinue |
      Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
    Write-Output "   emptied $($d.FullName) ($n entries)"
  }
}
exit 0'
    xfer_ps "$script" || warn "some cleanup rules failed inside $DOMAIN"
}

# A powershell fragment leaving the staging disk in $disk, or $null. Three
# probes, because none holds alone: virtio-blk does not always surface libvirt's
# <serial>, a fresh image has no label, and 'the raw one' only holds while
# nothing else is unformatted.
xfer_ps_find_disk() {
    printf '%s' '
$disk = Get-Disk | Where-Object { $_.SerialNumber -like "*'"$XFER_LABEL"'*" } | Select-Object -First 1
if (-not $disk) {
  $v = Get-Volume -FileSystemLabel "'"$XFER_LABEL"'" -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($v -and $v.DriveLetter) {
    $disk = Get-Partition -DriveLetter $v.DriveLetter -ErrorAction SilentlyContinue |
            Get-Disk -ErrorAction SilentlyContinue | Select-Object -First 1
  }
}
if (-not $disk) {
  $disk = Get-Disk | Where-Object { $_.PartitionStyle -eq "RAW" } | Select-Object -First 1
}
'
}

# xfer_robocopy SRC DST [EXTRA...] -- a whole-tree copy inside the guest.
# robocopy's exit code is a bit field, not a status: under 8 is success.
xfer_robocopy() {
    local src="$1" dst="$2"; shift 2
    local extra="" a
    for a in "$@"; do extra+=" '$a'"; done
    xfer_ps '
$out = robocopy "'"$src"'" "'"$dst"'" /E /NJH /NJS /NP /NDL /R:1 /W:1 /XD "System Volume Information" "`$RECYCLE.BIN"'"$extra"'
$rc = $LASTEXITCODE
$out | Where-Object { $_ -match "\S" } | Select-Object -Last 12
if ($rc -ge 8) { throw "robocopy failed with code $rc" }
exit 0'
}
