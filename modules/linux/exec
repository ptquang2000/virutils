# exec -- run commands inside a guest via the QEMU guest agent.
#
#   virutil exec ping VM                 check that the guest agent is responding
#   virutil exec cmd  VM [-d] CMD...     run CMD via cmd.exe /c        (Windows)
#   virutil exec ps   VM [-d] SCRIPT...  run SCRIPT via powershell     (Windows)
#   virutil exec sh   VM [-d] SCRIPT...  run SCRIPT via /bin/sh -c     (Linux)
#
# Which of the three a guest answers to is the guest's business, not the agent's:
# guest-exec carries a path and an argv either way, so the only thing that
# differs is what is on the other side to receive it. Nothing here probes for it
# -- the caller knows which guest it is addressing, and sync learns it from
# @guest in its config.
#
# Commands run as SYSTEM on Windows and as root on Linux -- qemu-ga is a service
# in both cases -- and the guest exit code becomes ours. Flags sit between
# the VM name and the command; parsing stops at the first non-flag, and `--`
# forces the end of flags so a command may start with `-`.
#
# stdin is overloaded, disambiguated by whether `-` sits in the command slot:
#   virutil exec ps VM -           the script is read from stdin
#   echo x | virutil exec ps VM C  stdin becomes the guest process's stdin,
#                                  buffered whole and EOF'd immediately, so it
#                                  cannot answer an interactive prompt

# Windows caps a command line at 32767 chars; cmd.exe caps itself far lower.
# Enforced host-side: overflowing them fails in the guest as an
# unrelated-looking spawn error.
CMDLINE_MAX=32767
CMD_EXE_MAX=8191

# Linux has no command-line limit to speak of, but it does cap a single argv
# entry at MAX_ARG_STRLEN -- 32 pages, which is 128KB on every architecture
# virutil runs on. A sh script is passed as one such entry, so this is the
# ceiling that matters, and it is enforced host-side for the same reason the
# Windows ones are: over it, execve fails in the guest as E2BIG, which surfaces
# as an unrelated-looking spawn error rather than as "your script is too long".
SH_ARG_MAX=131072

DETACH=0
INPUT_B64=

exec_usage() {
    printf '%s\n' \
        "usage: virutil exec {ping|cmd|ps|sh} VM [FLAGS] [ARGS]" \
        "" \
        "  cmd, ps        a Windows guest; sh a Linux one." \
        "" \
        "  -d, --detach   fire and forget: print the guest pid and exit 0." \
        "                 No output and no exit code, but the command survives" \
        "                 the channel dropping -- the only way to run a reboot" \
        "                 or a long installer. ps starts it through a launcher," \
        "                 so it cannot be handed stdin." \
        "  --             end of flags" \
        "  -              read the command from stdin" \
        "  -h, --help     this message" >&2
    exit "${1:-1}"
}

# agent JSON -> stdout; dies on an agent-level error rather than feeding jq garbage
agent() {
    local reply
    reply=$("${VIRSH_Q[@]}" qemu-agent-command "$VM" "$1" 2>&1) || true
    case "$reply" in
        *'"error"'*|error:*) echo "$reply" >&2; exit 1 ;;
    esac
    echo "$reply"
}

# flags -> DETACH, remainder -> E_REST
parse_flags() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --detach|-d) DETACH=1; shift ;;
            --)          shift; break ;;
            -)           break ;;
            -*)          echo "virutil exec: unknown flag: $1 (use -- to end flags)" >&2; exit 1 ;;
            *)           break ;;
        esac
    done
    E_REST=("$@")
}

# command text -> TEXT, host stdin -> INPUT_B64
resolve_text() {
    [ $# -gt 0 ] || return 1
    if [ $# -eq 1 ] && [ "$1" = "-" ]; then
        TEXT=$(cat)
    else
        TEXT="$*"
        [ -t 0 ] || INPUT_B64=$(base64 -w0)
    fi
}

# powershell serialises its error stream as CLIXML whenever stderr is
# redirected; only errors outside the ps wrapper's reach get here. Passes the
# raw text through when python3 is missing rather than depending on it.
declixml() {
    command -v python3 >/dev/null 2>&1 || { cat; return; }
    python3 -c '
import re, sys, xml.etree.ElementTree as ET
d = sys.stdin.read()
if not d.startswith("#< CLIXML"):
    sys.stdout.write(d); sys.exit()
try:
    root = ET.fromstring(d.split("\n", 1)[1])
except ET.ParseError:
    sys.stdout.write(d); sys.exit()
t = "".join(e.text or "" for e in root.iter() if e.tag.rpartition("}")[2] == "S")
sys.stdout.write(re.sub(r"_x([0-9A-Fa-f]{4})_", lambda m: chr(int(m.group(1), 16)), t))
'
}

# --- qemu-ga's exec records -------------------------------------------------
#
# qemu-ga keeps one record per guest-exec and drops it only when a
# guest-exec-status call finds that process finished. It looks a record up by
# pid and answers from the *first* match (qga/commands.c,
# guest_exec_info_find), and it closes the process handle as soon as the process
# exits, so the guest is free to hand that pid to a new process while the
# record is still there. A record nobody polled -- an `exec -d`, or a poll that
# was killed or gave up -- therefore answers the next guest-exec that is given
# the same pid: "exited", its own exit code, no output. Windows reuses pids
# quickly, whichever host drives it; Linux hands them out in sequence and reuses
# them far more slowly. That made a sync report "all already current" while its
# delivery never ran (docs/qga-exec-records.md). The same three defences as the
# Windows driver's (modules/win/exec.ps1), here:
#
#   * every call this host does not poll to the end is written down, per VM,
#     and reaped -- polled once more -- before the next exec on that VM;
#   * ps and sh calls print a per-call nonce as their first line, so an answer
#     from someone else's record is recognised and the poll goes on;
#   * `exec ps -d` starts its script through a launcher that is itself polled
#     to its end (exec_ps_detached), so it leaves no record at all.

GEXEC_NONCE_PREFIX='virutil-call '

# gexec_nonce -- 32 hex characters, fresh per call.
gexec_nonce() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }

# The ledger: one empty file per guest pid this host may have left a record
# for, named <guest pid>.<owner>. The owner is the host process polling it --
# the run's $$, which a $(...) inside it shares -- or 0 for a detached call
# nobody will poll. Files rather than one list so that concurrent runs never
# rewrite each other's entries. The same directory the Windows driver uses.
gexec_ledger_dir() { printf '%s/%s.exec' "$VIRUTILS_IMAGE_DIR" "$VM"; }

# gexec_ledger_add PID OWNER -- write the entry, its path on stdout. Best
# effort: a ledger that cannot be written costs the reaping, not the call.
gexec_ledger_add() {
    local dir file
    dir="$(gexec_ledger_dir)"
    file="$dir/$1.$2"
    if mkdir -p -- "$dir" 2>/dev/null && : 2>/dev/null >"$file"; then
        printf '%s' "$file"
    fi
    return 0
}

# gexec_owner_alive OWNER -- is OWNER still a live poller? No for 0
# (detached), and no for this run itself: a run polls one call at a time, so
# nothing of its own is mid-poll while it reaps, and an entry it still holds is
# one an earlier call abandoned.
gexec_owner_alive() {
    local o=$(( 10#$1 ))
    (( o > 0 && o != $$ )) || return 1
    kill -0 "$o" 2>/dev/null && return 0
    # kill -0 fails on another user's live process too; ps tells that apart
    # from one that is gone.
    ps -p "$o" >/dev/null 2>&1
}

# gexec_status PID -- one guest-exec-status. The reply on stdout and 0; 3 when
# the agent has no record for PID any more ("PID N does not exist", or the
# generic "Invalid parameter 'pid'", QERR_INVALID_PARAMETER, which an older
# agent may answer with); 1 for every other refusal, which is reported.
gexec_status() {
    local req err rc=0
    req="$(jq -nc --argjson pid "$1" '{execute:"guest-exec-status",arguments:{pid:$pid}}')"
    # stdout passes straight through; stderr is caught to be read.
    { err="$(agent "$req" 2>&1 1>&3 3>&-)"; } 3>&1 || rc=$?
    if (( rc == 0 )); then
        if [[ -n "$err" ]]; then printf '%s\n' "$err" >&2; fi
        return 0
    fi
    case "$err" in
        *'does not exist'*|*"Invalid parameter 'pid'"*) return 3 ;;
    esac
    printf '%s\n' "$err" >&2
    return 1
}

# gexec_exited STATUS -- does this answer say the process has finished?
gexec_exited() { [ "$(jq -r '.return.exited' <<<"$1" 2>/dev/null)" = true ]; }

# gexec_reap -- poll each of $VM's ledger entries whose owner is gone, once. A
# finished record is dropped by that poll and its entry with it; a process
# still running keeps its entry for the next reap. Quiet and never fatal: the
# call that follows reports any trouble with the agent itself.
gexec_reap() {
    local dir f name st rc
    dir="$(gexec_ledger_dir)"
    [ -d "$dir" ] || return 0
    for f in "$dir"/*; do
        name="${f##*/}"
        [[ "$name" =~ ^([0-9]+)\.([0-9]+)$ ]] || continue
        if gexec_owner_alive "${BASH_REMATCH[2]}"; then continue; fi
        rc=0
        st="$(gexec_status "${BASH_REMATCH[1]}" 2>/dev/null)" || rc=$?
        case "$rc" in
            0) gexec_exited "$st" || continue ;;
            3) ;;
            *) return 0 ;;
        esac
        rm -f -- "$f" 2>/dev/null || true
    done
    return 0
}

# gexec_wait PID [FIRST] -- poll until a status says exited, and print that
# one; starts from FIRST when one is already in hand. Backoff: a one-liner
# returns at once, an installer runs for minutes.
gexec_wait() {
    local pid="$1" st="${2:-}" ms=50 rc
    while :; do
        if [ -z "$st" ]; then
            rc=0; st="$(gexec_status "$pid")" || rc=$?
            if (( rc == 3 )); then
                echo "virutil: $VM's guest agent dropped pid $pid before it was seen to finish" >&2
            fi
            (( rc == 0 )) || return 1
        fi
        if gexec_exited "$st"; then printf '%s\n' "$st"; return 0; fi
        sleep "$(printf '%d.%03d' $((ms / 1000)) $((ms % 1000)))"
        ms=$(( ms * 3 / 2 < 1000 ? ms * 3 / 2 : 1000 ))
        st=""
    done
}

# gexec_has_nonce STATUS NONCE -- does this answer's stdout start with the line
# this call's wrapper prints first?
gexec_has_nonce() {
    local out first
    out="$(jq -r '.return["out-data"] // empty' <<<"$1")"
    [ -n "$out" ] || return 1
    first="$(base64 -d <<<"$out" | sed -n 1p | tr -d '\r')"
    first="${first#$'\xef\xbb\xbf'}"
    first="${first#"${first%%[![:space:]]*}"}"
    first="${first%"${first##*[![:space:]]}"}"
    [ "$first" = "$GEXEC_NONCE_PREFIX$2" ]
}

# --- running one thing ------------------------------------------------------

# gexec PATH ARGS_JSON [NONCE] -- wait for completion, print out/err, return
# the guest exit code; honours DETACH and INPUT_B64. With NONCE, the answer
# has to start with that call's nonce line, which is stripped (see "qemu-ga's
# exec records" above).
gexec() {
    local path="$1" argv="$2" nonce="${3:-}" pid st next rc ledger strip=0
    local out err errtext ec sig args

    # Before this call's own guest-exec, so a record an earlier call left can
    # no longer answer for this one's pid.
    gexec_reap

    args=$(jq -nc --arg p "$path" --argjson a "$argv" \
        --argjson cap "$([ "$DETACH" = 1 ] && echo false || echo true)" \
        --arg i "$INPUT_B64" \
        '{execute:"guest-exec",arguments:
            ({path:$p,arg:$a,"capture-output":$cap}
             + (if $i == "" then {} else {"input-data":$i} end))}')
    pid="$(agent "$args" | jq -r '.return.pid // empty')" || true
    [[ "$pid" =~ ^[0-9]+$ ]] || exit 1

    if [ "$DETACH" = 1 ]; then
        # Nobody polls a detached call, so its record would outlive it.
        gexec_ledger_add "$pid" 0 >/dev/null
        echo "$pid"
        return 0
    fi

    # Written before the first poll and removed only once the record has been
    # consumed -- not in a trap: a call that is killed or gives up has left the
    # record behind, and that is exactly what the entry is for.
    ledger="$(gexec_ledger_add "$pid" "$$")"
    st="$(gexec_wait "$pid")" || exit 1

    # A finished answer without this call's nonce is either an older record
    # with the same pid, which that answer has just dropped, or this call's own
    # process having exited before its wrapper printed anything. The next
    # status tells them apart: no record left means it was ours.
    if [ -n "$nonce" ]; then
        while :; do
            if gexec_has_nonce "$st" "$nonce"; then strip=1; break; fi
            rc=0; next="$(gexec_status "$pid")" || rc=$?
            if (( rc == 3 )); then break; fi
            (( rc == 0 )) || exit 1
            echo "virutil: $VM: pid $pid first answered for an earlier process" \
                 "with the same pid; waiting for this one" >&2
            st="$(gexec_wait "$pid" "$next")" || exit 1
        done
    fi
    if [ -n "$ledger" ]; then rm -f -- "$ledger" 2>/dev/null || true; fi

    # \r stripped so windows output pipes cleanly into unix tools
    out=$(jq -r '.return["out-data"] // empty' <<<"$st")
    err=$(jq -r '.return["err-data"] // empty' <<<"$st")
    if [ -n "$out" ]; then
        if (( strip )); then
            base64 -d <<<"$out" | sed 1d | tr -d '\r' | sed 's/[[:space:]]*$//'
        else
            base64 -d <<<"$out" | tr -d '\r' | sed 's/[[:space:]]*$//'
        fi
    fi
    if [ -n "$err" ]; then
        errtext=$(base64 -d <<<"$err")
        case "$errtext" in
            '#< CLIXML'*) printf '%s\n' "$errtext" | declixml | tr -d '\r' | sed 's/[[:space:]]*$//' >&2 ;;
            *)            printf '%s\n' "$errtext" | tr -d '\r' | sed 's/[[:space:]]*$//' >&2 ;;
        esac
    fi

    # guest-exec-status carries `signal` instead of `exitcode` when the guest
    # process was killed by one. Reported as a shell reports a signalled child,
    # so a caller branching on the code sees what `bash -c` would give it. An
    # answer with neither is not a success.
    ec=$(jq -r '.return.exitcode // empty' <<<"$st")
    if [ -n "$ec" ]; then return "$ec"; fi
    sig=$(jq -r '.return.signal // empty' <<<"$st")
    if [ -n "$sig" ]; then
        echo "virutil: $VM: the guest process was killed by signal $sig" >&2
        return $(( 128 + sig ))
    fi
    echo "virutil: $VM's guest agent said pid $pid exited, with no exit code" >&2
    return 1
}

# exec_ps_encode SCRIPT [NONCE] -- SCRIPT wrapped and encoded for
# powershell.exe -EncodedCommand into EXEC_PS_ENC, refused here when it would
# not fit. With NONCE, the wrapper's first line prints it.
EXEC_PS_ENC=""
exec_ps_encode() {
    local SCRIPT
    # The catch writes to the console handle, not powershell's error stream,
    # which would be serialised as CLIXML; the explicit exit 1 restores the code
    # an uncaught terminating error would have returned.
    SCRIPT=$(printf '%s\n%s\n%s\n%s\n%s\n' \
        '$ProgressPreference="SilentlyContinue";' \
        'try { $Host.UI.RawUI.BufferSize = New-Object System.Management.Automation.Host.Size(4096, 2000) } catch {}' \
        'try {' \
        "$1" \
        '} catch { [Console]::Error.WriteLine(($_ | Out-String)); exit 1 }')
    if [ -n "${2:-}" ]; then
        SCRIPT="[Console]::Out.WriteLine('$GEXEC_NONCE_PREFIX$2');
$SCRIPT"
    fi

    # UTF-16LE base64 sidesteps every quoting layer between here and the guest
    EXEC_PS_ENC=$(printf '%s' "$SCRIPT" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
    # + the powershell.exe flags that precede it on the command line
    if [ $(( ${#EXEC_PS_ENC} + 128 )) -gt "$CMDLINE_MAX" ]; then
        echo "virutil: script encodes to ${#EXEC_PS_ENC} chars, over Windows's $CMDLINE_MAX" \
             "command-line limit (~12000 chars of source); shorten it, or stage" \
             "a .ps1 in the guest and run that" >&2
        exit 1
    fi
}

# exec_ps_text SCRIPT -- run SCRIPT in $VM's powershell, return its exit code.
# Shared with the transports in modules/linux/xfer.
#
# The wrapper's first line prints this call's nonce, which gexec checks for
# and strips: an answer without it came from another process's record. See
# "qemu-ga's exec records" above. A detached call goes through the launcher.
exec_ps_text() {
    local nonce
    if [ "$DETACH" = 1 ]; then
        exec_ps_detached "$1"
        return
    fi
    nonce="$(gexec_nonce)"
    exec_ps_encode "$1" "$nonce"
    gexec powershell.exe "$(jq -nc --arg e "$EXEC_PS_ENC" \
        '["-NoProfile","-NonInteractive","-OutputFormat","Text","-EncodedCommand",$e]')" "$nonce"
}

# The launcher behind `exec ps -d`, byte for byte the Windows driver's
# ($script:GuestPsDetachLauncher in modules/win/exec.ps1). It reads the encoded
# script from its stdin and starts it through ShellExecuteEx (UseShellExecute),
# which hands the child no inherited handles: a child that inherited the
# launcher's stdout and stderr pipes would hold them open, and qemu-ga calls a
# process exited only once both have closed. The child runs as the launcher
# does -- SYSTEM, the agent's environment -- and outlives it, as a detached
# guest-exec did.
GEXEC_PS_DETACH_LAUNCHER='$e = [Console]::In.ReadToEnd().Trim()
$si = New-Object System.Diagnostics.ProcessStartInfo
$si.FileName = Join-Path $PSHOME '"'"'powershell.exe'"'"'
$si.Arguments = '"'"'-NoProfile -NonInteractive -OutputFormat Text -EncodedCommand '"'"' + $e
$si.UseShellExecute = $true
$si.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden
$p = [System.Diagnostics.Process]::Start($si)
[Console]::Out.WriteLine([string]$p.Id)'

# exec_ps_detached SCRIPT -- `exec ps -d`: start SCRIPT and print its pid,
# leaving no qemu-ga record behind. The launcher is an ordinary captured call,
# polled to its end, so its record is consumed like any other; the script
# itself is never a guest-exec of its own.
#
# stdin is the launcher's channel for the script, so it cannot also be the
# script's. That is refused rather than dropped.
exec_ps_detached() {
    local enc out rc=0
    if [ -n "$INPUT_B64" ]; then
        die "virutil exec ps -d cannot hand stdin to a detached script: the" \
            "launcher that starts it reads the script from its own stdin. Put" \
            "the input in a file in the guest and read it from there."
    fi
    exec_ps_encode "$1"
    enc="$EXEC_PS_ENC"
    out="$(DETACH=0
           INPUT_B64="$(printf '%s' "$enc" | base64 -w0)"
           exec_ps_text "$GEXEC_PS_DETACH_LAUNCHER")" || rc=$?
    out="${out//[[:space:]]/}"
    if (( rc != 0 )) || [[ ! "$out" =~ ^[0-9]+$ ]]; then
        die "$VM could not start the detached script (launcher exit $rc);" \
            "it printed: [$out]"
    fi
    echo "$out"
}

# sh_quote STR -- STR as a single-quoted /bin/sh word. The sh counterpart of
# push_ps_quote, and the same one rule: inside single quotes every character is
# literal except the quote itself, which is closed, escaped and reopened.
sh_quote() {
    local s="$1"
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

# exec_sh_text SCRIPT -- run SCRIPT in $VM's /bin/sh, return its exit code.
# Shared with the transports in modules/linux/xfer, exactly as exec_ps_text is.
#
# No base64 layer, and this is the one place the Linux side is *simpler* rather
# than merely different. The Windows encoding exists because qemu-ga there has
# to flatten argv into a single CreateProcess command line, which re-quotes as
# it goes -- that is what mangles an embedded quote through cmd.exe. On Linux
# qemu-ga execve's the argv array it was handed, so the script arrives as one
# argument byte for byte, whatever is in it.
#
# set -e to match $ErrorActionPreference = "Stop" on the other side: a run rule
# exists to make the copy land correctly, so the first failing statement in one
# has to end it rather than let the rest carry on against a guest that is not in
# the state the rule was meant to put it in.
#
# A waited-for call prints its nonce first, as the ps wrapper does. A detached
# one is left a plain guest-exec, and the ledger reaps its record: Linux hands
# out pids in sequence and reuses them slowly, so it needs no launcher.
exec_sh_text() {
    local SCRIPT nonce=""
    SCRIPT="set -e
$1"
    if [ "$DETACH" != 1 ]; then
        nonce="$(gexec_nonce)"
        SCRIPT="printf '%s\\n' '$GEXEC_NONCE_PREFIX$nonce'
$SCRIPT"
    fi

    # + "-c" and the argv overhead around it
    if [ $(( ${#SCRIPT} + 64 )) -gt "$SH_ARG_MAX" ]; then
        echo "virutil: script is ${#SCRIPT} chars, over Linux's $SH_ARG_MAX" \
             "single-argument limit; shorten it, or stage a script in the" \
             "guest and run that" >&2
        exit 1
    fi

    gexec /bin/sh "$(jq -nc --arg c "$SCRIPT" '["-c",$c]')" "$nonce"
}

exec_main() {
    local CMD VM
    CMD="${1:-}"
    # An asked-for help exits 0 and a usage error exits 1, on every module in
    # both drivers. That is contract, so it is settled before anything else is
    # read -- and this module used to get it wrong, exiting 1 either way.
    case "$CMD" in
        -h|--help) exec_usage 0 ;;
    esac
    [ -n "$CMD" ] || exec_usage
    VM="${2:-}"
    [ -n "$VM" ] || exec_usage
    shift 2

    case "$CMD" in
    ping)
        agent '{"execute":"guest-ping"}' >/dev/null
        echo "$VM: agent up"
        ;;
    cmd)
        parse_flags "$@"
        set -- ${E_REST[@]+"${E_REST[@]}"}
        resolve_text "$@" || { echo "usage: virutil exec cmd VM [-d] CMD..." >&2; exit 1; }

        # qemu-ga backslash-escapes embedded quotes and cmd.exe has never
        # understood \" as an escape, so the command arrives mangled with a zero
        # exit code. ps encodes to base64 and is immune.
        case "$TEXT" in
            *'"'*) echo "virutil exec: cmd cannot carry embedded quotes through cmd.exe; use ps" >&2
                   exit 1 ;;
        esac
        # + the "cmd.exe /c " prefix and the quotes qemu-ga wraps the arg in
        if [ $(( ${#TEXT} + 16 )) -gt "$CMD_EXE_MAX" ]; then
            echo "virutil exec: command is ${#TEXT} chars, over cmd.exe's $CMD_EXE_MAX limit;" \
                 "shorten it, or stage a .cmd file in the guest and run that" >&2
            exit 1
        fi

        gexec cmd.exe "$(jq -nc --arg c "$TEXT" '["/c",$c]')"
        ;;
    ps)
        parse_flags "$@"
        set -- ${E_REST[@]+"${E_REST[@]}"}
        resolve_text "$@" || { echo "usage: virutil exec ps VM [-d] SCRIPT..." >&2; exit 1; }
        exec_ps_text "$TEXT"
        ;;
    sh)
        parse_flags "$@"
        set -- ${E_REST[@]+"${E_REST[@]}"}
        resolve_text "$@" || { echo "usage: virutil exec sh VM [-d] SCRIPT..." >&2; exit 1; }
        exec_sh_text "$TEXT"
        ;;
    *)
        exec_usage
        ;;
    esac
}
