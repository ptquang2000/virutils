# paths -- where virutil keeps its state: one root, every artifact under it, so
# a single variable relocates the whole lot and a single directory holds
# everything virutil leaves behind.
#
#   $VIRUTILS_DIR          the root, one directory for all of it
#   $VIRUTILS_CONF_DIR     sync configs (looked up here first)
#   $VIRUTILS_IMAGE_DIR    domain disks, snapshot overlays and memory files
#   $VIRUTILS_STAGING_ROOT sync's incremental staging trees
#   $VIRUTILS_PORT_DIR     domain port forward state and logs
#   $VIRUTILS_MNT_ROOT     host mount points for guest filesystems
#   $VIRUTILS_TMP_DIR      scratch for transfer payloads
#   $VIRUTILS_CACHE_DIR    third-party tools fetched once and reused (PsExec)

# --- one spelling, and the other accepted -----------------------------------
#
# The prefix is VIRUTILS_, plural, for every variable virutil reads. It used to
# be both: this file has always spelled the roots VIRUTILS_*, while modules
# /domain read VIRUTIL_IMAGE_DIR (singular) *in preference to it* and the
# Windows driver followed the singular -- so one config pointed the two drivers
# at two different directories, which is the bug this settles. The singular is
# still read, second, and says so once; both drivers do the same thing, which is
# section 4 of docs/contract.md.
VIRUTILS_DEPRECATED=()

# virutils_env NAME [DEFAULT] -- $VIRUTILS_<NAME>, or the deprecated
# $VIRUTIL_<NAME>, or DEFAULT, into $VIRUTILS_ENV. An empty value counts as
# unset, so VIRUTILS_VIRTIO= falls through to the default rather than naming a
# path of no characters.
#
# Answers in a variable rather than on stdout, and that is not a style choice: a
# command substitution is a subshell, so the note it leaves in
# VIRUTILS_DEPRECATED would be thrown away with it and the deprecation would
# never be reported.
VIRUTILS_ENV=""
virutils_env() {
    local new="VIRUTILS_$1" old="VIRUTIL_$1"
    if [[ -n "${!new:-}" ]]; then VIRUTILS_ENV="${!new}"; return 0; fi
    if [[ -n "${!old:-}" ]]; then
        VIRUTILS_DEPRECATED+=("$old")
        VIRUTILS_ENV="${!old}"
        return 0
    fi
    VIRUTILS_ENV="${2:-}"
}

# virutils_env_warn -- said once. Deliberately not fatal: the old spelling still
# works, and a hard failure would break a config that has been correct for as
# long as it existed.
virutils_env_warn() {
    (( ${#VIRUTILS_DEPRECATED[@]} )) || return 0
    local seen=() v
    for v in "${VIRUTILS_DEPRECATED[@]}"; do
        [[ " ${seen[*]:-} " == *" $v "* ]] && continue
        seen+=("$v")
    done
    warn "deprecated: ${seen[*]} -- virutil reads the plural VIRUTILS_ prefix" \
         "now, in both the bash and the PowerShell driver. Rename it to" \
         "VIRUTILS_${seen[0]#VIRUTIL_} (and the rest likewise); the old" \
         "spelling still works and will keep working."
}

# The default is ~/.virutils rather than an XDG directory: the staging tree has
# to survive reboots, qemu has to reach the images, and config discovery reads
# here first. VIRUTILS_DIR moves everything at once.
virutils_env DIR "$HOME/.virutils";              VIRUTILS_ROOT="$VIRUTILS_ENV"

# Each piece can be moved on its own; each defaults under the root.
virutils_env CONF_DIR "$VIRUTILS_ROOT/conf";     VIRUTILS_CONF_DIR="$VIRUTILS_ENV"
virutils_env IMAGE_DIR "$VIRUTILS_ROOT/images";  VIRUTILS_IMAGE_DIR="$VIRUTILS_ENV"
virutils_env STAGING_ROOT "$VIRUTILS_ROOT/staging"; VIRUTILS_STAGING_ROOT="$VIRUTILS_ENV"
virutils_env PORT_DIR "$VIRUTILS_ROOT/ports";    VIRUTILS_PORT_DIR="$VIRUTILS_ENV"
virutils_env MNT_ROOT "$VIRUTILS_ROOT/mnt";      VIRUTILS_MNT_ROOT="$VIRUTILS_ENV"
virutils_env TMP_DIR "$VIRUTILS_ROOT/tmp";       VIRUTILS_TMP_DIR="$VIRUTILS_ENV"
virutils_env CACHE_DIR "$VIRUTILS_ROOT/cache";   VIRUTILS_CACHE_DIR="$VIRUTILS_ENV"

# The four behaviour knobs domain reads. Same two spellings, same preference.
virutils_env OSINFO   "win11";   VIRUTILS_OSINFO="$VIRUTILS_ENV"
virutils_env VIRTIO   "";        VIRUTILS_VIRTIO="$VIRUTILS_ENV"
virutils_env NETWORK  "network=default,model=virtio"; VIRUTILS_NETWORK="$VIRUTILS_ENV"
virutils_env FIRMWARE "uefi";    VIRUTILS_FIRMWARE="$VIRUTILS_ENV"

virutils_env_warn

virutils_mnt() { printf '%s/%s' "$VIRUTILS_MNT_ROOT" "$1"; }

# paths_qemu_warn PATH... -- warn if the qemu user cannot traverse to each path.
# libvirt relabels the files qemu opens but never the directories above them, so
# a path under a 0700 home fails at domain start with a bare "Permission denied"
# -- say so up front, with the exact setfacl fix, instead of letting the guest
# fail the run. Silently skips a host where qemu runs as root, which is the WSL2
# case and needs none of this.
paths_qemu_warn() {
    local p qemu_user missing=() dir up
    command -v stat >/dev/null || return 0

    qemu_user="$(awk -F'"' '/^[[:space:]]*user[[:space:]]*=/ {print $2}' \
                 /etc/libvirt/qemu.conf 2>/dev/null | tail -1)"
    qemu_user="${qemu_user:-libvirt-qemu}"
    [[ "$qemu_user" == root ]] && return 0

    for p in "$@"; do
        # Absolute, or the walk up never reaches / -- dirname of "." is ".".
        dir="$(realpath -- "$p" 2>/dev/null || printf '%s' "$PWD/$p")"
        while :; do
            # Tenth character of the mode string is other-execute: 'x', or 't'
            # when sticky. Read from the bits, not -x, which answers for the
            # invoking user rather than for qemu.
            if [[ ! "$(stat -c '%A' "$dir" 2>/dev/null)" =~ ^.{9}[xt] ]] \
               && ! getfacl -pc -- "$dir" 2>/dev/null | grep -q "^user:$qemu_user:..x"; then
                missing+=("$dir")
            fi
            [[ "$dir" == / ]] && break
            up="$(dirname -- "$dir")"
            [[ "$up" == "$dir" ]] && break
            dir="$up"
        done
    done

    (( ${#missing[@]} )) || return 0
    warn "$qemu_user cannot traverse to ${*}:"
    warn "  ${missing[*]}"
    warn "The domain will fail to start with 'permission denied'. Fix it with:"
    warn "  sudo setfacl -m u:$qemu_user:x ${missing[*]}"
}
