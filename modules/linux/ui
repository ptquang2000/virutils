# ui -- launch a process on a Windows guest's *interactive* desktop.
#
#   virutil ui run VM [-i N] [-s] [--elevated] [--] APP...
#
# Why this exists at all. Everything virutil runs in a Windows guest goes through
# qemu-ga, which is a service in session 0. A process it spawns is invisible: it
# lands on session 0's window station, not the desktop the logged-in user is
# looking at. Getting a *visible* process onto session 1 means starting it with
# a token stamped for that session and binding it to that session's
# winsta0\default. `run` does that from the SYSTEM powershell qemu-ga already
# gives it: the guest half is payloads/win/ui.ps1, shared byte for byte with the
# PowerShell driver, which says how; docs/ui-psexec.md says why that recipe.
# Nothing is staged in the guest first.

# The guest's "no one is logged on in that session", contract section 5. The
# payload raises it; run turns it into the fix.
UI_RC_NO_USER=96

ui_usage() {
    printf '%s\n' \
        "usage: virutil ui run VM [-i N] [-s] [--elevated] [--] APP..." \
        "" \
        "  run VM APP...   start APP on a guest session's interactive desktop" \
        "                  (winsta0\\default) and return without waiting for it." \
        "                  APP is a program plus its arguments; a bare name is" \
        "                  looked up on the guest's PATH. Prints" \
        "                  \"started PID <pid> in session <n> as <user>\"." \
        "                  By default APP runs as the user logged on to the" \
        "                  console session, with that user's own token," \
        "                  environment and profile -- what double-clicking it" \
        "                  there would give, UAC-filtered if they are an admin." \
        "" \
        "    -i, --session N  that session instead of the console one" \
        "    -s, --system     as SYSTEM on that session's desktop" \
        "    --elevated       the user's full admin token, when UAC split it" \
        "                     -- no prompt. No effect with -s." \
        "    --               end of options; everything after it is APP" \
        "" \
        "                  Options stop at the first word that is not one, so" \
        "                  APP's own flags stay APP's. Exits 96 when no user is" \
        "                  logged on in that session (log one on, or use -s)." \
        "" \
        "  -h, --help     this message" >&2
    exit "${1:-1}"
}

# ui_dispatch VM SESSION AS ELEVATE ARGV CMDLINE -- render payloads/win/ui.ps1
# and run it. A session with no one logged on comes back as UI_RC_NO_USER and
# leaves with it, the guest's own line on stderr saying which session that was.
# The local VM is what exec_ps_text's agent helpers address, by dynamic scope.
ui_dispatch() {
    local VM="$1" script rc=0
    script="$(payload_render ui.ps1 SESSION="$2" AS="$3" ELEVATE="$4" \
                                     ARGV="$5" CMDLINE="$6")" || exit 1
    exec_ps_text "$script" || rc=$?
    if [[ "$rc" == "$UI_RC_NO_USER" ]]; then
        warn "$VM: nothing to launch into -- log a user on to the guest first," \
             "or pass -s to run as SYSTEM on that session's desktop."
        exit "$UI_RC_NO_USER"
    fi
    return "$rc"
}

# ui_run VM [OPTIONS] APP... -- the CLI launch. Options sit between VM and APP
# and stop at the first word that is not one, so APP's own flags -- even a -s --
# are APP's. The APP words travel as an argv joined with U+001F, which no
# argument has reason to hold, and the guest quotes them onto one command line;
# a path with spaces stays one argument.
ui_run() {
    local VM="${1:-}" session="" as=user elevate=""
    [[ -n "$VM" ]] || ui_usage
    [[ "$VM" == -h || "$VM" == --help ]] && ui_usage 0
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--system)  as=system; shift ;;
            --elevated)   elevate=1; shift ;;
            -i|--session) [[ "${2:-}" =~ ^[0-9]+$ ]] \
                              || { warn "$1 needs a session number"; ui_usage; }
                          session="$2"; shift 2 ;;
            --)           shift; break ;;
            -h|--help)    ui_usage 0 ;;
            -*)           warn "unrecognised option: $1"; ui_usage ;;
            *)            break ;;
        esac
    done
    [[ $# -gt 0 ]] || ui_usage

    local joined
    joined="$(printf '%s\x1f' "$@")"; joined="${joined%$'\x1f'}"
    ui_dispatch "$VM" "$session" "$as" "$elevate" "$joined" ""
}

# ui_run_cmdline VM CMDLINE -- launch a whole guest command line on the desktop
# as the logged-on user, used as written. This is what sync's ui run rules use:
# a config line is free text the way a command line is, so quoting a space-path
# is the author's to do (>post-ui "C:\Program Files\app\a.exe" --flag), exactly
# as at a prompt.
ui_run_cmdline() {
    ui_dispatch "$1" "" user "" "" "$2"
}

ui_main() {
    local CMD="${1:-}"
    [[ -n "$CMD" ]] || ui_usage
    shift || true
    case "$CMD" in
        # Retired: run stages nothing. Kept answering 0 so a script that still
        # calls it before run keeps working.
        setup)     say "ui needs no setup: 'virutil ui run' stages nothing in the guest." ;;
        run)       ui_run "$@" ;;
        -h|--help) ui_usage 0 ;;
        *)         ui_usage ;;
    esac
}
