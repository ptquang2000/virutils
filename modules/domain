# domain -- libvirt domain lifecycle

DOMAIN_IMAGE_DIR="${VIRUTIL_IMAGE_DIR:-/var/lib/libvirt/images}"

DOMAIN_OVMF=(
    /usr/share/OVMF/x64/OVMF_CODE.4m.fd:/usr/share/OVMF/x64/OVMF_VARS.4m.fd
    /usr/share/OVMF/OVMF_CODE.4m.fd:/usr/share/OVMF/OVMF_VARS.4m.fd
    /usr/share/OVMF/OVMF_CODE.fd:/usr/share/OVMF/OVMF_VARS.fd
    /usr/share/edk2/ovmf/OVMF_CODE.fd:/usr/share/edk2/ovmf/OVMF_VARS.fd
    /usr/share/edk2-ovmf/x64/OVMF_CODE.fd:/usr/share/edk2-ovmf/x64/OVMF_VARS.fd
    /usr/share/qemu/ovmf-x86_64-code.bin:/usr/share/qemu/ovmf-x86_64-vars.bin
)

domain_usage() {
    printf '%s\n' \
        "usage: virutil domain create VM ISO [OPTIONS]" \
        "       virutil domain delete VM [-y] [-k]" \
        "       virutil domain list" \
        "       virutil domain start    VM [-s GiB] [-m MiB] [-c N] [-G]" \
        "       virutil domain shutdown VM" \
        "       virutil domain addr     VM" \
        "       virutil domain port     VM [SPEC] [-c PORT]" \
        "" \
        "port options (SPEC is PORT, or HOSTPORT:GUESTPORT when the two differ;" \
        "with no SPEC it lists the open forwards for VM):" \
        "  -c, --close PORT  close the forward on host PORT" \
        "" \
        "create options:" \
        "  -s, --size GiB    disk size (default 64)" \
        "  -m, --memory MiB  guest RAM (default: half the host's)" \
        "  -c, --vcpus N     virtual CPUs (default: half the host's, max 8)" \
        "  -d, --disk PATH   disk image path (default $DOMAIN_IMAGE_DIR/VM.qcow2)" \
        "  -o, --osinfo ID   libosinfo id (default: detected from ISO)" \
        "  -v, --virtio ISO  virtio-win ISO to attach as a second cdrom, or" \
        "                    'none' (default: found beside ISO)" \
        "  -n, --dry-run     print the domain XML and define nothing" \
        "" \
        "start options (-s/-m/-c need the domain shut off; each is written to the config):" \
        "  -s, --size GiB    grow the disk image (never shrinks)" \
        "  -m, --memory MiB  guest RAM" \
        "  -c, --vcpus N     virtual CPUs" \
        "  -G, --no-gui      start it without opening the console" \
        "" \
        "delete options:" \
        "  -y, --yes         do not ask for confirmation" \
        "  -k, --keep-disk   undefine the domain but leave its disks in place" \
        "" \
        "  -h, --help        this message" \
        "" \
        "create reads these from the environment:" \
        "  VIRUTIL_IMAGE_DIR      $DOMAIN_IMAGE_DIR" \
        "  VIRUTIL_OSINFO         win11        fallback when the ISO is not recognised" \
        "  VIRUTIL_VIRTIO         (auto)       virtio-win ISO path, or 'none'" \
        "  VIRUTIL_NETWORK        network=default,model=virtio" \
        "  VIRUTIL_FIRMWARE       uefi         or 'bios'" \
        "  VIRUTIL_SHARED_MEMORY  1            or '0'; virtio-fs needs 1" >&2
    exit "${1:-1}"
}

domain_main() {
    local CMD
    CMD="${1:-}"
    case "$CMD" in
        "")        domain_usage 1 ;;
        -h|--help) domain_usage 0 ;;
    esac
    shift

    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi

    case "$CMD" in
        create)   domain_create "$@" ;;
        delete)   domain_delete "$@" ;;
        start)    domain_start  "$@" ;;
        list)     "${VIRSH[@]}" list --all ;;
        shutdown) domain_need_vm shutdown "$@"; "${VIRSH[@]}" shutdown  "$1" ;;
        addr)     domain_need_vm addr     "$@"; "${VIRSH[@]}" domifaddr "$1" --full ;;
        port)     domain_port   "$@" ;;
        *)        die "virutil domain: unknown command: $CMD (see: virutil domain -h)" ;;
    esac
}

domain_need_vm() {
    local cmd="$1"; shift
    (( $# >= 1 )) || die "usage: virutil domain $cmd VM"
}

domain_exists() {
    "${VIRSH_Q[@]}" dominfo "$1" >/dev/null 2>&1
}

# domain_disks NAME -- file-backed disks, one per line, cdroms excluded. The
# source is cut off the front of the line rather than taken as $4, so a path
# with spaces survives.
domain_disks() {
    "${VIRSH[@]}" domblklist "$1" --details 2>/dev/null \
        | awk '$1 == "file" && $2 == "disk" {
                   sub(/^[[:space:]]*([^[:space:]]+[[:space:]]+){3}/, ""); print }'
}

# domain_top_image NAME -- the top of the backing chain of the first disk.
domain_top_image() {
    "${VIRSH[@]}" domblklist "$1" --details 2>/dev/null \
        | awk '$2 == "disk" {print $4; exit}'
}

# domain_chain FILE -- FILE plus every backing file under it.
domain_chain() {
    local out
    out="$(qemu-img info --backing-chain -- "$1" 2>/dev/null || true)"
    [[ -n "$out" ]] \
        || out="$("${SUDO[@]}" qemu-img info --backing-chain -- "$1" 2>/dev/null || true)"

    # An unreadable image must not read as "this disk has no files": that would
    # turn a delete into a keep.
    if [[ -z "$out" ]]; then
        warn "could not read the backing chain of $1;" \
             "treating it as a single image -- any backing files stay behind"
        printf '%s\n' "$1"
        return
    fi
    printf '%s\n' "$out" | awk '/^image: /{ sub(/^image: /, ""); print }'
}

# domain_in_use FILE EXCEPT -- true if any domain other than EXCEPT references
# FILE, directly or as a backing file.
domain_in_use() {
    local file="$1" except="$2" other disk member
    while read -r other; do
        [[ -n "$other" && "$other" != "$except" ]] || continue
        while read -r disk; do
            [[ -n "$disk" ]] || continue
            while read -r member; do
                [[ "$member" == "$file" ]] && return 0
            done < <(domain_chain "$disk" 2>/dev/null)
        done < <(domain_disks "$other")
    done < <("${VIRSH_Q[@]}" list --all --name 2>/dev/null)
    return 1
}

# domain_readable_by_qemu FILE -- warn if the qemu user cannot traverse to FILE.
# libvirt relabels the file but never the directories above it, so an ISO under
# a 0700 home fails at domain start with a bare "Permission denied".
domain_readable_by_qemu() {
    local file="$1" dir up missing=() qemu_user
    qemu_user="$(awk -F'"' '/^[[:space:]]*user[[:space:]]*=/ {print $2}' \
                 /etc/libvirt/qemu.conf 2>/dev/null | tail -1)"
    qemu_user="${qemu_user:-libvirt-qemu}"
    [[ "$qemu_user" == root ]] && return 0

    # Absolute, or the walk up never reaches / -- dirname of "." is ".".
    file="$(realpath -- "$file" 2>/dev/null || printf '%s' "$PWD/$file")"
    dir="$(dirname -- "$file")"
    while :; do
        # Tenth character of the mode string is other-execute: 'x', or 't' when
        # sticky. Read from the bits, not -x, which answers for the invoking
        # user rather than for qemu.
        if [[ ! "$(stat -c '%A' "$dir")" =~ ^.{9}[xt] ]] \
           && ! getfacl -pc -- "$dir" 2>/dev/null | grep -q "^user:$qemu_user:..x"; then
            missing+=("$dir")
        fi
        [[ "$dir" == / ]] && break
        up="$(dirname -- "$dir")"
        [[ "$up" == "$dir" ]] && break
        dir="$up"
    done

    (( ${#missing[@]} )) || return 0
    warn "$qemu_user cannot traverse to $file:" \
         "  ${missing[*]}" \
         "The domain will fail to start with 'permission denied'. Fix it with:" \
         "  sudo setfacl -m u:$qemu_user:x ${missing[*]}"
}

# domain_detect_osinfo ISO -- a libosinfo short-id read from the ISO's own
# volume descriptors, or the VIRUTIL_OSINFO fallback. Two output formats: `-f
# env` where the build has it, and the plain one every build has, which spells
# the short-id in parentheses:
#   Media is an installer for OS 'Microsoft Windows 11 (win11)'
domain_detect_osinfo() {
    local out short=""
    command -v osinfo-detect >/dev/null || { printf '%s' "${VIRUTIL_OSINFO:-win11}"; return; }

    if out="$(osinfo-detect -f env -t media -- "$1" 2>/dev/null)" && [[ "$out" == *OSINFO_* ]]; then
        short="$(awk -F= '/^OSINFO_MEDIA_OS_SHORT_ID=/ {gsub(/"/, "", $2); print $2; exit}' \
                 <<<"$out")"
    else
        out="$(osinfo-detect -t media -- "$1" 2>/dev/null || true)"
        short="$(sed -n "s/.*for OS '.*(\([^)]*\))'.*/\1/p" <<<"$out" | head -1)"
    fi
    printf '%s' "${short:-${VIRUTIL_OSINFO:-win11}}"
}

# domain_topology N -- prints "CORES THREADS" for N vcpus. One socket: Windows
# licences and schedules by socket.
domain_topology() {
    local threads=1
    (( $1 % 2 == 0 )) && threads=2
    printf '%s %s' "$(( $1 / threads ))" "$threads"
}

domain_default_memory() {
    local mem
    mem=$(( $(awk '/^MemTotal:/ {print $2}' /proc/meminfo) / 1024 / 2 ))
    mem=$(( mem / 512 * 512 ))
    (( mem < 2048 )) && mem=2048
    printf '%s' "$mem"
}

domain_default_vcpus() {
    local n=$(( $(nproc) / 2 ))
    (( n > 8 )) && n=8
    (( n < 2 )) && n=2
    printf '%s' "$n"
}

domain_create() {
    local VM="" ISO="" SIZE=64 MEM="" VCPUS="" IMG="" OSINFO="" DRYRUN=0
    local VIRTIO NETWORK BIOS=0 SHAREMEM=1 candidate

    VIRTIO="${VIRUTIL_VIRTIO:-}"
    NETWORK="${VIRUTIL_NETWORK:-network=default,model=virtio}"
    [[ "${VIRUTIL_FIRMWARE:-uefi}" == bios ]] && BIOS=1
    [[ "${VIRUTIL_SHARED_MEMORY:-1}" == 0 ]] && SHAREMEM=0

    while (( $# )); do
        case "$1" in
            -s|--size)    SIZE="${2:?$1 needs a value}";   shift 2 ;;
            -m|--memory)  MEM="${2:?$1 needs a value}";    shift 2 ;;
            -c|--vcpus)   VCPUS="${2:?$1 needs a value}";  shift 2 ;;
            -d|--disk)    IMG="${2:?$1 needs a value}";    shift 2 ;;
            -o|--osinfo)  OSINFO="${2:?$1 needs a value}"; shift 2 ;;
            -v|--virtio)  VIRTIO="${2:?$1 needs a value}"; shift 2 ;;
            -n|--dry-run) DRYRUN=1; shift ;;
            -h|--help)    domain_usage 0 ;;
            -*)           die "virutil domain create: unknown option: $1" ;;
            *)
                if   [[ -z "$VM"  ]]; then VM="$1"
                elif [[ -z "$ISO" ]]; then ISO="$1"
                else die "virutil domain create: unexpected argument: $1"
                fi
                shift ;;
        esac
    done

    [[ -n "$VM"  ]] || domain_usage
    [[ -n "$ISO" ]] || domain_usage
    command -v virt-install >/dev/null || die "virt-install not installed"
    command -v qemu-img     >/dev/null || die "qemu-img not installed"
    [[ -e /dev/kvm ]] || die "/dev/kvm is missing -- no hardware virtualisation." \
                             "Under WSL2 this usually means nested virtualisation is off."
    [[ -f "$ISO" ]] || die "install ISO not found: $ISO"
    # libvirt stores disk sources as absolute paths; resolve before anything
    # derives a directory from them.
    ISO="$(realpath -- "$ISO")"
    domain_exists "$VM" && die "domain '$VM' already exists" \
                               "  virutil domain delete $VM"

    [[ -n "$OSINFO" ]] || OSINFO="$(domain_detect_osinfo "$ISO")"

    [[ "$SIZE" =~ ^[0-9]+$ ]] || die "--size wants a whole number of GiB, got '$SIZE'"
    IMG="${IMG:-$DOMAIN_IMAGE_DIR/$VM.qcow2}"
    [[ -d "$IMG" ]] && IMG="$IMG/$VM.qcow2"
    [[ -e "$IMG" ]] && die "disk image already exists: $IMG" \
                           "Pass --disk to put it elsewhere, or remove it first."

    MEM="${MEM:-$(domain_default_memory)}"
    VCPUS="${VCPUS:-$(domain_default_vcpus)}"
    [[ "$MEM"   =~ ^[0-9]+$ ]] || die "--memory wants MiB, got '$MEM'"
    [[ "$VCPUS" =~ ^[0-9]+$ ]] || die "--vcpus wants a whole number, got '$VCPUS'"

    local cores threads
    read -r cores threads <<<"$(domain_topology "$VCPUS")"

    local -a ARGS=(
        --connect qemu:///system
        --name "$VM"
        --osinfo "$OSINFO"
        --virt-type kvm
        --machine q35
        --memory "$MEM"
        --memballoon none
        --vcpus "$VCPUS"
        --cpu "host-passthrough,cache.mode=passthrough,topology.sockets=1,topology.cores=$cores,topology.threads=$threads"
        --iothreads 1
        --network "$NETWORK"
        --graphics spice,listen=none
        --video virtio
        --channel spicevmc
        --channel unix,target.type=virtio,target.name=org.qemu.guest_agent.0
        --sound none
        --rng /dev/urandom
        --noautoconsole
    )

    # memoryBacking is a cold setting: without a shared memfd here, virtio-fs
    # later costs a full stop and start, not a reboot. The share device itself
    # is not provisioned -- it hotplugs, and one in the XML would put a drive
    # letter in every guest whether or not it ever moves a file.
    if (( SHAREMEM )); then
        ARGS+=(--memorybacking access.mode=shared,source.type=memfd)
    fi

    if (( BIOS )); then
        ARGS+=(--boot cdrom,hd)
    else
        local pair code vars
        for pair in "${DOMAIN_OVMF[@]}"; do
            [[ -f "${pair%%:*}" && -f "${pair##*:}" ]] || continue
            code="${pair%%:*}"; vars="${pair##*:}"
            break
        done
        [[ -n "${code:-}" ]] || die \
            "no OVMF firmware found -- install edk2-ovmf (or set VIRUTIL_FIRMWARE=bios)." \
            "Windows 11 will not install without UEFI."
        ARGS+=(--boot "loader=$code,loader.readonly=yes,loader.type=pflash,loader.secure=no,nvram.template=$vars,cdrom,hd")
    fi

    if [[ "$OSINFO" == win* ]] && command -v swtpm >/dev/null; then
        ARGS+=(--tpm backend.type=emulator,backend.version=2.0,model=tpm-crb)
    else
        ARGS+=(--tpm none)
        [[ "$OSINFO" == win11* ]] && warn \
            "swtpm is not installed, so the guest gets no TPM 2.0 device." \
            "Debloated Windows 11 images have the check removed and install fine;" \
            "a stock ISO will stop at 'This PC can't run Windows 11'. Install swtpm" \
            "and recreate the domain if you need one."
    fi

    if [[ "$OSINFO" == win* ]]; then
        # Without synic/stimer the guest's timer interrupts round-trip through
        # the hypervisor and an idle desktop burns host CPU. evmcs and avic are
        # off: avic is AMD-only and evmcs needs nested VMX, so on the wrong host
        # they produce a domain that refuses to start.
        ARGS+=(--features "hyperv.relaxed.state=on,hyperv.vapic.state=on,hyperv.spinlocks.state=on,hyperv.spinlocks.retries=8191,hyperv.vpindex.state=on,hyperv.runtime.state=on,hyperv.synic.state=on,hyperv.stimer.state=on,hyperv.stimer.direct.state=on,hyperv.frequencies.state=on,hyperv.tlbflush.state=on,hyperv.ipi.state=on,hyperv.reenlightenment.state=on,hyperv.reset.state=on,hyperv.evmcs.state=off,hyperv.avic.state=off")
        ARGS+=(--clock hypervclock_present=yes,rtc_tickpolicy=catchup,hpet_present=no)
    fi

    # cache=none: the host page cache would otherwise hold a second copy of what
    # Windows already caches, competing for the memory the guest was given.
    local DISKOPTS="bus=virtio,format=qcow2,cache=none,io=io_uring,discard=unmap,detect_zeroes=unmap,driver.iothread=1,driver.queues=$VCPUS"

    if [[ "$OSINFO" == win* && "$VIRTIO" != none && -z "$VIRTIO" ]]; then
        for candidate in "$(dirname -- "$ISO")"/virtio-win*.iso; do
            [[ -f "$candidate" ]] && VIRTIO="$candidate"
        done
    fi
    [[ "$VIRTIO" == none ]] && VIRTIO=""
    [[ -n "$VIRTIO" && ! -f "$VIRTIO" ]] && die "virtio-win ISO not found: $VIRTIO"
    [[ -n "$VIRTIO" ]] && VIRTIO="$(realpath -- "$VIRTIO")"

    domain_readable_by_qemu "$ISO"
    [[ -n "$VIRTIO" ]] && domain_readable_by_qemu "$VIRTIO"

    # virt-install only accepts a sizeless --disk for an image that already
    # exists, and a dry run creates nothing.
    local DISKSPEC="path=$IMG,$DISKOPTS"
    (( DRYRUN )) && DISKSPEC="path=$IMG,size=$SIZE,$DISKOPTS"

    ARGS+=(--disk "$DISKSPEC")
    ARGS+=(--disk "path=$ISO,device=cdrom,bus=sata,readonly=on")
    [[ -n "$VIRTIO" ]] && ARGS+=(--disk "path=$VIRTIO,device=cdrom,bus=sata,readonly=on")

    if (( DRYRUN )); then
        virt-install "${ARGS[@]}" --dry-run --print-xml 1
        return
    fi

    say "domain:  $VM ($OSINFO)"
    say "cpu:     $VCPUS vcpus (1 socket x $cores cores x $threads threads)"
    local memnote=""
    (( SHAREMEM )) && memnote=" (shared memfd)"
    say "memory:  ${MEM} MiB$memnote"
    say "disk:    $IMG (${SIZE} GiB)"
    say "iso:     $ISO"
    [[ -n "$VIRTIO" ]] && say "virtio:  $VIRTIO"

    # cluster_size=1M keeps a 64 GiB image's L2 metadata small enough to stay
    # cached; preallocation=metadata stops the guest's first write into a region
    # stalling behind table allocation. lazy_refcounts trades a
    # `qemu-img check -r all` after an unclean shutdown for faster writes.
    local -a IMGSUDO=()
    [[ -w "$(dirname -- "$IMG")" ]] || IMGSUDO=("${SUDO[@]}")

    "${IMGSUDO[@]}" qemu-img create -f qcow2 \
        -o cluster_size=1M,preallocation=metadata,lazy_refcounts=on \
        -- "$IMG" "${SIZE}G" >/dev/null \
        || die "could not create $IMG"

    if ! virt-install "${ARGS[@]}"; then
        "${IMGSUDO[@]}" rm -f -- "$IMG"
        die "virt-install failed -- $IMG removed"
    fi

    say "" \
        "defined and started. Open the console with:" \
        "  virutil domain start $VM"
    if [[ -n "$VIRTIO" ]]; then
        say "In Windows Setup, 'Load driver' -> the virtio-win CD -> amd64\\<version>" \
            "makes the virtio disk visible." \
            "See the guest prerequisites in README.md for what to install after."
    fi
}

domain_console() {
    local -a VIEWER
    if command -v virt-manager >/dev/null; then
        VIEWER=(virt-manager --connect qemu:///system --show-domain-console "$1")
    elif command -v virt-viewer >/dev/null; then
        VIEWER=(virt-viewer --connect qemu:///system --wait "$1")
    else
        warn "no console opened: neither virt-manager nor virt-viewer is installed." \
             "  virsh --connect qemu:///system console $1   (serial, if configured)"
        return 0
    fi

    if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        warn "no console opened: no DISPLAY or WAYLAND_DISPLAY for ${VIEWER[0]}." \
             "Under WSL that means WSLg is off or this is not a graphical session."
        return 0
    fi

    setsid "${VIEWER[@]}" >/dev/null 2>&1 &
    say "console: ${VIEWER[0]} (pid $!)"
}

domain_start() {
    local VM="" SIZE="" MEM="" VCPUS="" CONSOLE=1

    while (( $# )); do
        case "$1" in
            -s|--size)   SIZE="${2:?$1 needs a value}";  shift 2 ;;
            -m|--memory) MEM="${2:?$1 needs a value}";   shift 2 ;;
            -c|--vcpus)  VCPUS="${2:?$1 needs a value}"; shift 2 ;;
            -G|--no-gui) CONSOLE=0; shift ;;
            -h|--help)   domain_usage 0 ;;
            -*)          die "virutil domain start: unknown option: $1" ;;
            *)           [[ -z "$VM" ]] || die "unexpected argument: $1"
                         VM="$1"; shift ;;
        esac
    done
    [[ -n "$VM" ]] || domain_usage
    domain_exists "$VM" || die "no such domain: $VM (see: virutil domain list)"

    if [[ -n "$SIZE$MEM$VCPUS" ]]; then
        local state; state="$("${VIRSH[@]}" domstate "$VM")"
        [[ "$state" == "shut off" ]] \
            || die "$VM is '$state'; -s/-m/-c rewrite the domain config and the" \
                   "disk image, which only works with it shut off." \
                   "  virutil domain shutdown $VM"
        command -v virt-xml >/dev/null || die "virt-xml not installed"
    fi

    if [[ -n "$VCPUS" ]]; then
        [[ "$VCPUS" =~ ^[0-9]+$ ]] || die "--vcpus wants a whole number, got '$VCPUS'"
        local cores threads
        read -r cores threads <<<"$(domain_topology "$VCPUS")"
        # vcpus and topology go in one edit: libvirt rejects a definition whose
        # topology does not multiply out to the vcpu count.
        virt-xml --connect qemu:///system "$VM" --edit --define \
            --vcpus "$VCPUS,sockets=1,cores=$cores,threads=$threads" >/dev/null \
            || die "could not set vcpus on $VM"
        say "vcpus:  $VCPUS (1 socket x $cores cores x $threads threads)"
    fi

    if [[ -n "$MEM" ]]; then
        [[ "$MEM" =~ ^[0-9]+$ ]] || die "--memory wants MiB, got '$MEM'"
        virt-xml --connect qemu:///system "$VM" --edit --define \
            --memory "$MEM,currentMemory=$MEM" >/dev/null \
            || die "could not set memory on $VM"
        say "memory: ${MEM} MiB"
    fi

    if [[ -n "$SIZE" ]]; then
        [[ "$SIZE" =~ ^[0-9]+$ ]] || die "--size wants a whole number of GiB, got '$SIZE'"
        local img; img="$(domain_top_image "$VM")"
        [[ -f "$img" ]] || die "could not resolve the disk image for $VM"
        local -a IMGSUDO=()
        [[ -w "$img" ]] || IMGSUDO=("${SUDO[@]}")
        # No --shrink: qemu-img refuses without it, which is the check we want.
        "${IMGSUDO[@]}" qemu-img resize -- "$img" "${SIZE}G" >/dev/null \
            || die "could not resize $img to ${SIZE} GiB" \
                   "(qemu-img refuses to shrink an image; ${SIZE} GiB may be" \
                   "smaller than the current size)"
        say "disk:   $img (${SIZE} GiB)" \
            "        the guest still has to extend its partition (diskmgmt.msc)"
    fi

    local state; state="$("${VIRSH[@]}" domstate "$VM" 2>/dev/null || true)"
    if [[ "$state" == running ]]; then
        say "$VM is already running"
    else
        "${VIRSH[@]}" start "$VM"
    fi

    (( CONSOLE )) && domain_console "$VM"
    return 0
}

# The guest's address, from whichever source knows it. The lease is
# authoritative when libvirt handed the address out itself, a guest configured
# statically only shows up to the agent, and a guest whose agent is not running
# only shows up in the host's ARP cache.
domain_ip() {
    local src ip
    for src in lease agent arp; do
        ip="$("${VIRSH[@]}" domifaddr "$1" --source "$src" 2>/dev/null |
            awk '{ for (i = 1; i <= NF; i++)
                       if ($i ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}\/[0-9]+$/) {
                           split($i, a, "/")
                           if (a[1] !~ /^127\./) { print a[1]; exit }
                       } }')"
        [[ -n "$ip" ]] && { printf '%s' "$ip"; return 0; }
    done
    return 1
}

# Forwards are tracked here, one file per forward, keyed on the host port --
# which is the only thing that has to be unique. The runtime dir is cleared on
# reboot, and so are the relays, so the two cannot drift apart across one.
DOMAIN_PORT_DIR="${XDG_RUNTIME_DIR:-/tmp/virutil-$(id -u)}/virutil/ports"

domain_port_file() { printf '%s/%s-%s' "$DOMAIN_PORT_DIR" "$1" "$2"; }

# A pid alone proves nothing once it has been recycled, so the command behind it
# is checked too. cmdline is NUL-separated, hence -a.
domain_port_alive() {
    [[ -n "$1" && -r "/proc/$1/cmdline" ]] && grep -qa socat "/proc/$1/cmdline"
}

# Every live forward as "PROTO HOSTPORT VM IP GUESTPORT BIND PID", dropping the
# state files whose relay has since died. Reading is the only thing that
# garbage-collects, which is enough: nothing else trusts a stale file.
domain_port_entries() {
    local f base proto hostport vm ip gport bind pid
    [[ -d "$DOMAIN_PORT_DIR" ]] || return 0
    for f in "$DOMAIN_PORT_DIR"/*-*; do
        [[ -f "$f" ]] || continue
        # socat's stderr sits beside the state file and matches the same glob
        case "$f" in *.log) continue ;; esac
        read -r vm ip gport bind pid <"$f" || continue
        if ! domain_port_alive "$pid"; then rm -f "$f"; continue; fi
        base="${f##*/}"; proto="${base%%-*}"; hostport="${base#*-}"
        printf '%s %s %s %s %s %s %s\n' \
            "$proto" "$hostport" "$vm" "$ip" "$gport" "$bind" "$pid"
    done
}

# domain_port_kill PID -- stop a relay and every connection it forked.
#
# socat's `fork` leaves one child per live connection, and those are reparented
# to init when the listener dies: killing the pid alone would leave a guest
# connection open with nothing tracking it. setsid put the relay in a session of
# its own, so the process group is exactly the relay and its children.
domain_port_kill() {
    local pgid mine
    pgid="$(ps -o pgid= -p "$1" 2>/dev/null | tr -d ' ')"
    mine="$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')"
    # Never signal our own group: that would take virutil down with it.
    if [[ -n "$pgid" && "$pgid" != "$mine" ]]; then
        kill -- "-$pgid" 2>/dev/null || true
    else
        kill "$1" 2>/dev/null || true
    fi
}

domain_port_show() {
    local proto hostport vm ip gport bind pid n=0
    while read -r proto hostport vm ip gport bind pid; do
        (( n++ == 0 )) && printf '%-5s %-21s %-21s %-16s %s\n' \
            PROTO LISTEN GUEST VM PID
        printf '%-5s %-21s %-21s %-16s %s\n' \
            "$proto" "$bind:$hostport" "$ip:$gport" "$vm" "$pid"
    done < <(domain_port_entries | awk -v vm="${1:-}" \
                 'vm == "" || $3 == vm' | sort -k1,1 -k2,2n)
    (( n )) || say "no forwards${1:+ for $1}"
}

# domain_port_spec SPEC -- sets HOSTPORT and GUESTPORT in the caller. A bare
# port means the same number on both sides, which is what you want often enough
# to be the default.
#
# Assigns rather than prints: die() inside a command substitution would only
# exit the subshell, leaving a rejected port to carry on as an empty string.
domain_port_spec() {
    local p
    case "$1" in
        *:*:*) die "port wants PORT or HOSTPORT:GUESTPORT, got '$1'" ;;
        *:*)   HOSTPORT="${1%%:*}"; GUESTPORT="${1#*:}" ;;
        *)     HOSTPORT="$1";       GUESTPORT="$1" ;;
    esac
    for p in "$HOSTPORT" "$GUESTPORT"; do
        [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 )) \
            || die "not a port number: '$p' (in '$1')"
    done
}

# domain_port -- relay a host port into a running guest.
#
# Two hops separate a guest service from a browser on Windows: guest -> WSL, and
# WSL -> Windows. WSL's own localhost forwarding covers the second for free, but
# only for a real listening socket in this network namespace -- it does not see
# nftables DNAT. So the first hop is a userspace relay, which is also why this
# needs no privilege and no host firewall change.
domain_port() {
    local VM="" SPEC="" CLOSE=""
    local HOSTPORT GUESTPORT IP LISTEN REMOTE

    while (( $# )); do
        case "$1" in
            -c|--close)     CLOSE="${2:?$1 needs a port}"; shift 2 ;;
            -h|--help)      domain_usage 0 ;;
            -*)             die "virutil domain port: unknown option: $1" ;;
            *)              if   [[ -z "$VM"   ]]; then VM="$1"
                            elif [[ -z "$SPEC" ]]; then SPEC="$1"
                            else die "unexpected argument: $1"
                            fi
                            shift ;;
        esac
    done
    [[ -n "$VM" ]] || domain_usage
    [[ -n "$SPEC" && -n "$CLOSE" ]] && die "port opens or closes, not both"
    domain_exists "$VM" || die "no such domain: $VM (see: virutil domain list)"

    local proto hostport vm ip gport bind pid

    if [[ -n "$CLOSE" ]]; then
        domain_port_spec "$CLOSE"
        # No match leaves read empty and failing, which set -e would take as
        # fatal before the message below could explain it.
        read -r proto hostport vm ip gport bind pid < <(
            domain_port_entries |
                awk -v p="$HOSTPORT" '$2 == p') || true
        [[ -n "${hostport:-}" ]] \
            || die "no forward on $HOSTPORT (see: virutil domain port $VM)"
        # The host port is the key, so a mistyped VM would otherwise close a
        # forward belonging to another domain.
        [[ "$vm" == "$VM" ]] \
            || die "port $HOSTPORT is forwarded to $vm, not to $VM"
        domain_port_kill "$pid"
        rm -f "$(domain_port_file tcp "$HOSTPORT")" \
              "$(domain_port_file tcp "$HOSTPORT").log"
        say "closed $HOSTPORT -> $VM ($ip:$gport)"
        return 0
    fi

    # No spec: the listing is what you want most often after opening one.
    [[ -n "$SPEC" ]] || { domain_port_show "$VM"; return 0; }

    domain_port_spec "$SPEC"

    command -v socat >/dev/null \
        || die "socat not installed; the forward is a socat relay"

    local state; state="$("${VIRSH[@]}" domstate "$VM" 2>/dev/null || true)"
    [[ "$state" == running ]] \
        || die "$VM is '$state'; a domain that is not running has no address" \
               "to forward to."

    IP="$(domain_ip "$VM")" || die \
        "could not find an address for $VM. A guest on the default NAT network" \
        "gets one from libvirt's DHCP; a guest configured statically needs the" \
        "QEMU guest agent running for libvirt to see it." \
        "  virutil domain addr $VM"

    # As above: an unmatched read fails, and that is the normal case here.
    read -r proto hostport vm ip gport bind pid < <(
        domain_port_entries |
            awk -v p="$HOSTPORT" '$2 == p') || true
    if [[ -n "${hostport:-}" ]]; then
        if [[ "$vm" == "$VM" && "$gport" == "$GUESTPORT" && "$ip" == "$IP" ]]; then
            say "$HOSTPORT -> $VM ($IP:$GUESTPORT) is already open (pid $pid)"
            return 0
        fi
        # Silently repointing a forward another domain is using is worse than
        # refusing to; a stale one of our own is just replaced.
        [[ "$vm" == "$VM" ]] \
            || die "port $HOSTPORT is already forwarded to $vm ($ip:$gport)" \
                   "  virutil domain port $vm -c $HOSTPORT"
        say "$HOSTPORT: repointing from $ip:$gport to $IP:$GUESTPORT"
        domain_port_kill "$pid"
    fi

    # bind=0.0.0.0 is not a default so much as the whole point: WSL only
    # publishes a port to Windows when something listens on the wildcard.
    LISTEN="TCP4-LISTEN:$HOSTPORT,fork,reuseaddr,bind=0.0.0.0"
    REMOTE="TCP4:$IP:$GUESTPORT"

    (( HOSTPORT < 1024 && EUID != 0 )) \
        && warn "note: binding $HOSTPORT needs root; expect socat to fail"

    mkdir -p "$DOMAIN_PORT_DIR"
    local log="$DOMAIN_PORT_DIR/tcp-$HOSTPORT.log"

    # setsid so the relay outlives this shell, and the inner shell reports the
    # pid of socat itself rather than of whatever wrapper happened to fork.
    # socat's stderr is the only diagnosis available when a relay will not
    # start, so it is kept until the forward is closed.
    pid=$(setsid bash -c 'socat "$1" "$2" >>"$3" 2>&1 & echo $!' \
              _ "$LISTEN" "$REMOTE" "$log")

    # A relay that cannot bind dies at once, and saying so here beats leaving a
    # state file behind for a process that never existed.
    sleep 0.3
    if ! domain_port_alive "$pid"; then
        warn "socat could not start the forward on $HOSTPORT:"
        sed 's/^/  /' "$log" >&2
        rm -f "$log"
        die "nothing is listening on $HOSTPORT; is the port already taken?" \
            "  ss -lnt 'sport = :$HOSTPORT'"
    fi

    printf '%s %s %s %s %s\n' "$VM" "$IP" "$GUESTPORT" 0.0.0.0 "$pid" \
        >"$(domain_port_file tcp "$HOSTPORT")"

    say "$HOSTPORT -> $VM ($IP:$GUESTPORT), pid $pid"
    say "  Windows: localhost:$HOSTPORT"
    say "  close with: virutil domain port $VM -c $HOSTPORT"
    return 0
}

domain_delete() {
    local VM="" YES=0 KEEP=0

    while (( $# )); do
        case "$1" in
            -y|--yes)       YES=1; shift ;;
            -k|--keep-disk) KEEP=1; shift ;;
            -h|--help)      domain_usage 0 ;;
            -*)             die "virutil domain delete: unknown option: $1" ;;
            *)              [[ -z "$VM" ]] || die "unexpected argument: $1"
                            VM="$1"; shift ;;
        esac
    done
    [[ -n "$VM" ]] || domain_usage
    domain_exists "$VM" || die "no such domain: $VM"

    # Built while the XML still exists and shown before anything is destroyed:
    # unlinking a qcow2 is the one step here nothing undoes.
    local -a REMOVE=() SHARED=()
    local disk member
    if (( ! KEEP )); then
        while read -r disk; do
            [[ -n "$disk" ]] || continue
            while read -r member; do
                [[ -n "$member" && -e "$member" ]] || continue
                if domain_in_use "$member" "$VM"; then SHARED+=("$member")
                else REMOVE+=("$member")
                fi
            done < <(domain_chain "$disk")
        done < <(domain_disks "$VM")
    fi

    local state; state="$("${VIRSH[@]}" domstate "$VM" 2>/dev/null || true)"
    say "domain: $VM ($state)"
    if (( ${#REMOVE[@]} )); then
        say "these files will be deleted:"
        printf '  %s\n' "${REMOVE[@]}" >&2
    else
        say "no disk files will be deleted"
    fi
    (( ${#SHARED[@]} )) && warn \
        "kept -- another domain uses them:" \
        "$(printf '  %s\n' "${SHARED[@]}")"

    if (( ! YES )); then
        [[ -t 0 ]] || die "not a terminal; pass -y to confirm"
        local reply
        read -r -p "type the domain name to confirm: " reply
        [[ "$reply" == "$VM" ]] || die "aborted"
    fi

    if [[ "$state" != "shut off" ]]; then
        "${VIRSH[@]}" destroy "$VM" >/dev/null || die "could not stop $VM"
        say "destroyed"
    fi

    # --nvram: the per-domain UEFI variable store is otherwise inherited by the
    # next domain that reuses the name. --snapshots-metadata: snapshot records
    # would block the undefine outright.
    "${VIRSH[@]}" undefine "$VM" --nvram --snapshots-metadata >/dev/null \
        || die "could not undefine $VM"
    say "undefined"

    local f rc=0
    for f in ${REMOVE[@]+"${REMOVE[@]}"}; do
        if rm -f -- "$f" 2>/dev/null || "${SUDO[@]}" rm -f -- "$f"; then
            say "removed $f"
        else
            warn "could not remove $f"
            rc=1
        fi
    done
    return "$rc"
}
