# tart-screen -- a tart domain's screen and its pointer and keyboard: `shot`
# and `input` for the macOS host's second kind of domain (modules/mac/tart).
#
# Both go through the VNC server Virtualization.framework runs for the VM when
# tart is started with --vnc-experimental, which `domain start` always does
# (modules/mac/tart, "the console"). That is the hypervisor's own view of the
# display and its own input devices, so it keeps what the contract says of
# both verbs: nothing runs in the guest, no agent is needed, and it works on a
# guest at the login window, in Setup Assistant or in recovery.
#
# bash has no RFB client and no DES, so the protocol is libexec/mac/vnc.py,
# standard-library Python 3. Everything that can be refused without the guest
# has been refused by modules/mac/input before this is reached.

TART_VNC_PY=""

# tart_vnc_tool -- python3 and the helper, or die naming the one missing.
tart_vnc_tool() {
    TART_VNC_PY="$HERE/libexec/mac/vnc.py"
    command -v python3 >/dev/null \
        || die "python3 not found: a tart domain's screen is reached over VNC, and" \
               "the client is $TART_VNC_PY (brew install python)"
    [[ -f "$TART_VNC_PY" ]] || die "missing $TART_VNC_PY"
}

# tart_vnc_run VM ARGS... -- the helper against VM's console.
tart_vnc_run() {
    local vm="$1" keys=mac; shift
    # Which modifier row: a Mac's, where cmd is the key beside the space bar,
    # or a PC's (libexec/mac/vnc.py, "keys").
    [[ "$(tart_guest_os "$vm")" == linux ]] && keys=pc
    VIRUTIL_VNC_HOST="$TART_VNC_HOST" VIRUTIL_VNC_PORT="$TART_VNC_PORT" \
    VIRUTIL_VNC_PASSWORD="$TART_VNC_PASSWORD" VIRUTIL_VNC_KEYS="$keys" python3 "$TART_VNC_PY" "$@"
}

# tart_shot VM OUT -- VM's screen to OUT as PNG; OUT is absolute and its
# directory exists (shot_main checked).
tart_shot() {
    local VM="$1" OUT="$2" png size
    tart_tool
    tart_vnc_tool
    tart_vnc_need "$VM"
    mkdir -p -- "$VIRUTILS_TMP_DIR"
    png="$(mktemp "$VIRUTILS_TMP_DIR/shot-XXXXXX")"
    # shellcheck disable=SC2064 # expanded now, on purpose
    trap "chan_close; rm -f -- '$png'" EXIT
    size="$(tart_vnc_run "$VM" shot "$png")" \
        || die "could not capture $VM's screen over its VNC console"
    [[ "$(od -An -tx1 -N8 -- "$png" | tr -d ' \n')" == 89504e470d0a1a0a ]] \
        || die "$VM's VNC console answered but no PNG was written"
    mv -f -- "$png" "$OUT"
    say "$VM: $size"
    printf '%s\n' "$OUT"
}

# tart_input -- `virutil input` for a tart domain. Called by input_main once it
# has parsed and refused what it can, and reads its locals: verb, VM, button,
# double, nums (the numbers after VM), combos (qcodes, one combo per element)
# and pos (the words as given).
#
# The events are the ones the QEMU half sends, in the same order with the same
# waits, written as lines for the helper rather than as QMP commands.
tart_input() {
    local size W H k n what events="" hold=100
    tart_tool
    tart_vnc_tool
    # The wheel is the one event this console does not carry to a macOS guest.
    # Measured on macOS 27 and tart 2.41.1: RFB's wheel buttons (4 and 5, and
    # 6 and 7 beside them) reach Virtualization.framework's VNC server and
    # scroll nothing, with or without a wait between press and release. Sent
    # anyway, the verb would say it scrolled. So it is refused, with what does
    # scroll: the arrow keys and space, and a drag of the scroll bar.
    if [[ "$verb" == wheel && "$(tart_guest_os "$VM")" == macos ]]; then
        die "virutil input wheel does nothing in $VM: a tart domain's console" \
            "(Virtualization.framework's VNC server) does not pass the wheel on" \
            "to a macOS guest. What scrolls there:" \
            "  virutil input key $VM down down down     (or up; space in a browser)" \
            "  virutil input drag $VM X1 Y1 X2 Y2        the scroll bar's thumb"
    fi
    tart_vnc_need "$VM"

    if [[ "$verb" == key || "$verb" == type ]]; then
        [[ "$verb" == type ]] && hold=30
        for k in "${combos[@]}"; do events+="key $k $hold"$'\n'; done
        tart_vnc_run "$VM" input <<<"$events" || die "could not send the keys to $VM"
        if [[ "$verb" == type ]]; then say "$VM: typed ${#combos[@]} characters"
        else say "$VM: key ${pos[*]:1}"; fi
        return 0
    fi

    size="$(tart_vnc_run "$VM" size)" || die "could not read the screen size of $VM"
    W="${size%x*}" H="${size#*x}"
    [[ "$W" =~ ^[0-9]+$ && "$H" =~ ^[0-9]+$ && "$W" -gt 0 ]] \
        || die "could not read the screen size of $VM (got '$size')"
    for (( k = 0; k < ${#nums[@]}; k += 2 )); do
        [[ "$verb" == wheel && $k -eq 2 ]] && break
        if (( nums[k] < 0 || nums[k] >= W || nums[k+1] < 0 || nums[k+1] >= H )); then
            die "${nums[k]},${nums[k+1]} is outside $VM's ${W}x$H screen"
        fi
    done

    local x="${nums[0]}" y="${nums[1]}"
    case "$verb" in
        move)
            events="move $x $y"$'\n'
            what="move $x,$y" ;;
        click)
            events="move $x $y"$'\n'"wait 50"$'\n'
            for (( n = 0; n <= double; n++ )); do
                (( n > 0 )) && events+="wait 80"$'\n'
                events+="button $button down"$'\n'"wait 50"$'\n'"button $button up"$'\n'
            done
            what="click $x,$y"
            (( double )) && what="double-$what"
            [[ "$button" == left ]] || what+=" ($button)" ;;
        drag)
            local x2="${nums[2]}" y2="${nums[3]}" steps=10
            events="move $x $y"$'\n'"wait 100"$'\n'"button $button down"$'\n'"wait 100"$'\n'
            for (( n = 1; n <= steps; n++ )); do
                events+="move $(( x + (x2 - x) * n / steps )) $(( y + (y2 - y) * n / steps ))"$'\n'"wait 25"$'\n'
            done
            events+="wait 100"$'\n'"button $button up"$'\n'
            what="drag $x,$y -> $x2,$y2"
            [[ "$button" == left ]] || what+=" ($button)" ;;
        wheel)
            local notches="${nums[2]}" dir=wheel-up count
            (( notches < 0 )) && dir=wheel-down
            count=$(( notches < 0 ? -notches : notches ))
            events="move $x $y"$'\n'"wait 50"$'\n'
            for (( n = 0; n < count; n++ )); do
                (( n > 0 )) && events+="wait 40"$'\n'
                events+="button $dir down"$'\n'"button $dir up"$'\n'
            done
            what="wheel $notches at $x,$y" ;;
    esac
    tart_vnc_run "$VM" input <<<"$events" || die "could not send the input to $VM"
    say "$VM: $what on ${W}x$H"
}
