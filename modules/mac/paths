# paths -- where virutil keeps its state on a macOS host: one root, every
# artifact under it. The same layout and the same variables as modules/linux/
# paths (docs/contract.md sections 3 and 4); what differs is what this host does
# with the behaviour knobs at the bottom.
#
#   $VIRUTILS_DIR          the root, one directory for all of it
#   $VIRUTILS_CONF_DIR     sync configs (looked up here first)
#   $VIRUTILS_IMAGE_DIR    domain disks, nvram, launchers, sockets, logs, TPM state
#   $VIRUTILS_STAGING_ROOT sync's incremental staging trees
#   $VIRUTILS_PORT_DIR     port forward state (unused here: a forward is a hostfwd)
#   $VIRUTILS_MNT_ROOT     host mount points for guest filesystems (unused here)
#   $VIRUTILS_TMP_DIR      scratch for transfer payloads
#   $VIRUTILS_CACHE_DIR    third-party tools fetched once and reused

# --- one spelling, and the other accepted -----------------------------------
#
# VIRUTILS_, plural, for every variable; the singular VIRUTIL_ is still read,
# second, and said once. Section 4 of the contract.
VIRUTILS_DEPRECATED=()

# virutils_env NAME [DEFAULT] -- $VIRUTILS_<NAME>, or the deprecated
# $VIRUTIL_<NAME>, or DEFAULT, into $VIRUTILS_ENV. An empty value counts as
# unset. Answers in a variable rather than on stdout so the deprecation note it
# leaves is not thrown away with a command substitution's subshell.
VIRUTILS_ENV=""
virutils_env() {
    local new="VIRUTILS_$1" old="VIRUTIL_$1"
    if [[ -n "${!new:-}" ]]; then VIRUTILS_ENV="${!new}"; return 0; fi
    if [[ -n "${!old:-}" ]]; then
        VIRUTILS_DEPRECATED+=("$old")
        VIRUTILS_ENV="${!old}"
        return 0
    fi
    VIRUTILS_ENV="${2:-}"
}

virutils_env_warn() {
    (( ${#VIRUTILS_DEPRECATED[@]} )) || return 0
    local seen=() v
    for v in "${VIRUTILS_DEPRECATED[@]}"; do
        [[ " ${seen[*]:-} " == *" $v "* ]] && continue
        seen+=("$v")
    done
    warn "deprecated: ${seen[*]} -- virutil reads the plural VIRUTILS_ prefix" \
         "now, on every driver. Rename it to VIRUTILS_${seen[0]#VIRUTIL_} (and" \
         "the rest likewise); the old spelling still works and will keep working."
}

virutils_env DIR "$HOME/.virutils";              VIRUTILS_ROOT="$VIRUTILS_ENV"

virutils_env CONF_DIR "$VIRUTILS_ROOT/conf";     VIRUTILS_CONF_DIR="$VIRUTILS_ENV"
virutils_env IMAGE_DIR "$VIRUTILS_ROOT/images";  VIRUTILS_IMAGE_DIR="$VIRUTILS_ENV"
virutils_env STAGING_ROOT "$VIRUTILS_ROOT/staging"; VIRUTILS_STAGING_ROOT="$VIRUTILS_ENV"
virutils_env PORT_DIR "$VIRUTILS_ROOT/ports";    VIRUTILS_PORT_DIR="$VIRUTILS_ENV"
virutils_env MNT_ROOT "$VIRUTILS_ROOT/mnt";      VIRUTILS_MNT_ROOT="$VIRUTILS_ENV"
virutils_env TMP_DIR "$VIRUTILS_ROOT/tmp";       VIRUTILS_TMP_DIR="$VIRUTILS_ENV"
virutils_env CACHE_DIR "$VIRUTILS_ROOT/cache";   VIRUTILS_CACHE_DIR="$VIRUTILS_ENV"

# The four behaviour knobs. Only VIRTIO means anything on this host; the other
# three are in the contract's table, so they are read, and domain create says
# so when one has actually been set (paths_ignored_warn below) -- the rule in
# section 9 that a setting is honoured, refused, or ignored out loud, never
# silently.
# What the environment itself said about the three this host ignores, taken
# before the lines below fill the same names in with defaults -- after them, a
# default is indistinguishable from a setting, and every create would warn
# about variables nobody set.
declare -A PATHS_FROM_ENV=()
for _knob in OSINFO NETWORK FIRMWARE; do
    for _spelling in "VIRUTILS_$_knob" "VIRUTIL_$_knob"; do
        [[ -n "${!_spelling:-}" ]] || continue
        PATHS_FROM_ENV[$_knob]="$_spelling=${!_spelling}"
        break
    done
done
unset _knob _spelling

virutils_env OSINFO   "win11";   VIRUTILS_OSINFO="$VIRUTILS_ENV"
virutils_env VIRTIO   "";        VIRUTILS_VIRTIO="$VIRUTILS_ENV"
virutils_env NETWORK  "";        VIRUTILS_NETWORK="$VIRUTILS_ENV"
virutils_env FIRMWARE "uefi";    VIRUTILS_FIRMWARE="$VIRUTILS_ENV"

virutils_env_warn

# paths_ignored_warn -- one line per contract variable that was set and that
# this host cannot act on. Only a value that came from the environment is worth
# a line: the defaults above are this file's own.
paths_ignored_warn() {
    local name set
    for name in OSINFO NETWORK FIRMWARE; do
        set="${PATHS_FROM_ENV[$name]:-}"
        [[ -n "$set" ]] || continue
        case "$name" in
            OSINFO)
                warn "$set is set and is ignored here: there is no libosinfo on" \
                     "this host and nothing consults an os id." ;;
            NETWORK)
                warn "$set is set and is ignored here: there is no libvirt" \
                     "network to name. The guest gets user-mode NAT, and the" \
                     "only way in is a port forward -- see -p, and" \
                     "'virutil domain port'." ;;
            FIRMWARE)
                if [[ "$VIRUTILS_FIRMWARE" == bios ]]; then
                    warn "$set is set and cannot be honoured here: an arm64" \
                         "guest has no BIOS to boot, only UEFI. Carrying on" \
                         "with UEFI."
                else
                    warn "$set is set and is ignored here: UEFI is the only" \
                         "firmware this driver builds."
                fi ;;
        esac
    done
}
