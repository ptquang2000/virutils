# pull -- copy a file or directory out of a guest's C: drive to the host.
#
# push's two transports, taken in the other direction. Both live in modules/xfer,
# and --disk chooses between them exactly as it does for push:
#
#   default  SMB over the guest's own NIC, driven by the guest agent. The host
#            exports the destination directory *writable* and the guest
#            robocopies into it, so a re-pull of a build that changed one file
#            moves one file. The guest keeps running, sees no new device, and
#            its disk image is not touched at all -- no snapshot, no overlay,
#            no commit. Needs an agent, a route back to this host, and root
#            here to bind port 445.
#   --disk   the guest's disk image, mounted read-only on the host. A running
#            guest is shut down around the copy and started again afterwards,
#            which is the whole cost of it -- but it needs nothing of the guest.
#
# The read used to run off a live disk-only snapshot that was blockcommitted
# back afterwards. It does not any more: that rearranged the backing chain on
# every pull, and the commit -- which merges the whole chain unless told
# otherwise -- flattened away the disk state that the domain's own snapshots
# were defined against. A transfer has no business rewriting the images
# underneath a snapshot, so neither transport here goes near them.

SUDO=()

pull_usage() {
    printf '%s\n' \
        "usage: virutil pull [--disk] VM SRC DST" \
        "" \
        "  VM   libvirt domain to read from; it has to be running, since the" \
        "       copy is driven from inside it. With --disk its disk image is" \
        "       read instead, so a running one is shut down first and started" \
        "       again afterwards" \
        "  SRC  guest path, relative to C:\\. Wildcards are allowed and match" \
        "       case-insensitively. Backslashes and a C:\\ prefix are tolerated;" \
        "       '..' is refused." \
        "  DST  host directory to copy into (created if needed)" \
        "" \
        "      --disk              read the guest's disk image instead of" \
        "                          copying over the guest's own network." \
        "                          Mounts the image read-only on the host, so a" \
        "                          running guest is shut down for the copy and" \
        "                          started again afterwards -- but it needs" \
        "                          nothing of the guest: no agent, no route" \
        "                          back here and no privileged port." \
        "  -h, --help              this message" \
        "" \
        "A directory source is copied recursively. By default the guest copies" \
        "it out itself with robocopy, and so moves only what changed; see" \
        "README.md." >&2
    exit "${1:-1}"
}

# Normalise a guest-side SRC into a C:-relative path: strip a drive prefix, turn
# backslashes into slashes, drop empty and '.' components, refuse '..' so the
# source can never resolve outside the mount point.
pull_norm_src() {
    local s="$1" out="" comp
    s="${s#[Cc]:}"
    s="${s//\\//}"
    while [[ -n "$s" ]]; do
        while [[ "$s" == /* ]]; do s="${s#/}"; done
        comp="${s%%/*}"
        [[ -n "$comp" ]] || break
        case "$comp" in
            '.') ;;
            '..') die "source may not contain '..': $1" ;;
            *)    out="${out:+$out/}$comp" ;;
        esac
        s="${s#"$comp"}"
    done
    printf '%s' "$out"
}

pull_main() {
    local VM="" SRC="" DST="" DISK=0

    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil pull under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi

    while (( $# )); do
        case "$1" in
            -h|--help)      pull_usage 0 ;;
            --disk)         DISK=1; shift ;;
            -*)             warn "unrecognised argument: $1"; pull_usage ;;
            *)
                if   [[ -z "$VM"  ]]; then VM="$1"
                elif [[ -z "$SRC" ]]; then SRC="$1"
                elif [[ -z "$DST" ]]; then DST="$1"
                else warn "unexpected argument: $1"; pull_usage
                fi
                shift ;;
        esac
    done
    [[ -n "$VM" && -n "$SRC" && -n "$DST" ]] || pull_usage

    DOMAIN="$VM"
    domain_exists "$DOMAIN" || die "no such domain: $DOMAIN (see: virutil domain list)"

    SRC="$(pull_norm_src "$SRC")" || exit 1
    [[ -n "$SRC" ]] || die "source may not be the root of C:"

    mkdir -p "$DST" || die "could not create destination: $DST"

    if (( DISK )); then
        command -v rsync >/dev/null || die "rsync not installed"
        xfer_check read
        # Read-only for the whole attach: the image is opened -r on the nbd
        # device and mounted ro, so a pull cannot alter the guest's disk even
        # if the copy goes wrong. guest_open arms the EXIT trap that unmounts,
        # detaches, and starts the guest again.
        GUEST_RO=1
        guest_open
        pull_copy "$SRC" "$DST"
        echo "copy complete -> $DST"
    else
        xfer_check smb
        # Reports for itself: it knows what came back and how long it took.
        pull_smb "$SRC" "$DST"
    fi
}

# pull_copy SRC DST -- expand SRC under MNT and rsync what it matched into DST.
# The glob is rewritten case-insensitively: NTFS is, an ntfs-3g mount is not,
# and nocaseglob alone would not do -- see ci_glob in modules/guest.
pull_copy() {
    local SRC="$1" DST="$2" m
    local -a matches files dirs

    shopt -s nullglob
    local IFS=$'\n'
    matches=("$MNT/"$(ci_glob "$SRC"))
    unset IFS
    shopt -u nullglob

    (( ${#matches[@]} )) || die "no match in $DOMAIN for C:\\${SRC//\//\\}"

    files=(); dirs=()
    for m in "${matches[@]}"; do
        if   [[ -d "$m" ]]; then dirs+=("$m")
        elif [[ -f "$m" ]]; then files+=("$m")
        else warn "   skipped (neither file nor dir): ${m#"$MNT/"}"
        fi
    done
    (( ${#files[@]} + ${#dirs[@]} )) || die "nothing to copy"

    echo "pull: C:\\${SRC//\//\\} -> $DST (${#files[@]} file(s), ${#dirs[@]} dir(s))"
    "${RSYNC[@]}" ${dirs[@]+"${dirs[@]}"} ${files[@]+"${files[@]}"} "$DST/"
}

# --- copying out of the running guest, over SMB ------------------------------

# The inversion of push_smb, and the same machinery underneath: the host stands
# up one throwaway share on the address the guest reaches it at, and the guest's
# own robocopy does the copying. Only the direction of the share differs -- it is
# exported writable here, and the guest writes into it rather than reading out of
# it. Nothing is mounted on the host, no device appears in the guest, and the
# disk image is not opened at all.
#
# Why robocopy rather than the agent's own channel: a guest-exec payload is
# base64 inside JSON inside a single argv entry, capped near 128KB. The NIC does
# the same work three orders of magnitude faster, so the agent is used only to
# say "copy this out", and robocopy skips whatever the host already holds
# unchanged -- so a second pull of a build where one file changed moves one file.

PULL_RC_NOMATCH=94          # nothing in the guest matched SRC
PULL_RC_ROBO=95             # robocopy returned a failure code (>= 8)

pull_smb() {
    local SRC="$1" DST="$2"
    local ip host export_dir rc=0 reported t0 elapsed

    ip="$(domain_ip "$DOMAIN")" \
        || die "could not work out $DOMAIN's address, so it has nowhere to" \
               "copy to. Check 'virutil domain addr $DOMAIN'."
    host="$(xfer_host_addr "$ip")"
    [[ -n "$host" ]] \
        || die "no route from this host to $DOMAIN at $ip, so the guest has" \
               "no address to copy to. A guest on an isolated network cannot" \
               "reach this host over its own network; pass --disk to read the" \
               "disk image instead."

    # Absolute, for the same reason push_smb resolves its source: smb.conf's
    # `path` is resolved by smbd against smbd's working directory, which is
    # root's and not the caller's. A relative DST -- `./out`, the ordinary way
    # to name a directory you are standing in -- would name a path that does not
    # exist over there, and the share would come up pointing at nothing.
    export_dir="$(cd -- "$DST" && pwd -P)" \
        || die "could not resolve $DST to an absolute path to serve it from"
    [[ -w "$export_dir" ]] \
        || die "$export_dir is not writable by you, and the guest writes into" \
               "it as you: smbd serves the share under the invoking user."

    xfer_smb_serve "$export_dir" "$host" rw

    echo "pull: C:\\${SRC//\//\\} -> $DST"

    t0="$(now_ms)"
    reported="$(pull_smb_fetch "$SRC")" || rc=$?
    elapsed=$(( $(now_ms) - t0 ))
    (( rc == 0 )) || pull_smb_die "$rc" "$SRC" "$host"

    xfer_smb_stop
    pull_smb_report "$reported" "$elapsed"
}

# pull_smb_fetch SRC -- the guest side, one powershell run. Get-Item resolves
# SRC, wildcards and all: Windows matches them case-insensitively itself, which
# is what the --disk path has to spell out by hand with ci_glob.
#
# Files and directories are copied by two different robocopy shapes, because
# robocopy always takes a source *directory*: a file is named as a filter
# alongside its parent, a directory is copied whole into a subdirectory of the
# share named after it -- which is where rsync would put it too. Files are
# grouped by parent so a wildcard that spans directories still costs one
# robocopy per directory rather than one per file.
#
# robocopy's exit code is a bitmap, not an error level: 0 means nothing needed
# copying, bit 0 means files were copied, and only >= 8 is a real failure -- so
# the usual "non-zero is bad" is wrong here and would call every successful copy
# an error. The stopwatch times the copy alone, without the agent round trip and
# powershell start-up that this host's wall clock would fold in.
pull_smb_fetch() {
    local SRC="$1" script src_win

    src_win="C:\\${SRC//\//\\}"
    script=$(printf '%s\n' \
        '$ErrorActionPreference = "Stop"' \
        "\$src = $(push_ps_quote "$src_win")" \
        "\$dst = $(push_ps_quote "$XFER_SMB_UNC")" \
        '$items = @(Get-Item -Path $src -Force -ErrorAction SilentlyContinue)' \
        "if (\$items.Count -eq 0) { [Console]::Error.WriteLine(\"no match for \$src\"); exit $PULL_RC_NOMATCH }" \
        '$files = @($items | Where-Object { -not $_.PSIsContainer })' \
        '$dirs  = @($items | Where-Object { $_.PSIsContainer })' \
        '$flags = @("/R:1","/W:1","/NP","/NFL","/NDL","/NJH","/NJS")' \
        '$rc = 0' \
        '$sw = [Diagnostics.Stopwatch]::StartNew()' \
        'foreach ($g in @($files | Group-Object DirectoryName)) {' \
        '  & robocopy $g.Name $dst @($g.Group | ForEach-Object { $_.Name }) @flags | Out-Null' \
        '  if ($LASTEXITCODE -ge 8) { $rc = $LASTEXITCODE } }' \
        'foreach ($d in $dirs) {' \
        '  & robocopy $d.FullName (Join-Path $dst $d.Name) /E @flags | Out-Null' \
        '  if ($LASTEXITCODE -ge 8) { $rc = $LASTEXITCODE } }' \
        '$sw.Stop()' \
        "if (\$rc -ge 8) { [Console]::Error.WriteLine(\"robocopy exit \$rc\"); exit $PULL_RC_ROBO }" \
        '"$($files.Count) $($dirs.Count) $([int]$sw.Elapsed.TotalMilliseconds)"')

    exec_ps_text "$script"
}

# pull_smb_report REPORTED MS -- what came back. REPORTED is the guest's own
# line, "files dirs ms". The duration is the guest's stopwatch rather than MS:
# MS is this host's wall clock and holds an agent round trip and a powershell
# starting up, which for a small payload is nearly all of it.
pull_smb_report() {
    local reported="$1" ms="$2" files dirs gms what
    read -r files dirs gms <<<"$reported"
    files="${files:-0}"; dirs="${dirs:-0}"

    what=""
    if (( files )) || (( ! dirs )); then
        what="$files file"; (( files == 1 )) || what+="s"
    fi
    if (( dirs )); then
        [[ -n "$what" ]] && what+=" and "
        what+="$dirs director"; (( dirs == 1 )) && what+="y" || what+="ies"
    fi
    echo "$DOMAIN: $what pulled in $(fmt_duration "${gms:-$ms}")"
}

# pull_smb_die RC SRC HOST -- name what went wrong; the guest has already
# printed its own line above. Shares push_smb's shape because the failures are
# the same ones seen from the other end.
pull_smb_die() {
    local rc="$1" src="$2" host="$3"
    case "$rc" in
        "$PULL_RC_NOMATCH")
            die "no match in $DOMAIN for C:\\${src//\//\\}" ;;
        "$PULL_RC_ROBO")
            die "robocopy could not complete the copy in the guest (its exit" \
                "code is above). Anything it did copy is left where it landed." ;;
        *)
            die "the guest failed to copy the files out (exit $rc); its own" \
                "error is above. If it could not reach $host, check the" \
                "guest's outbound firewall, or pass --disk to read the disk" \
                "image instead." ;;
    esac
}
