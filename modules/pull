# pull -- copy files out of a running guest's C: drive to the host

SUDO=()
DISK=""; SNAP=""; OVERLAY=""

pull_usage() {
    printf '%s\n' \
        "usage: virutil pull VM SRC DST [-t T]" \
        "" \
        "  VM   libvirt domain to read from" \
        "  SRC  guest path, relative to C:\\. Wildcards are allowed and match" \
        "       case-insensitively. Backslashes and a C:\\ prefix are tolerated;" \
        "       '..' is refused." \
        "  DST  host directory to copy into (created if needed)" \
        "$(xfer_transport_help)" \
        "  -h, --help              this message" \
        "" \
        "A directory source is copied recursively. The guest keeps running under" \
        "every transport; see README.md." >&2
    exit "${1:-1}"
}

pull_finish() {
    if mnt_mounted; then
        sync
        "${SUDO[@]}" umount "$MNT" || true
    fi
    if nbd_attached; then
        "${SUDO[@]}" qemu-nbd -d "$NBD" >/dev/null 2>&1 || true
    fi
    sync

    # The blockcommit must only run once the base image is provably free, so
    # teardown is verified from observed state rather than exit codes.
    if mnt_mounted || nbd_attached; then
        warn "" \
             "teardown could not be verified -- the snapshot is left in place." \
             "The guest keeps running on $OVERLAY and its data is safe, but the" \
             "disk now has a backing chain. Fold the overlay back by hand:" \
             "  sudo umount $MNT" \
             "  sudo qemu-nbd -d $NBD" \
             "  ${VIRSH[*]} blockcommit $DOMAIN $DISK --active --pivot --wait" \
             "  ${VIRSH[*]} snapshot-delete $DOMAIN $SNAP --metadata" \
             "  sudo rm -f $OVERLAY"
        exit 1
    fi

    [[ -n "$SNAP" ]] || return 0

    echo "merging overlay into base..."
    if ! "${VIRSH[@]}" blockcommit "$DOMAIN" "$DISK" --active --pivot --wait \
            >/dev/null 2>&1; then
        warn "" \
             "blockcommit failed -- the guest is running on the overlay, which" \
             "is safe, but the disk now has a backing chain. Retry by hand:" \
             "  ${VIRSH[*]} blockcommit $DOMAIN $DISK --active --pivot --wait" \
             "  ${VIRSH[*]} snapshot-delete $DOMAIN $SNAP --metadata" \
             "  sudo rm -f $OVERLAY"
        exit 1
    fi

    if "${VIRSH[@]}" snapshot-list --name 2>/dev/null | grep -qx "$SNAP"; then
        "${VIRSH[@]}" snapshot-delete "$DOMAIN" "$SNAP" --metadata >/dev/null 2>&1 \
            || { warn "snapshot metadata delete failed; leaving $OVERLAY in place"; return 1; }
    fi
    "${SUDO[@]}" rm -f "$OVERLAY" || true
}

# Normalise a guest-side SRC into a C:-relative path: strip a drive prefix, turn
# backslashes into slashes, drop empty and '.' components, refuse '..' so the
# source can never resolve outside the mount point.
pull_norm_src() {
    local s="$1" out="" comp
    s="${s#[Cc]:}"
    s="${s//\\//}"
    while [[ -n "$s" ]]; do
        while [[ "$s" == /* ]]; do s="${s#/}"; done
        comp="${s%%/*}"
        [[ -n "$comp" ]] || break
        case "$comp" in
            '.') ;;
            '..') die "source may not contain '..': $1" ;;
            *)    out="${out:+$out/}$comp" ;;
        esac
        s="${s#"$comp"}"
    done
    printf '%s' "$out"
}

# Take a disk-only live snapshot so the guest's writes go to an overlay, attach
# the frozen base read-only, and mount it at MNT. The guest is never touched,
# which is what makes this the transport that needs no agent.
#
# The checkpoint is at the QCOW2 level, not the filesystem level: the guest's
# page cache is absent and the NTFS journal may be mid-transaction. Fine for
# build output; do not audit a live database this way.
pull_open_disk() {
    MNT="${MNT:-$(virutils_mnt "$DOMAIN")}"

    if (( ${#SUDO[@]} )); then
        command -v sudo >/dev/null || die "sudo not installed; nbd and mount need it"
        sudo -v || die "sudo authentication failed"
    fi

    nbd_attached && die "$NBD is already attached; free it first" \
                        "  sudo qemu-nbd -d $NBD"
    mnt_mounted && die "$MNT is already mounted; unmount it first" \
                       "  sudo umount $MNT"

    local state="$("${VIRSH[@]}" domstate "$DOMAIN")"
    echo "domain: $DOMAIN ($state)"
    [[ "$state" == running ]] \
        || die "$DOMAIN is '$state'; the disk transport reads the live disk via" \
               "a snapshot. Start it, or copy the other way with virutil push."

    DISK="$("${VIRSH[@]}" domblklist "$DOMAIN" --details \
           | awk '$2=="disk" {print $3; exit}')"
    IMG="$("${VIRSH[@]}" domblklist "$DOMAIN" --details \
          | awk '$2=="disk" {print $4; exit}')"
    [[ -n "$DISK" ]] || die "no disk device found for $DOMAIN"
    [[ -f "$IMG" ]] || die "could not resolve disk image for $DOMAIN"

    nbd_reload
    trap pull_finish EXIT

    local snap_name="pull-$(date +%Y%m%d-%H%M%S)"
    OVERLAY="$VIRUTILS_IMAGE_DIR/$DOMAIN.$snap_name.qcow2"
    mkdir -p "$(dirname -- "$OVERLAY")"
    paths_qemu_warn "$(dirname -- "$OVERLAY")"
    echo "snapshot: $snap_name"
    "${VIRSH[@]}" snapshot-create-as --domain "$DOMAIN" --name "$snap_name" \
        --disk-only --atomic \
        --diskspec "$DISK,snapshot=external,file=$OVERLAY" \
        || die "snapshot creation failed -- nothing was touched"
    SNAP="$snap_name"

    local top
    top="$("${VIRSH[@]}" domblklist "$DOMAIN" --details \
          | awk -v t="$DISK" '$2=="disk" && $3==t {print $4}')"
    [[ "$top" == "$OVERLAY" ]] \
        || die "snapshot did not take effect: $DISK still points at $top"
    echo "   writes now go to $OVERLAY; base frozen: $IMG"

    nbd_connect "$IMG" -r

    local PART; PART="$(nbd_find_part ntfs)"
    if [[ -z "$PART" ]]; then
        lsblk -o NAME,SIZE,FSTYPE,PARTTYPENAME "$NBD" >&2 || true
        die "no NTFS partition found on $NBD (layout above)"
    fi
    echo "partition: $PART ($(nbd_part_size "$PART") GiB)"

    "${SUDO[@]}" mkdir -p "$MNT"
    "${SUDO[@]}" mount -t ntfs-3g -o "ro,uid=$(id -u),gid=$(id -g)" "$PART" "$MNT"
}

pull_main() {
    local VM="" SRC="" DST="" TRANSPORT=""

    [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]] \
        && die "do not run virutil pull under sudo -- run it as yourself." \
               "It escalates only the commands that actually need root."
    if [[ $EUID -eq 0 ]]; then SUDO=(); else SUDO=(sudo); fi

    while (( $# )); do
        case "$1" in
            -t|--transport) TRANSPORT="${2:?$1 needs a value}"; shift 2 ;;
            -h|--help)      pull_usage 0 ;;
            -*)             warn "unrecognised argument: $1"; pull_usage ;;
            *)
                if   [[ -z "$VM"  ]]; then VM="$1"
                elif [[ -z "$SRC" ]]; then SRC="$1"
                elif [[ -z "$DST" ]]; then DST="$1"
                else warn "unexpected argument: $1"; pull_usage
                fi
                shift ;;
        esac
    done
    [[ -n "$VM" && -n "$SRC" && -n "$DST" ]] || pull_usage

    DOMAIN="$VM"
    domain_exists "$DOMAIN" || die "no such domain: $DOMAIN (see: virutil domain list)"
    command -v rsync >/dev/null || die "rsync not installed"

    SRC="$(pull_norm_src "$SRC")" || exit 1
    [[ -n "$SRC" ]] || die "source may not be the root of C:"

    xfer_select read "$TRANSPORT"

    mkdir -p "$DST" || die "could not create destination: $DST"

    if [[ "$XFER" == disk ]]; then
        pull_open_disk
    else
        xfer_open_read
        xfer_collect "$SRC"
    fi

    pull_copy "$SRC" "$DST"

    echo "copy complete -> $DST"
}

# pull_copy SRC DST -- expand SRC under MNT and rsync what it matched into DST.
# The glob is rewritten case-insensitively: NTFS is, an ntfs-3g mount is not,
# and nocaseglob alone would not do -- see ci_glob in modules/guest.
pull_copy() {
    local SRC="$1" DST="$2" m
    local -a matches files dirs

    shopt -s nullglob
    local IFS=$'\n'
    matches=("$MNT/"$(ci_glob "$SRC"))
    unset IFS
    shopt -u nullglob

    (( ${#matches[@]} )) || die "no match in $DOMAIN for C:\\${SRC//\//\\}"

    files=(); dirs=()
    for m in "${matches[@]}"; do
        if   [[ -d "$m" ]]; then dirs+=("$m")
        elif [[ -f "$m" ]]; then files+=("$m")
        else warn "   skipped (neither file nor dir): ${m#"$MNT/"}"
        fi
    done
    (( ${#files[@]} + ${#dirs[@]} )) || die "nothing to copy"

    echo "pull: C:\\${SRC//\//\\} -> $DST (${#files[@]} file(s), ${#dirs[@]} dir(s))"
    "${RSYNC[@]}" ${dirs[@]+"${dirs[@]}"} ${files[@]+"${files[@]}"} "$DST/"
}
