# virtiofs -- the shared-directory transport: a host directory the running guest
# sees live, via virtiofsd on the host and WinFsp + the viofs driver in the
# guest. Driven through modules/xfer.
#
#   host dir <--(virtiofsd, vhost-user)--> guest drive letter --(robocopy)--> C:\
#
# The share stays attached between runs: setting it up is the expensive part and
# an idle share costs nothing.

VIRTIOFS_DIR=""                # the host side of the share
VIRTIOFS_CACHE=auto            # auto is coherent enough for a host that writes
VIRTIOFS_QUEUE=1024
VIRTIOFS_LETTER=""
VIRTIOFS_SENTINEL=".virutil-xfer"   # how the guest recognises the share; see below

# Read by the EXIT trap, so module scope: set -u must not trip on them.
VIRTIOFS_OURS=0
VIRTIOFS_PERSISTENT=0    # the share is part of the domain, not this run's doing
VIRTIOFS_SVC_PRIOR=""

# The path goes into the XML explicitly: libvirt only finds virtiofsd where it
# was built to look, and distros disagree (Arch /usr/lib, Fedora /usr/libexec).
VIRTIOFS_BINARY=(
    /usr/lib/virtiofsd
    /usr/libexec/virtiofsd
    /usr/lib/qemu/virtiofsd
    /usr/local/libexec/virtiofsd
)

# virtiofs_host_dir [VM] -- the host side of VM's share; $DOMAIN by default, so
# the transport's callers need not pass what they have already set.
virtiofs_host_dir() {
    printf '%s/virutil-%s' \
        "${VIRUTILS_SHARE_ROOT:-$VIRUTILS_ROOT/share}" "${1:-$DOMAIN}"
}

virtiofs_binary() {
    local p
    for p in "${VIRTIOFS_BINARY[@]}"; do
        [[ -x "$p" ]] && { printf '%s' "$p"; return 0; }
    done
    command -v virtiofsd 2>/dev/null && return 0
    die "virtiofsd not found in any of:" \
        "$(printf '  %s\n' "${VIRTIOFS_BINARY[@]}")" \
        "Install it (package 'virtiofsd' on Arch, 'virtiofsd'/'qemu-virtiofsd'" \
        "elsewhere), or use --transport disk, which needs nothing new" \
        "-- though it needs the guest shut off."
}

# Guest RAM the host can map: virtiofsd maps the guest's memory directly, and
# private anonymous memory cannot be handed to another process.
virtiofs_shared_mem() {
    "${VIRSH[@]}" dumpxml "$@" 2>/dev/null | grep -q "<access mode='shared'/>"
}

# libvirt's <cache> enum is none|always and rejects anything else outright:
#   XML error: Invalid value for attribute 'mode' in element 'cache': 'auto'
# 'auto' is virtiofsd's own default, so the way to ask for it is to say nothing.
virtiofs_fs_xml() {
    local cache=""
    case "$VIRTIOFS_CACHE" in
        auto)         cache="" ;;
        none|always)  cache="
    <cache mode='$VIRTIOFS_CACHE'/>" ;;
        *) die "virtiofs cache mode must be auto, none or always, got '$VIRTIOFS_CACHE'" ;;
    esac
    cat <<EOF
<filesystem type='mount' accessmode='passthrough'>
  <driver type='virtiofs' queue='$VIRTIOFS_QUEUE'/>
  <binary path='$1'>$cache
  </binary>
  <source dir='$2'/>
  <target dir='$XFER_TAG'/>
</filesystem>
EOF
}

# libvirt matches a filesystem device by its target alone.
virtiofs_match_xml() {
    cat <<EOF
<filesystem type='mount' accessmode='passthrough'>
  <source dir='$1'/>
  <target dir='$XFER_TAG'/>
</filesystem>
EOF
}

virtiofs_attached() {
    "${VIRSH[@]}" dumpxml "$@" 2>/dev/null | grep -q "<target dir='$XFER_TAG'/>"
}

# virtiofs_configured_dir [--inactive] VM -- the source directory of the share
# in that XML, or nothing when there is none. The XML is what says where the
# share points: a domain defined by an older virutil, or by hand, need not use
# the directory virtiofs_host_dir would pick, and the guest has mounted whatever
# the XML said. Read forwards, printing the last <source dir=...> seen before
# our target: libvirt writes source before target within a device.
virtiofs_configured_dir() {
    "${VIRSH[@]}" dumpxml "$@" 2>/dev/null | awk -v tag="$XFER_TAG" '
        /<filesystem/ { dir = ""; next }
        match($0, /<source dir='"'"'[^'"'"']*'"'"'/) {
            dir = substr($0, RSTART + 13, RLENGTH - 14); next }
        $0 ~ ("<target dir='"'"'" tag "'"'"'/>") { if (dir != "") print dir; exit }'
}

# virtiofs_setup -- make sure the share is live. Idempotent.
#
# Two shapes, and which one this is decides the teardown as much as the setup:
#
#   persisted  the domain was defined with the device (virutil domain create).
#              It comes up with the guest, holds one drive letter for the life
#              of the domain, and survives a snapshot revert. Nothing here
#              unplugs it -- it is the domain's, not this run's.
#   hotplugged no device in the definition, so one is attached --live for the
#              run and detached by the EXIT trap. A drive letter that outlived
#              the command would be a permanent change to a guest that only
#              asked for a file copy.
virtiofs_setup() {
    local dir="$1" binary xml

    mkdir -p "$dir"

    if virtiofs_attached "$DOMAIN"; then
        # Already live: the persisted device, or residue from a run that died
        # before its trap. The tag is virutil's own either way, so adopt it --
        # and take the residue with us at close rather than leave it stranded.
        (( VIRTIOFS_PERSISTENT )) || VIRTIOFS_OURS=1
        return 0
    fi

    binary="$(virtiofs_binary)" || exit 1

    if ! virtiofs_shared_mem "$DOMAIN"; then
        die "$DOMAIN is running without shared memory backing, so a virtio-fs" \
            "device cannot attach to it: virtiofsd has to map the guest's RAM." \
            "This is a cold setting -- a reboot from inside the guest will not" \
            "pick it up. Fix it once:" \
            "  virt-xml --connect qemu:///system $DOMAIN --edit --define \\" \
            "     --memorybacking access.mode=shared,source.type=memfd" \
            "  virutil domain shutdown $DOMAIN && virutil domain start $DOMAIN" \
            "Or use --transport disk, which needs nothing defined at all" \
            "-- though it needs the guest shut off."
    fi

    xml="$(virtiofs_fs_xml "$binary" "$dir")"
    printf '%s\n' "$xml" | "${VIRSH[@]}" attach-device "$DOMAIN" --live /dev/stdin \
        || die "could not attach the virtio-fs share to $DOMAIN"

    # A domain defined with the share but running from before it was: the
    # definition already says the device belongs here, so it stays plugged in.
    (( VIRTIOFS_PERSISTENT )) || VIRTIOFS_OURS=1
}

# VirtioFsSvc is the virtio-win viofs service; it maps each tag to a drive
# letter. Starting it here makes the share turn up with nobody logged in.
virtiofs_start_service() {
    local out
    out="$(VM="$DOMAIN"; DETACH=0; gexec sc.exe '["query","VirtioFsSvc"]' 2>&1)" || {
        die "$DOMAIN has no VirtioFsSvc service, so nothing in the guest is" \
            "listening for the share. Install, in this order:" \
            "  1. WinFsp                 https://winfsp.dev" \
            "  2. the viofs driver from the virtio-win ISO (viofs\\<os>\\amd64)" \
            "See the guest prerequisites in README.md. Then run this again --" \
            "or use --transport disk, which needs neither."
    }
    case "$out" in
        *RUNNING*) ;;
        *)  # Read before it is changed, so the trap can put it back.
            VIRTIOFS_SVC_PRIOR="$(xfer_ps \
                '(Get-Service VirtioFsSvc).StartType' 2>/dev/null | tr -d '[:space:]')"
            VM="$DOMAIN"; DETACH=0
            gexec sc.exe '["config","VirtioFsSvc","start=","auto"]' >/dev/null 2>&1 || true
            gexec sc.exe '["start","VirtioFsSvc"]' >/dev/null \
                || die "could not start VirtioFsSvc in $DOMAIN; check it in the" \
                       "guest (services.msc) and that WinFsp is installed"
            ;;
    esac
}

# Automatic is the viofs installer's own default, so restoring it would be a
# guest round trip that changes nothing.
virtiofs_restore_service() {
    # A share the domain is defined with is there at every boot, so the service
    # that maps it belongs on automatic: putting it back the way it was would
    # only make the next run start it again.
    (( VIRTIOFS_PERSISTENT )) && return 0

    case "$VIRTIOFS_SVC_PRIOR" in
        ""|Automatic) return 0 ;;
        Manual|Disabled|Boot|System) ;;
        *) return 0 ;;
    esac
    local start=demand
    [[ "$VIRTIOFS_SVC_PRIOR" == Disabled ]] && start=disabled
    VM="$DOMAIN"; DETACH=0
    gexec sc.exe "[\"config\",\"VirtioFsSvc\",\"start=\",\"$start\"]" >/dev/null 2>&1 \
        || warn "could not restore VirtioFsSvc to $VIRTIOFS_SVC_PRIOR in $DOMAIN"
    gexec sc.exe '["stop","VirtioFsSvc"]' >/dev/null 2>&1 || true
}

# Which letter the tag landed on -- the client takes the highest free one, so it
# moves as drives come and go. Found by looking for a file the host just wrote
# into the share: a WinFsp volume's DisplayRoot, Description and ProviderName are
# whatever the client chose to report and need not mention the tag.
virtiofs_letter() {
    xfer_ps '
$deadline = (Get-Date).AddSeconds(20)
do {
  foreach ($d in (Get-PSDrive -PSProvider FileSystem -ErrorAction SilentlyContinue)) {
    try {
      if (Test-Path -LiteralPath (Join-Path ($d.Name + ":\") "'"$VIRTIOFS_SENTINEL"'")) {
        Write-Output $d.Name; exit 0
      }
    } catch {}
  }
  Start-Sleep -Milliseconds 500
} while ((Get-Date) -lt $deadline)
exit 1' 2>/dev/null | tr -d '[:space:]'
}

# --- the transport contract -------------------------------------------------

# The share is just a directory; open() only proves it is attached and that a
# client in the guest holds a letter, before the copy phase is spent.
virtiofs_open() {
    xfer_privilege
    command -v rsync >/dev/null || die "rsync not installed"

    # The domain's own definition wins on where the share points: a persisted
    # device is what the guest already has mounted, and it may name a directory
    # from before VIRUTILS_SHARE_ROOT moved.
    VIRTIOFS_DIR="$(virtiofs_configured_dir --inactive "$DOMAIN")"
    if [[ -n "$VIRTIOFS_DIR" ]]; then
        VIRTIOFS_PERSISTENT=1
    else
        VIRTIOFS_DIR="$(virtiofs_host_dir)"
    fi

    virtiofs_setup "$VIRTIOFS_DIR"
    virtiofs_start_service

    MNT="$VIRTIOFS_DIR"

    # Delivery is a robocopy of the whole tree onto C:, so anything left from
    # last run would be delivered again.
    find "$MNT" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null || true

    # The marker the guest finds the drive letter by, rewritten every run.
    printf '%s\n' "$DOMAIN" > "$MNT/$VIRTIOFS_SENTINEL"

    # || true: the probe exits 1 when it finds nothing, and under set -e a bare
    # assignment from it would end the run silently, before the message below.
    VIRTIOFS_LETTER="$(virtiofs_letter || true)"
    [[ -n "$VIRTIOFS_LETTER" ]] \
        || die "the share is attached and VirtioFsSvc is running, but no drive" \
               "letter in $DOMAIN maps to '$XFER_TAG'. Check it in the guest:" \
               "  virutil exec ps $DOMAIN Get-PSDrive"

    trap xfer_close EXIT
    XFER_ARMED=1

    say "share:  $MNT  ->  $VIRTIOFS_LETTER: in $DOMAIN"
}

# The tree under MNT is already C:-shaped, so one robocopy of the share's root
# reproduces every mapping the copy phase made.
virtiofs_deliver() {
    say "guest: $VIRTIOFS_LETTER: -> C:\\"
    # /XF the sentinel: it is ours, not the guest's.
    xfer_robocopy "$VIRTIOFS_LETTER:\\" "C:\\" /XF "$VIRTIOFS_SENTINEL" \
        || die "robocopy failed inside $DOMAIN"
    say "delivered -> $DOMAIN"
}

virtiofs_collect() {
    local pat script sep
    say "guest: C:\\ -> $VIRTIOFS_LETTER:"

    script='$ErrorActionPreference = "Stop"
$copied = 0
foreach ($p in @('
    # Separator between items only: powershell rejects @('a','b',).
    local sep=""
    for pat in "$@"; do
        script+="$sep'$(xfer_ps_quote "$pat")'"; sep=","
    done
    script+=')) {
  $src = Join-Path "C:\" $p
  foreach ($item in @(Get-Item -Path $src -ErrorAction SilentlyContinue)) {
    if (-not $item) { continue }
    $rel = $item.FullName.Substring(3)
    $dst = Join-Path "'"$VIRTIOFS_LETTER"':\" $rel
    if ($item.PSIsContainer) {
      $null = robocopy $item.FullName $dst /E /NJH /NJS /NP /NDL /R:1 /W:1
      if ($LASTEXITCODE -ge 8) { throw "robocopy $($item.FullName) failed ($LASTEXITCODE)" }
    } else {
      $null = New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst)
      Copy-Item -LiteralPath $item.FullName -Destination $dst -Force
    }
    $copied++
  }
}
Write-Output "collected $copied item(s)"
if ($copied -eq 0) { throw "nothing matched in the guest" }'

    xfer_ps "$script" || die "collecting from $DOMAIN failed"
}

# Teardown, from the EXIT trap: nothing transferred stays readable at a drive
# letter once the command has returned. Unplug first, so the guest has lost the
# mapping before the directory empties underneath it.
#
# A persisted share is not unplugged -- the drive letter is the domain's, and
# the point of defining it was that it does not come and go. Emptying it still
# applies: what the share holds is one run's payload either way.
virtiofs_close() {
    (( XFER_ARMED )) || return 0

    if (( VIRTIOFS_OURS )) && virtiofs_attached "$DOMAIN"; then
        virtiofs_match_xml "$VIRTIOFS_DIR" \
            | "${VIRSH[@]}" detach-device "$DOMAIN" --live /dev/stdin >/dev/null 2>&1 \
            || warn "could not detach the virtio-fs share from $DOMAIN;" \
                    "$VIRTIOFS_LETTER: is still mapped there. Remove it with:" \
                    "  ${VIRSH[*]} detach-device $DOMAIN --live <the <filesystem> element>"
    fi

    # Runs even when the detach failed: a share with nothing in it is inert.
    if [[ -n "$VIRTIOFS_DIR" && -d "$VIRTIOFS_DIR" ]]; then
        find "$VIRTIOFS_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null \
            || warn "could not empty the share directory $VIRTIOFS_DIR"
    fi

    virtiofs_restore_service
}
