# sync -- fetch a project's build output from the Windows host, then push it into
# a Windows guest's C: drive. Sourced by virutil; entry point is sync_main.
# Usage:
#   virutil sync VM [-c NAME|PATH] [--transport T]  -- as yourself, NOT sudo.
#
# The target domain is a command-line argument, not a config setting: one config
# describes a project's build tree and where its pieces land on C:, and the same
# description is worth pointing at any guest that runs it.
#
#   Windows build tree --(fetch)--> staging dir --(map)--> the guest's C:
#
# How that last arrow is drawn is the transport's business, not sync's: the
# guest's own disk with it shut down, a staging volume hotplugged into it, or a
# live virtio-fs share. The map phase writes the same C:-shaped tree under MNT
# either way, which is why there is one copy phase and not three. --transport
# picks; @transport sets a default per config. See modules/xfer.
#
# Everything -- source dirs, destinations, excludes, post-copy cleanup -- is
# defined in a config file under ~/.config/virutils/. README.md documents the
# directive syntax; this module does not repeat it.
#
# Only the few commands that need root are escalated (nbd, mount, umount), and
# the mounted filesystem is handed to the invoking user with uid=, so both copy
# phases run unprivileged.
#
# The rest of this applies to the disk transport, which is the only one that
# touches the guest's own filesystem. Windows Fast Startup must be off,
# otherwise NTFS is left dirty and ntfs-3g refuses to mount read-write.
#
# A running guest is always shut down before its disk is touched and restarted
# afterwards -- including on failure -- so the power state you start with is the
# one you end with. The shutdown goes through qemu-guest-agent when it answers
# and ACPI when it does not, and it is never forced: a guest that will not shut
# down within @shutdown_timeout aborts the run, because cutting its power would
# dirty the very filesystem we came to write. The restart is gated on the image
# being provably detached: if teardown cannot be verified the guest is left shut
# off on purpose, since starting it then would put two writers on one qcow2.

# Everything the copy phases share -- the rsync/domain state, the offline attach
# machinery, and the EXIT trap that restores the guest -- lives in the shared
# guest module, sourced by virutil. State is at module scope there, not local to
# the mains, because the trap's guest_finish() runs after a main has returned,
# and set -u must not trip on a variable no module has touched yet.

# Prefixed per module: every module is sourced into one shell, so a bare
# DEFAULT_CONF would be clobbered by whichever module is sourced last.
CONF_DIR="$HOME/.config/virutils"
SYNC_DEFAULT_CONF="$CONF_DIR/sync.conf"

# Where @staging resolves to. Under the cache directory rather than /tmp for two
# reasons: the fetch is an incremental rsync, so a staging tree that survives a
# reboot means the next run copies only what changed instead of the whole build
# tree again; and a tmpfs /tmp would put a multi-gigabyte build output in RAM on
# the one kind of host -- WSL2 -- this tool exists for. It stays a fixed root
# with @staging as a name under it, so a mistyped @staging can only ever name a
# directory virutil owns.
SYNC_STAGING_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/virutil"

REPO=""; STAGING=""; DEST=""
FETCH=(); MAPPINGS=(); EXCLUDES=(); CLEANUP=()
SYNC_TRANSPORT=""   # @transport in the config; --transport on the command line wins

sync_usage() {
    printf '%s\n' \
        "usage: virutil sync VM [-c NAME|PATH] [--transport T]" \
        "" \
        "  VM                      libvirt domain whose disk is written" \
        "  -c, --config NAME|PATH  config to use. A value containing '/' is a" \
        "                          path, taken as given; anything else names a" \
        "                          config in $CONF_DIR" \
        "                          ('.conf' is appended when absent)." \
        "                          default: $SYNC_DEFAULT_CONF" \
        "$(xfer_transport_help)" \
        "  -h, --help              this message" \
        "" \
        "The config is the whole interface; see README.md for its format." >&2
    exit "${1:-1}"
}

# A map rule's destination is relative to @dest, so the install path is spelled
# once. Empty means @dest itself.
guest_dir() { printf '%s' "${DEST:+$DEST${1:+/}}$1"; }

# A function so IFS can be scoped: it must be newline-only, or globs containing
# spaces ("Program Files") would be split into separate words.
empty_guest_dirs() {
    local IFS=$'\n'
    local pat targets real rel n

    for pat in "${CLEANUP[@]}"; do
        targets=("$MNT"/$(ci_glob "$pat"))
        (( ${#targets[@]} )) \
            || { echo "   not present, skipped: C:\\${pat//\//\\}"; continue; }

        for real in "${targets[@]}"; do
            [[ -d "$real" ]] || continue

            # Must be under the mount and at least two levels down, so a
            # mistyped pattern cannot empty C:\ or a top-level directory.
            rel="${real#"$MNT/"}"
            if [[ "$real" != "$MNT/"* || "$rel" != */* ]]; then
                warn "refusing unsafe cleanup path: $real"
                continue
            fi

            # -print after -delete counts what went, in the same traversal.
            n="$(find "$real" -mindepth 1 -delete -print | wc -l)"
            echo "   emptied $real ($n entries)"
        done
    done
}

sync_main() {
    local CONF_ARG CONF lineno line VM TRANSPORT

    CONF_ARG=""; VM=""; TRANSPORT=""
    while (( $# )); do
        case "$1" in
            -c|--config) (( $# >= 2 )) || { warn "$1 needs a value"; sync_usage; }
                         CONF_ARG="$2"; shift 2 ;;
            --transport) (( $# >= 2 )) || { warn "$1 needs a value"; sync_usage; }
                         TRANSPORT="$2"; shift 2 ;;
            -h|--help)   sync_usage 0 ;;
            -*)          warn "unrecognised argument: $1"; sync_usage ;;
            *)           [[ -z "$VM" ]] || { warn "unexpected argument: $1"; sync_usage; }
                         VM="$1"; shift ;;
        esac
    done

    [[ -n "$VM" ]] || { warn "VM is required"; sync_usage; }
    DOMAIN="$VM"

    # Path-or-name is decided on the spelling alone, never on what happens to
    # exist: the same command must mean the same config from any directory, and
    # the error below can then name exactly one path.
    if   [[ -z "$CONF_ARG"    ]]; then CONF="$SYNC_DEFAULT_CONF"
    elif [[ "$CONF_ARG" == */* ]]; then CONF="$CONF_ARG"
    else                               CONF="$CONF_DIR/${CONF_ARG%.conf}.conf"
    fi

    [[ -f "$CONF" ]] || die "config not found: $CONF" \
        "Create it, or point -c elsewhere. README.md documents the format."

    # --- config -------------------------------------------------------------
    # Parsed up front so a malformed config fails before anything is touched.
    local key val
    REPO=""; STAGING=""; DEST=""
    FETCH=(); MAPPINGS=(); EXCLUDES=(); CLEANUP=()
    SYNC_TRANSPORT=""
    lineno=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        (( ++lineno ))
        line="${line%%#*}"                       # strip comments
        line="${line#"${line%%[![:space:]]*}"}"  # trim leading space
        line="${line%"${line##*[![:space:]]}"}"  # trim trailing space
        [[ -z "$line" ]] && continue

        case "$line" in
            @*)  IFS='=' read -r key val <<< "${line#@}"
                 case "$key" in
                     repo)             REPO="$val" ;;
                     staging)          STAGING="$val" ;;
                     dest)             DEST="$val" ;;
                     domain)           die "$CONF:$lineno: @domain is no longer a setting" \
                                           "-- pass the domain as an argument: virutil sync $val" ;;
                     nbd)              NBD="$val" ;;
                     mnt)              MNT="$val" ;;
                     transport)        SYNC_TRANSPORT="$val" ;;
                     shutdown_timeout) SHUTDOWN_TIMEOUT="$val" ;;
                     *) die "$CONF:$lineno: unknown setting '$key'" ;;
                 esac ;;
            !*)  local -a pats
                 read -r -a pats <<< "${line#!}"
                 for p in "${pats[@]}"; do EXCLUDES+=(--exclude="$p"); done ;;
            -*)  CLEANUP+=("${line#-}") ;;
            \<*) [[ "$line" == *"|"* ]] \
                     || die "$CONF:$lineno: fetch rule needs '|': $line"
                 FETCH+=("${line#<}") ;;
            *)   # Map rules are the only unsigilled form; anything starting
                 # with punctuation is a mistyped directive, not a glob.
                 [[ "${line:0:1}" == [A-Za-z0-9_./*?] ]] \
                     || die "$CONF:$lineno: unrecognised directive: $line"
                 [[ "$line" == *"|"* ]] \
                     || die "$CONF:$lineno: missing '|' separator: $line"
                 MAPPINGS+=("$line") ;;
        esac
    done < "$CONF"

    [[ -n "$STAGING" ]] || die "$CONF: @staging is required"
    # A name under the root, never a path: leading slashes are stripped and '..'
    # is refused outright. Stripping alone is not containment -- '../../etc' is
    # relative and would still land outside the root the fetch is documented to
    # stay inside.
    [[ "/$STAGING/" == */../* ]] \
        && die "$CONF: @staging may not contain '..': $STAGING"
    STAGING="$SYNC_STAGING_ROOT/${STAGING#/}"

    echo "config: $CONF"
    echo "  ${#FETCH[@]} fetch, ${#MAPPINGS[@]} map, ${#EXCLUDES[@]} exclude," \
         "${#CLEANUP[@]} cleanup"
    echo "  staging: $STAGING"
    echo "  domain: $DOMAIN"

    # Chosen before the fetch, not after it: a transport that cannot work is
    # worth saying so before spending minutes pulling a build tree off the
    # Windows host.
    domain_exists "$DOMAIN" || die "no such domain: $DOMAIN (see: virutil domain list)"
    xfer_select write "${TRANSPORT:-${SYNC_TRANSPORT:-auto}}"

    # --- fetch: Windows build tree -> staging -------------------------------
    (( ${#FETCH[@]} )) || die "no fetch rules in $CONF"
    [[ -n "$REPO" ]] || die "$CONF: @repo is required"
    [[ -d "$REPO" ]] || die "repo not found: $REPO"
    command -v rsync >/dev/null || die "rsync not installed"

    echo "fetch: $REPO"
    local rel sub
    for rule in "${FETCH[@]}"; do
        rel="${rule%%|*}"
        sub="$(root_rel "${rule#*|}")"
        [[ -d "$REPO/$rel" ]] \
            || { warn "   warning: no such source dir, skipped: $rel"; continue; }

        echo "   $rel -> ${sub:-.}"
        "${RSYNC[@]}" --chmod=F755,D755 "${EXCLUDES[@]}" \
              "$REPO/$rel/" "$STAGING${sub:+/$sub}/"
    done

    # --- push: staging -> guest disk ----------------------------------------
    [[ -d "$STAGING" ]] || die "staging dir not found: $STAGING"
    (( ${#MAPPINGS[@]} )) || die "no map rules in $CONF"

    # Pick the transport and open it: for disk that means shutting the guest
    # down and mounting its NTFS, for volume a staging qcow2, for virtiofs a
    # share -- and in every case MNT ends up standing for the root of C:, which
    # is why the copy phase below is written once. See modules/xfer.
    xfer_open

    shopt -s nullglob

    local globs dst_rel g
    local -a patterns files matches
    for rule in "${MAPPINGS[@]}"; do
        globs="${rule%%|*}"
        dst_rel="$(guest_dir "$(root_rel "${rule#*|}")")"

        # Split the pattern list WITHOUT letting bash expand it against the cwd
        # -- read never does pathname expansion, unlike an unquoted
        # `for g in $globs`.
        IFS=' ' read -r -a patterns <<< "$globs"

        # Expand the globs relative to the staging dir into a concrete file list.
        files=()
        for g in "${patterns[@]}"; do
            matches=("$STAGING/"$g)
            (( ${#matches[@]} )) || { warn "warning: no match for '$g'"; continue; }
            files+=("${matches[@]}")
        done
        (( ${#files[@]} )) || { warn "skipping '$dst_rel': nothing matched"; continue; }

        echo "-> C:\\${dst_rel//\//\\} (${#files[@]} item(s))"
        "${RSYNC[@]}" "${EXCLUDES[@]}" "${files[@]}" "$MNT/$dst_rel/"
    done

    shopt -u nullglob

    # Land the tree in the guest. A no-op for the disk transport, where MNT is
    # already C:; a robocopy inside the guest for the other two.
    xfer_deliver

    # Cleanup rules delete *in the guest*, so they run after delivery and go
    # wherever the guest's C: actually is: through the mount for disk, through
    # the agent for the live transports.
    if (( ${#CLEANUP[@]} )); then
        if [[ "$XFER" == disk ]]; then empty_guest_dirs
        else xfer_empty_guest_dirs "${CLEANUP[@]}"
        fi
    fi

    # The unmount, detach and restart happen in the EXIT trap, on the way out.
    echo "copy complete -> $DOMAIN"
}
