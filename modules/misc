# misc -- everyday libvirt domain operations.
# Sourced by virutil; entry point is misc_main. Usage:
#   virutil misc list                  list all VMs and their state
#   virutil misc start     VM          power on the VM
#   virutil misc shutdown  VM          request a graceful shutdown (ACPI)
#   virutil misc domifaddr VM          show all guest interface addresses

misc_usage() {
    echo "usage: virutil misc {list|start|shutdown|domifaddr} [VM_NAME]" >&2
    exit 1
}

misc_main() {
    local CMD VM
    CMD="${1:-}"
    [ -n "$CMD" ] || misc_usage

    case "$CMD" in
    list)
        "${VIRSH[@]}" list --all
        ;;
    start)
        VM="${2:?usage: virutil misc start VM}"
        "${VIRSH[@]}" start "$VM"
        ;;
    shutdown)
        VM="${2:?usage: virutil misc shutdown VM}"
        "${VIRSH[@]}" shutdown "$VM"
        ;;
    domifaddr)
        VM="${2:?usage: virutil misc domifaddr VM}"
        "${VIRSH[@]}" domifaddr "$VM" --full
        ;;
    *)
        misc_usage
        ;;
    esac
}
