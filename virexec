#!/bin/bash
# Run commands inside a Windows guest via the QEMU guest agent (no guest network).
# Usage: ./virexec COMMAND VM_NAME [FLAGS] [ARGS]
#   setup  VM                    add the org.qemu.guest_agent.0 channel to the VM
#   ping   VM                    check that the guest agent is responding
#   info   VM                    guest OS, hostname and agent version
#   cmd    VM [-d] CMD...        run CMD via cmd.exe /c, print stdout/stderr
#   ps     VM [-d] SCRIPT...     run SCRIPT via powershell (quoting-safe)
#
# Windows guests only. virt-manager does not add the agent channel itself, so
# `setup` is needed once per VM (plus qemu-ga in the guest: the virtio-win
# guest-agent MSI). Commands run as SYSTEM. The guest exit code becomes ours.
#
# Flags sit between the VM name and the command; parsing stops at the first
# non-flag, and `--` forces the end of flags so a command may start with `-`.
#   --detach, -d   fire and forget: print the guest pid and exit 0. There is no
#                  output and no exit code -- capture-output is off -- but the
#                  command survives the channel dropping, which is the only way
#                  to run a reboot or a long installer. Redirect to a file in
#                  the guest and fetch it afterwards if you need the output.
#
# stdin is overloaded, disambiguated by whether `-` sits in the command slot:
#   virexec ps VM -        the script is read from stdin (quoting-free, and the
#                          way to run anything longer than a one-liner)
#   echo x | virexec ps VM CMD
#                          stdin becomes the guest process's stdin. Buffered
#                          whole, not streamed -- kilobytes, not disk images --
#                          and the guest sees EOF immediately, so this cannot
#                          answer an interactive prompt. Keeps secrets out of
#                          both process lists, unlike putting them in CMD.
# `cmd VM -` works but is close to useless: cmd.exe /c takes a single statement,
# so a multi-line batch file piped in will not behave like a batch file.

set -euo pipefail

# silences virsh's "setlocale: No such file or directory" on minimal/WSL hosts
export LC_ALL=C

usage() {
    echo "usage: $0 {setup|ping|info|cmd|ps} VM_NAME [FLAGS] [ARGS]" >&2
    exit 1
}

CMD="${1:-}"
[ -n "$CMD" ] || usage
VM="${2:-}"
[ -n "$VM" ] || usage
shift 2

VIRSH="virsh -q -c qemu:///system"

# Windows caps a command line at 32767 chars; cmd.exe caps itself far lower.
# Both are enforced host-side, because overflowing them fails inside the guest
# as an unrelated-looking spawn error.
CMDLINE_MAX=32767
CMD_EXE_MAX=8191

DETACH=0
INPUT_B64=

# agent JSON -> stdout; dies on an agent-level error rather than feeding jq garbage
agent() {
    local reply
    reply=$($VIRSH qemu-agent-command "$VM" "$1" 2>&1) || true
    case "$reply" in
        *'"error"'*|error:*) echo "$reply" >&2; exit 1 ;;
    esac
    echo "$reply"
}

# flags -> DETACH, remainder -> REST; stops at the first non-flag so the command
# text is never parsed for flags
parse_flags() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --detach|-d) DETACH=1; shift ;;
            --)          shift; break ;;
            -)           break ;;
            -*)          echo "$0: unknown flag: $1 (use -- to end flags)" >&2; exit 1 ;;
            *)           break ;;
        esac
    done
    REST=("$@")
}

# command text -> TEXT, host stdin -> INPUT_B64; see the stdin note in the header
resolve_text() {
    [ $# -gt 0 ] || return 1
    if [ $# -eq 1 ] && [ "$1" = "-" ]; then
        TEXT=$(cat)
    else
        TEXT="$*"
        [ -t 0 ] || INPUT_B64=$(base64 -w0)
    fi
}

# powershell serialises its error stream as CLIXML whenever stderr is redirected.
# The ps wrapper writes errors straight to the console handle to avoid that, so
# this is only reached by errors raised outside the wrapper's reach -- a parse
# error, or a nested powershell.exe. Passes the raw text through when python3 is
# missing rather than making python3 a hard dependency of every run.
declixml() {
    command -v python3 >/dev/null 2>&1 || { cat; return; }
    python3 -c '
import re, sys, xml.etree.ElementTree as ET
d = sys.stdin.read()
if not d.startswith("#< CLIXML"):
    sys.stdout.write(d); sys.exit()
try:
    root = ET.fromstring(d.split("\n", 1)[1])
except ET.ParseError:
    sys.stdout.write(d); sys.exit()
t = "".join(e.text or "" for e in root.iter() if e.tag.rpartition("}")[2] == "S")
sys.stdout.write(re.sub(r"_x([0-9A-Fa-f]{4})_", lambda m: chr(int(m.group(1), 16)), t))
'
}

# gexec PATH ARGS_JSON -- wait for completion, print out/err, return guest exit
# code; honours DETACH and INPUT_B64
gexec() {
    local pid st out err errtext ec ms args
    args=$(jq -nc --arg p "$1" --argjson a "$2" \
        --argjson cap "$([ "$DETACH" = 1 ] && echo false || echo true)" \
        --arg i "$INPUT_B64" \
        '{execute:"guest-exec",arguments:
            ({path:$p,arg:$a,"capture-output":$cap}
             + (if $i == "" then {} else {"input-data":$i} end))}')
    pid=$(agent "$args" | jq -r '.return.pid')

    if [ "$DETACH" = 1 ]; then
        echo "$pid"
        return 0
    fi

    # backoff: a one-liner returns almost immediately, an installer runs for
    # minutes -- neither should be polled at the other's rate
    ms=50
    while :; do
        st=$(agent "$(jq -nc --argjson pid "$pid" \
            '{execute:"guest-exec-status",arguments:{pid:$pid}}')")
        [ "$(jq -r '.return.exited' <<<"$st")" = true ] && break
        sleep "$(printf '%d.%03d' $((ms / 1000)) $((ms % 1000)))"
        ms=$(( ms * 3 / 2 < 1000 ? ms * 3 / 2 : 1000 ))
    done

    # \r stripped so windows output pipes cleanly into unix tools
    out=$(jq -r '.return["out-data"] // empty' <<<"$st")
    err=$(jq -r '.return["err-data"] // empty' <<<"$st")
    if [ -n "$out" ]; then base64 -d <<<"$out" | tr -d '\r'; fi
    if [ -n "$err" ]; then
        errtext=$(base64 -d <<<"$err")
        case "$errtext" in
            '#< CLIXML'*) printf '%s\n' "$errtext" | declixml | tr -d '\r' >&2 ;;
            *)            printf '%s\n' "$errtext" | tr -d '\r' >&2 ;;
        esac
    fi

    ec=$(jq -r '.return.exitcode // 0' <<<"$st")
    return "$ec"
}

case "$CMD" in
setup)
    if $VIRSH dumpxml "$VM" | grep -q org.qemu.guest_agent.0; then
        echo "$VM: channel already present"
        exit 0
    fi
    XML=$(mktemp) && trap 'rm -f "$XML"' EXIT
    cat >"$XML" <<'EOF'
<channel type='unix'>
  <source mode='bind'/>
  <target type='virtio' name='org.qemu.guest_agent.0'/>
</channel>
EOF
    $VIRSH attach-device "$VM" "$XML" --config
    # hotplug only works on a running VM; the --config copy covers the rest
    if [ "$($VIRSH domstate "$VM")" = running ]; then
        $VIRSH attach-device "$VM" "$XML" --live
    fi
    echo "$VM: channel added (install qemu-ga in the guest if not already there)"
    ;;
ping)
    agent '{"execute":"guest-ping"}' >/dev/null
    echo "$VM: agent up"
    ;;
info)
    # pretty-name lies on windows (reports the win10 sku), so build from version fields
    agent '{"execute":"guest-get-osinfo"}' \
        | jq -r '.return | "os: \(.version // .["pretty-name"] // .name) build \(.["kernel-release"] // "?") (\(.machine))"'
    agent '{"execute":"guest-get-host-name"}' | jq -r '"host-name: " + .return["host-name"]'
    agent '{"execute":"guest-info"}' | jq -r '"qemu-ga: " + .return.version'
    ;;
cmd)
    parse_flags "$@"
    set -- ${REST[@]+"${REST[@]}"}
    resolve_text "$@" || { echo "usage: $0 cmd VM [-d] CMD..." >&2; exit 1; }

    # qemu-ga flattens the arg array into a Windows command line with glib's
    # rules, which backslash-escape embedded quotes -- and cmd.exe has never
    # understood \" as an escape, so the command arrives mangled with a zero
    # exit code. ps encodes to base64 and is immune, so send them there.
    case "$TEXT" in
        *'"'*) echo "$0: cmd cannot carry embedded quotes through cmd.exe; use ps" >&2
               exit 1 ;;
    esac
    # + the "cmd.exe /c " prefix and the quotes qemu-ga wraps the arg in
    if [ $(( ${#TEXT} + 16 )) -gt "$CMD_EXE_MAX" ]; then
        echo "$0: command is ${#TEXT} chars, over cmd.exe's $CMD_EXE_MAX limit;" \
             "shorten it, or stage a .cmd file in the guest and run that" >&2
        exit 1
    fi

    gexec cmd.exe "$(jq -nc --arg c "$TEXT" '["/c",$c]')"
    ;;
ps)
    parse_flags "$@"
    set -- ${REST[@]+"${REST[@]}"}
    resolve_text "$@" || { echo "usage: $0 ps VM [-d] SCRIPT..." >&2; exit 1; }

    # The preference kills "Preparing modules for first use" progress spam on
    # stderr. The catch writes to the console handle rather than powershell's
    # error stream, which is what would otherwise be serialised as CLIXML; the
    # explicit exit 1 restores the code powershell returns for an uncaught
    # terminating error, which catching would otherwise turn into a 0.
    SCRIPT=$(printf '%s\n%s\n%s\n' \
        '$ProgressPreference="SilentlyContinue"; try {' \
        "$TEXT" \
        '} catch { [Console]::Error.WriteLine(($_ | Out-String)); exit 1 }')

    # UTF-16LE base64 sidesteps every quoting layer between here and the guest
    ENC=$(printf '%s' "$SCRIPT" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
    # + the powershell.exe flags that precede it on the command line
    if [ $(( ${#ENC} + 128 )) -gt "$CMDLINE_MAX" ]; then
        echo "$0: script encodes to ${#ENC} chars, over Windows's $CMDLINE_MAX" \
             "command-line limit (~12000 chars of source); shorten it, or stage" \
             "a .ps1 in the guest and run that" >&2
        exit 1
    fi

    gexec powershell.exe "$(jq -nc --arg e "$ENC" \
        '["-NoProfile","-NonInteractive","-OutputFormat","Text","-EncodedCommand",$e]')"
    ;;
*)
    usage
    ;;
esac
