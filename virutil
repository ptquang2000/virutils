#!/usr/bin/env bash
# virutil -- drive libvirt/KVM guest operations from a Linux host (incl. WSL).
#
# A single driver around a set of sourced modules. Each module is a function
# library declaring one <name>_main entry point; the parser module handles the
# top-level dispatch. Usage:
#
#   virutil exec       run commands inside a Windows guest via the QEMU guest agent
#   virutil sync       fetch build output from the Windows host, push into a guest
#   virutil pull       copy files out of a running guest via a live disk snapshot
#   virutil push       copy a file or directory from the host into a guest on demand
#   virutil usb        USB passthrough end to end from the Windows host under WSL
#   virutil snapshot   external snapshots (disk + memory) for libvirt domains
#   virutil domain     create and delete domains, disk included
#   virutil misc       everyday domain operations: list, start, shutdown, domifaddr
#   virutil help       this message
#
# Only virutil is installed (symlinked into ~/.local/bin by the dotfiles setup),
# so the module directory is resolved from the script's own path -- through a
# symlink, not around it.
set -euo pipefail

# silences virsh's "setlocale: No such file or directory" on minimal/WSL hosts
export LC_ALL=C

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

for module in parser guest exec sync pull push usb snapshot domain misc; do
    source "$HERE/modules/$module"
done

parse_dispatch "$@"

case "$MODULE" in
    exec)     exec_main     "${REST[@]}" ;;
    sync)     sync_main     "${REST[@]}" ;;
    pull)     pull_main     "${REST[@]}" ;;
    push)     push_main     "${REST[@]}" ;;
    usb)      usb_main      "${REST[@]}" ;;
    snapshot) snapshot_main "${REST[@]}" ;;
    domain)   domain_main   "${REST[@]}" ;;
    misc)     misc_main     "${REST[@]}" ;;
esac
