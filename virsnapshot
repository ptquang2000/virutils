#!/bin/bash
# External snapshots (disk + memory) for libvirt VMs.
# Usage: ./virsnapshot COMMAND VM_NAME [SNAP_NAME]
#   create    VM [SNAP]   create an external snapshot (default name: snap-<timestamp>)
#   list      VM          list snapshots as a tree
#   revert    VM SNAP     revert to a snapshot and leave the VM running
#   delete    VM SNAP     delete a snapshot and its children

set -euo pipefail

usage() {
    echo "usage: $0 {create|list|revert|delete} VM_NAME [SNAP_NAME]" >&2
    exit 1
}

CMD="${1:-}"
[ -n "$CMD" ] || usage
VM="${2:-}"
[ -n "$VM" ] || usage

DIR=/var/lib/libvirt/images
VIRSH="virsh -c qemu:///system"

case "$CMD" in
create)
    SNAP="${3:-snap-$(date +%Y%m%d-%H%M%S)}"
    $VIRSH snapshot-create-as \
        --domain "$VM" \
        --name "$SNAP" \
        --memspec "$DIR/$VM.$SNAP.mem,snapshot=external" \
        --diskspec "vda,snapshot=external,file=$DIR/$VM.$SNAP.qcow2" \
        --atomic
    echo "created: $SNAP"
    ;;
list)
    $VIRSH snapshot-list --domain "$VM" --tree
    ;;
revert)
    SNAP="${3:?usage: $0 revert VM_NAME SNAP_NAME}"
    $VIRSH snapshot-revert --domain "$VM" --snapshotname "$SNAP" --running
    echo "reverted: $SNAP"
    ;;
delete)
    SNAP="${3:?usage: $0 delete VM_NAME SNAP_NAME}"
    $VIRSH snapshot-delete --domain "$VM" --snapshotname "$SNAP" --children
    echo "deleted: $SNAP"
    ;;
*)
    usage
    ;;
esac
